---
import Base from '../layouts/Base.astro';
import Wheel from '../components/Wheel.astro';
import Halftone from '../components/Halftone.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const n = projects.length;
const pad = (i: number) => String(i).padStart(2, '0');
---
<Base title="Chariot · Product, brand & web design">
  <section class="home" style={`--n:${n}`}>
    <div class="stage">
      <div class="wheel-col"><Wheel count={n} /></div>

      <div class="focus">
        {projects.map((p, i) => (
          <a
            class:list={['slide', { on: i === 0 }]}
            href={`/work/${p.id}`}
            data-index={i}
            data-slug={p.id}
            data-cursor={`${p.data.title}|${p.data.disciplines.slice(0, 2).join(', ')}`}
            data-tick
            tabindex={i === 0 ? 0 : -1}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            <div class="poster" data-poster>
              <Halftone src={p.data.poster} alt={p.data.title} tint={p.data.color} eager={i < 2} />
            </div>
            <div class="caption">
              <span class="label">{pad(i + 1)} / {pad(n)} · {p.data.kind}</span>
              <h2>{p.data.title}</h2>
              <p>{p.data.summary}</p>
              <span class="open">Open project <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>

      <div class="intro">
        <p class="tagline display">We craft products, brands &amp; websites with nuance and good taste.</p>
        <p class="hint label" aria-hidden="true">Scroll to turn the wheel</p>
      </div>
    </div>
    <div class="steps" aria-hidden="true">{projects.map(() => <div class="step"></div>)}</div>
  </section>

  <section class="list" aria-labelledby="all-work">
    <h2 id="all-work" class="label">All work</h2>
    <ol>
      {projects.map((p, i) => (
        <li>
          <a href={`/work/${p.id}`} data-cursor={`${p.data.title}|${p.data.kind}`} data-tick>
            <span class="label">{pad(i + 1)}</span>
            <span class="t">{p.data.title}</span>
            <span class="s">{p.data.summary}</span>
            <span class="label k">{p.data.disciplines[0]}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .home { position: relative; height: calc(var(--n) * 72vh + 100vh); }
  .stage {
    position: sticky; top: 0; height: 100vh; height: 100svh;
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center;
    padding: 88px var(--gutter) 64px; gap: 4vw;
  }
  .wheel-col { height: min(76vh, 46vw); }
  .steps { position: absolute; inset: 0; display: grid; grid-template-rows: repeat(var(--n), 72vh) 100vh; pointer-events: none; }
  .step { scroll-snap-align: start; }

  .focus { position: relative; height: min(74vh, 600px); }
  .slide {
    position: absolute; inset: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 20px;
    opacity: 0; pointer-events: none; transform: translateY(14px);
    transition: opacity 420ms var(--ease), transform 620ms var(--ease);
  }
  .slide.on { opacity: 1; pointer-events: auto; transform: none; }
  .poster { border-radius: 14px; overflow: hidden; background: var(--surface); min-height: 0; }
  .caption { display: grid; gap: 6px; max-width: 46ch; }
  .caption h2 { margin: 0; font: 600 clamp(30px, 3.4vw, 46px)/1.05 var(--serif); letter-spacing: -.04em; }
  .open { margin-top: 8px; font: 500 12px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); display: inline-flex; gap: 8px; }
  .slide:hover .open span { transform: translateX(4px); }
  .open span { transition: transform var(--fast) var(--ease); }
  .intro { position: absolute; left: var(--gutter); top: 84px; max-width: 30ch; display: grid; gap: 10px; }
  .tagline { margin: 0; font-size: clamp(20px, 1.8vw, 26px); color: var(--muted); }
  .caption p { margin: 0; color: var(--muted); }

  .list { padding: 18vh var(--gutter) 22vh; max-width: 1240px; margin: 0 auto; }
  .list h2 { margin: 0 0 18px; }
  .list ol { list-style: none; margin: 0; padding: 0; border-top: 1px dashed var(--line); }
  .list a {
    display: grid; grid-template-columns: 44px minmax(0, 14ch) minmax(0, 1fr) auto; gap: 20px; align-items: baseline;
    padding: 16px 0; border-bottom: 1px dashed var(--line);
    transition: padding var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .list a:hover { padding-left: 10px; }
  .list .t { font: 600 24px/1.1 var(--serif); letter-spacing: -.03em; }
  .list .s { color: var(--muted); font-size: 15px; }

  @media (max-width: 820px) {
    .stage { grid-template-columns: minmax(0, 1fr); grid-template-rows: 38vh minmax(0, 1fr); padding-top: 72px; gap: 8px; }
    .wheel-col { height: 100%; }
    .focus { height: 100%; }
    .intro { display: none; }
    .list a { grid-template-columns: 32px minmax(0, 1fr); }
    .list .s, .list .k { grid-column: 2; }
  }
</style>

<script>
  // Scroll position through the section decides the project in focus and the wheel's turn.
  function initHome() {
    const home = document.querySelector<HTMLElement>('.home');
    if (!home) return;
    const slides = [...home.querySelectorAll<HTMLAnchorElement>('.slide')];
    const n = slides.length;
    let current = 0;
    const update = () => {
      const r = home.getBoundingClientRect();
      const span = home.offsetHeight - innerHeight;
      const progress = Math.min(1, Math.max(0, -r.top / Math.max(1, span * (n - 1) / n)));
      const index = Math.round(progress * (n - 1));
      dispatchEvent(new CustomEvent('wheel:progress', { detail: { progress, index } }));
      if (index !== current) {
        slides[current].classList.remove('on');
        slides[current].setAttribute('aria-hidden', 'true');
        slides[current].tabIndex = -1;
        slides[index].classList.add('on');
        slides[index].removeAttribute('aria-hidden');
        slides[index].tabIndex = 0;
        current = index;
      }
    };
    // only the poster being opened carries the shared name, so it grows into the project page
    slides.forEach((s) => s.addEventListener('click', () => {
      s.querySelector<HTMLElement>('[data-poster]')!.style.viewTransitionName = 'sheet-poster';
    }));
    addEventListener('scroll', update, { passive: true });
    document.addEventListener('astro:before-swap', () => removeEventListener('scroll', update), { once: true });
    update();
  }
  document.addEventListener('astro:page-load', initHome);
</script>
