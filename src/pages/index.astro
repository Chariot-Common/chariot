---
// The homepage: a few lines, then the work straight away.
// 1. Who we are, in two lines, set large, and how we work in one more.
// 2. The work (WorkList), each project as what Chariot made. Then the ask.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WorkList from '../components/WorkList.astro';
---
<Base title="Chariot · Product, brand & web design" bare>
  <div class="home">
    <Nav />
    <header class="intro">
      <h1 class="line">We craft products, brands and websites with nuance and good taste.</h1>
      <p class="how">We start with the <em>question,</em> not the pixel. Every project gets <em>three directions, one honest call,</em> and hands on the reins from sketch to the last shipped screen.</p>
    </header>

    <section class="paper" id="work" aria-label="Work">
      <WorkList />

      <div class="ask">
        <h2>EVERY PROJECT STARTS<br />WITH A QUESTION.</h2>
        <a class="pill" href="mailto:hello@withchariot.com" data-tick>ASK!</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .home { --paper: #FFFFFF; --ink: #1E1710; --soft: #6E675D; --rubric: #E0661B; background: var(--paper); color: var(--ink); }
  :global(html:has(.home)), :global(body:has(.home)) { background: #FFFFFF; color-scheme: light; }
  .home :global(.nav) { --nav-ink: #1E1710; }

  /* a few lines, then the work */
  .intro { width: min(1440px, 100% - 2 * var(--gutter)); margin: 0 auto; padding: clamp(120px, 18vh, 190px) 0 clamp(20px, 5vh, 60px);
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 72px); align-items: end; }
  .line { margin: 0; font: 600 clamp(40px, 5.6vw, 96px)/.96 var(--serif); letter-spacing: -.03em; text-wrap: balance; }
  .how { margin: 0; max-width: 36ch; font: 400 clamp(18px, 1.7vw, 28px)/1.4 var(--sans); color: var(--soft); }
  .how em { font-style: normal; color: var(--rubric); }

  .paper { position: relative; background: var(--paper); color: var(--ink); padding: clamp(24px, 6vh, 70px) 0 16vh; }

  .ask { display: grid; justify-items: center; gap: 28px; margin-top: 22vh; text-align: center; padding-inline: var(--gutter); }
  .ask h2 { margin: 0; font: 400 clamp(30px, 4.6vw, 80px)/1 var(--serif); letter-spacing: -.015em; }
  .pill { padding: 12px 26px; border: 1.5px solid currentColor; border-radius: 999px; font: 500 14px/1 var(--sans); letter-spacing: .08em; }
  .pill:hover { background: var(--rubric); border-color: var(--rubric); color: var(--paper); }

  @media (max-width: 820px) {
    .intro { grid-template-columns: minmax(0, 1fr); align-items: start; padding-top: 110px; }
  }
</style>
