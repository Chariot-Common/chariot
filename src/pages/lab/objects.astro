---
// Lab: projects as objects, after dmcg. One thing per project, alone on paper, that sums it up;
// at rest it is printed in ink, pointing at it prints it into colour and it does what the
// project does. First three:
//   Alai: a slide that builds itself from blank, then re-themes
//   Stoa: the lion mark, which stamps down as red rays burst behind it
//   The Ken: a magazine spread that draws its grid, sets itself, and turns to a pull quote
// Not linked from the site yet.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';

// The Ken, set as a magazine spread after the Gretel / Crystal Bridges reference.
// Each page has a 6-column grid; every column is drawn as its two edges.
const pageGrid = Array.from({ length: 6 }, (_, i) => [8 + i * 14.4, 8 + i * 14.4 + 11.6]).flat();
const head = 'REAL-MONEY GAMES MADE MPL A UNICORN.'.split(' ');
const quote = ['NOW IT', 'NEEDS', 'MILLIONS', 'FOR A NEW', 'IDENTITY.'];
const body = "The real-money gaming sector is in flux, so MPL, with its 200 million users, is spending over $20 million on a made-in-India mobile game. Metro Manila's talent pool is shrinking because entrepreneurial pursuits in tourist destinations have stronger appeal. The CEO tells The Ken how he tripled the rollout of new products at the company, and why he asks his team not to play for a draw. ";
---
<Base title="Projects as objects · Lab · Chariot" bare>
  <div class="objects">
    <Nav />

    <p class="intro label">Selected work · point at anything</p>

    <section class="row">
      <a class="obj alai" href="/work/alai" data-cursor="fol. 01 · Alai|Product" data-obj>
        <div class="slide ink">
          <img src="/media/objects/alai-rest.jpg" alt="Alai, an AI presentation builder: a slide builds itself from a blank page" />
          <video muted playsinline preload="metadata" aria-hidden="true">
            <source src="/media/alai/work.webm" type="video/webm" />
            <source src="/media/alai/work.mp4" type="video/mp4" />
          </video>
        </div>
      </a>
    </section>

    <section class="row">
      <a class="obj stoa" href="/work/stoa" data-cursor="fol. 06 · Stoa|Brand" data-obj>
        <span class="rays" aria-hidden="true"></span>
        <span class="lion" role="img" aria-label="Stoa's lion mark"></span>
      </a>
    </section>

    <section class="row">
      <a class="obj ken" href="/work/the-ken" data-cursor="fol. 05 · The Ken|Publication" data-obj>
        <div class="spread" role="img" aria-label="The Ken set as a magazine spread: the grid draws, the story is set on it, the headline is set word by word, then the page turns to a pull quote">
          <div class="book">
          <div class="cam">
            <!-- spread 1, left: the lead picture, full bleed -->
            <div class="page lp first">
              <div class="grid">{pageGrid.map((x, i) => <i style={`left:${x}%;--i:${i}`}></i>)}</div>
              <img class="k pic" src="/media/objects/ken-hero.jpg" alt="" style="--t:2.00s" />
              <span class="k folio" style="--t:1.80s">4</span>
            </div>
            <!-- spread 2, right: sits under the turning page -->
            <div class="page rp two">
              <div class="grid g2">{pageGrid.map((x, i) => <i style={`left:${x}%;--i:${i}`}></i>)}</div>
              <p class="k2 cols" style="--t:7.30s">{body}{body}</p>
              <img class="k2 illus" src="/media/objects/ken-illus.jpg" alt="" style="--t:7.60s" />
              <span class="k2 folio r" style="--t:6.90s">7</span>
            </div>
            <!-- the turning page: spread 1 right on its front, spread 2 left on its back -->
            <div class="turn">
              <div class="page rp front">
                <div class="grid">{pageGrid.map((x, i) => <i style={`left:${x + 0}%;--i:${i + 12}`}></i>)}</div>
                <span class="k byline" style="--t:2.35s">BY GAURAV BAGUR · BUSINESS</span>
                <p class="k stand" style="--t:2.20s">The real-money gaming sector is in flux. MPL, with its 200 million users, is spending over $20 million on a made-in-India mobile game, and needs a new identity to go with it.</p>
                <h3 class="head">{head.map((w, i) => <span class="k w" style={`--t:${3.1 + i * 0.16}s`}>{w} </span>)}</h3>
                <span class="k folio r" style="--t:1.80s">5</span>
              </div>
              <div class="page lp back">
                <div class="grid g2">{pageGrid.map((x, i) => <i style={`left:${x}%;--i:${i}`}></i>)}</div>
                <img class="k2 logo" src="/media/objects/ken-logo.png" alt="" style="--t:7.00s" />
                <h3 class="quote">{quote.map((w, i) => <span class="k2 w" style={`--t:${7.4 + i * 0.18}s`}>{w}</span>)}</h3>
                <span class="k2 folio" style="--t:6.90s">6</span>
              </div>
            </div>
            <!-- closed, the edition is just its cover; it opens over the spine first -->
            <div class="cover">
              <div class="page rp cface"><img src="/media/objects/ken-cover.jpg" alt="" /></div>
              <div class="page lp cback"></div>
            </div>
          </div>
          </div>
        </div>
      </a>
    </section>

    <p class="outro">THAT'S THE CART. MORE ON THE <a href="/#work" data-tick>WORK PAGE →</a></p>
  </div>
</Base>

<style>
  .objects { --paper: #F5EFE6; --ink: #1E1710; --snap: cubic-bezier(.2, 1.3, .35, 1); background: var(--paper); color: var(--ink); min-height: 100svh; }
  .objects :global(.nav) { --nav-ink: #1E1710; }
  .intro { padding: 22vh var(--gutter) 0; text-align: center; opacity: .55; }
  .outro { margin: 0; padding: 10vh var(--gutter) 18vh; text-align: center; font: 400 clamp(18px, 1.6vw, 24px)/1.3 var(--serif); }
  .outro a { color: #E0661B; }

  /* one object per stretch of page, nudged left, right or centre so it never reads as a grid */
  /* one object per stretch of page, centred, alone */
  .row { min-height: 72svh; display: flex; align-items: center; justify-content: center; padding: 0 var(--gutter); }
  .obj { position: relative; display: block; }

  /* ---- ink to colour: at rest everything is an ink proof, hatched like an engraving ---- */
  .ink { position: relative; }
  .ink > img, .ink.half { filter: grayscale(1) sepia(.45) contrast(1.5) brightness(1.05); transition: filter .6s var(--ease); }
  .ink::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background: repeating-linear-gradient(45deg, rgb(30 23 16 / .16) 0 1px, transparent 1px 4px); mix-blend-mode: multiply; transition: opacity .6s var(--ease); }
  .obj:hover .ink > img, .obj:hover .ink.half, .obj.on .ink > img, .obj.on .ink.half { filter: none; }
  .obj:hover .ink::after, .obj.on .ink::after { opacity: 0; }

  /* ---- Alai: a slide on the page; pointing at it, it builds itself ---- */
  .slide { width: min(34vw, 520px); aspect-ratio: 1170 / 700; border-radius: 8px; overflow: hidden; background: #fff;
    box-shadow: 0 30px 60px -30px rgb(30 23 16 / .45); transition: transform .5s var(--snap); }
  .slide img, .slide video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .slide video { opacity: 0; transition: opacity .2s; }
  .alai.on .slide video.on { opacity: 1; }
  .alai:hover .slide { transform: translateY(-6px) rotate(-1deg); }

  /* ---- Stoa: the lion in ink; pointing at it, red rays burst and it stamps down in white ---- */
  .stoa { width: min(20vw, 300px); aspect-ratio: 1; display: grid; place-items: center; }
  .lion { position: relative; z-index: 1; width: 100%; height: 100%; background: var(--ink);
    -webkit-mask: url(/media/objects/stoa-lion.png) center / contain no-repeat luminance; mask: url(/media/objects/stoa-lion.png) center / contain no-repeat luminance;
    /* the mask is white lines on black, so it is read by brightness */
    -webkit-mask-source-type: luminance; mask-mode: luminance;
    transition: background-color .2s .15s; }
  .rays { position: absolute; inset: -55%; border-radius: 50%; transform: scale(0) rotate(-30deg); opacity: 0;
    background: repeating-conic-gradient(from 0deg, #C8102E 0 7.5deg, #B00D27 7.5deg 15deg);
    -webkit-mask: radial-gradient(circle, #000 52%, transparent 70%); mask: radial-gradient(circle, #000 52%, transparent 70%);
    transition: transform .55s var(--snap), opacity .2s; }
  .stoa:hover .rays, .stoa.on .rays { transform: scale(1) rotate(0deg); opacity: 1; animation: turn 24s linear .55s infinite; }
  .stoa:hover .lion, .stoa.on .lion { background-color: #fff; animation: stamp .42s .12s var(--snap) both; }
  @keyframes stamp { 0% { transform: scale(1.35); } 55% { transform: scale(.92, .88); } 100% { transform: scale(1); } }
  @keyframes turn { to { transform: scale(1) rotate(360deg); } }

  /* ---- The Ken: a magazine spread that sets itself, after the Gretel reference ----
     At rest: the edition, closed, showing its cover. Pointing at it:
       0.0s  the cover turns over the spine and the book slides to centre: one page becomes two
       1.2s  the column grid draws down both pages, edge by edge
       1.8s  folios; 2.0s the lead picture is placed; 2.2s the intro and byline are set
       2.9s  the view leans in on the right page and the headline is set word by word
       4.6s  it steps back; the grid goes; the finished spread holds
       5.6s  the right page turns
       6.6s  the next spread: grid, masthead, the pull quote word by word,
             then the body columns and an illustration
     Leaving closes it again. */
  .ken { width: min(58vw, 860px); }
  /* the spread is the camera frame: leaning in crops to it, like the reference */
  .spread { position: relative; aspect-ratio: 8 / 5; perspective: 2400px; overflow: hidden; border-radius: 2px; }
  /* closed, the book slides half a page left so the cover sits in the middle */
  .book { position: absolute; inset: 0; transform: translateX(-25%); transition: transform .45s cubic-bezier(.6, 0, .3, 1); }
  .page.first { opacity: 0; }
  .cover { position: absolute; left: 50%; top: 0; width: 50%; height: 100%; z-index: 4; transform-style: preserve-3d; transform-origin: 0 50%; }
  .cover .page { left: 0; width: 100%; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  /* the whole cover story fits on the page, headline and standfirst included, with paper round it */
  .cover img { width: 100%; height: 100%; object-fit: contain; padding: 6% 0; filter: grayscale(1) sepia(.35) contrast(1.3); }
  .cover .cback { transform: rotateY(180deg); }
  .cam { position: absolute; inset: 0; transform-origin: 78% 52%; }
  .page { position: absolute; top: 0; width: 50%; height: 100%; overflow: hidden; background: #fbfaf7; color: #111; }
  /* a fine edge round every page, and a soft gutter toward the spine (no filters: they'd flatten the page turns) */
  .page.lp { left: 0; box-shadow: inset -10px 0 14px -12px rgb(0 0 0 / .18), inset 0 0 0 1px rgb(30 23 16 / .1); }
  .page.rp { left: 50%; box-shadow: inset 10px 0 14px -12px rgb(0 0 0 / .18), inset 0 0 0 1px rgb(30 23 16 / .1); }

  .grid i { position: absolute; top: 0; bottom: 0; width: 1px; background: #b48ad6; opacity: 0; transform-origin: top; }
  .folio { position: absolute; bottom: 4%; left: 8%; font: 500 clamp(8px, .8vw, 11px)/1 var(--sans); }
  .folio.r { left: auto; right: 8%; }

  .pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) sepia(.35) contrast(1.3); transition: filter .5s; }
  .byline { position: absolute; left: 8%; top: 7%; font: 600 clamp(6px, .55vw, 8px)/1 var(--sans); letter-spacing: .08em; }
  .stand { position: absolute; left: 8%; top: 12%; width: 54.4%; margin: 0; font: 400 clamp(7px, .7vw, 10px)/1.35 var(--serif); }
  .head { position: absolute; left: 8%; right: 6%; top: 42%; margin: 0; font: 500 clamp(18px, 2.35vw, 34px)/.98 var(--serif); letter-spacing: -.02em; }
  .head .w { display: inline-block; white-space: pre; }

  /* spread 2 */
  .logo { position: absolute; left: 8%; top: 7%; width: 54.4%; }
  .quote { position: absolute; left: 8%; top: 26%; margin: 0; display: grid; font: 500 clamp(20px, 2.6vw, 38px)/.95 var(--serif); letter-spacing: -.02em; }
  .quote .w { display: block; }
  .cols { position: absolute; left: 8%; right: 8%; top: 8%; height: 52%; margin: 0; columns: 3; column-gap: 7%; overflow: hidden;
    font: 400 clamp(5px, .5vw, 7px)/1.4 var(--serif); color: #333; }
  .illus { position: absolute; left: 8%; bottom: 10%; width: 54.4%; }

  /* the turning page */
  .turn { position: absolute; left: 50%; top: 0; width: 50%; height: 100%; transform-style: preserve-3d; transform-origin: 0 50%; z-index: 2; }
  .turn .page { left: 0; width: 100%; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .turn .back { transform: rotateY(180deg); box-shadow: inset -10px 0 14px -12px rgb(0 0 0 / .18); }

  /* at rest the spread is finished and still; spread 2 and the grid are hidden */
  .k2, .rp.two .grid i { opacity: 0; }

  /* ---- opening: the cover turns over the spine as the book slides to centre ---- */
  .ken:hover .book, .ken.on .book { transform: none; transition: transform .9s cubic-bezier(.45, 0, .2, 1); }
  .ken:hover .cover, .ken.on .cover { animation: open .9s cubic-bezier(.45, 0, .2, 1) both; }
  .ken:hover .page.first, .ken.on .page.first { animation: pop .01s .45s both; }
  .ken:hover .cover img, .ken.on .cover img { filter: none; }
  @keyframes open { 0% { transform: rotateY(0); opacity: 1; } 99% { transform: rotateY(-180deg); opacity: 1; } 100% { transform: rotateY(-180deg); opacity: 0; } }

  /* ---- building ---- */
  .ken:hover .grid i, .ken.on .grid i { animation: draw .5s cubic-bezier(.3, 0, .2, 1) calc(1.2s + var(--i) * 18ms) both, gone .4s 4.6s forwards; }
  .ken:hover .g2 i, .ken.on .g2 i { animation: draw .5s cubic-bezier(.3, 0, .2, 1) calc(6.5s + var(--i) * 18ms) both, gone .4s 9.4s forwards; }
  .ken:hover .k, .ken.on .k { animation: pop .01s var(--t) both; }
  .ken:hover .k2, .ken.on .k2 { animation: pop .01s var(--t) both; }
  .ken:hover .pic, .ken.on .pic { animation: place .5s var(--snap) var(--t) both; filter: none; }
  .ken:hover .cam, .ken.on .cam { animation: lean 1.9s cubic-bezier(.5, 0, .2, 1) 2.75s both; }
  .ken:hover .turn, .ken.on .turn { animation: turn .9s cubic-bezier(.5, 0, .2, 1) 5.6s both; }

  @keyframes draw { from { opacity: .8; transform: scaleY(0); } to { opacity: .8; transform: scaleY(1); } }
  @keyframes gone { to { opacity: 0; } }
  /* things are set, not faded: they snap in, like the reference */
  @keyframes pop { from { opacity: 0; } to { opacity: 1; } }
  @keyframes place { from { opacity: 0; transform: translateX(-10%); } 30% { opacity: 1; } to { opacity: 1; transform: none; } }
  @keyframes lean { 0% { transform: scale(1); } 22%, 72% { transform: scale(1.9); } 100% { transform: scale(1); } }
  @keyframes turn { from { transform: rotateY(0); } to { transform: rotateY(-180deg); } }

  @media (max-width: 820px) {
    .row { min-height: 60svh; }
    .slide { width: 84vw; }
    .stoa { width: 52vw; }
    .ken { width: 88vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rays, .lion, .book, .cover, .cam, .turn, .k, .k2, .pic, .grid i, .slide { transition: none !important; animation: none !important; }
  }
</style>

<script>
  // Pointing at an object (or, on touch screens, scrolling it to the middle) sets .on;
  // Alai's slide plays its build from the start each time.
  const canHover = matchMedia('(hover: hover)').matches;

  function wire(obj: HTMLElement) {
    const video = obj.querySelector('video');
    const on = () => {
      obj.classList.add('on');
      if (video) { video.currentTime = 0; video.play().then(() => video.classList.add('on')).catch(() => {}); }
    };
    const off = () => { obj.classList.remove('on'); if (video) { video.pause(); video.classList.remove('on'); } };
    if (canHover) {
      obj.addEventListener('pointerenter', on);
      obj.addEventListener('pointerleave', off);
      obj.addEventListener('focus', on);
      obj.addEventListener('blur', off);
    } else {
      new IntersectionObserver(([en]) => (en.isIntersecting ? on() : off()), { rootMargin: '-35% 0px -35% 0px' }).observe(obj);
    }
  }

  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('[data-obj]').forEach(wire));
</script>
