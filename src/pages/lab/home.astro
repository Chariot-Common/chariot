---
// Lab: the homepage as "one wheel, two lights". Night shows, paper thinks.
// 1. Night: the engraved wheel alone under one spotlight, under the top bar (Nav).
// 2. Scrolling, the wheel shrinks and rolls down its own long shadow; how we work is
//    printed inside the shadow, and each line parts to let the wheel through.
// 3. A deadpan line in dot matrix, then the light switches on: a hard cut to paper.
// 4. Paper: the work, as real screens on real devices (WorkList). Then the ask.
// Not linked from the site yet.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import WorkList from '../../components/WorkList.astro';

// one line per row, "|" marks where the line parts for the wheel; [brackets] are the process
const lines = [
  'WE START WITH | THE [QUESTION,]',
  'NOT THE | PIXEL. EVERY',
  'PROJECT GETS | [THREE]',
  '[DIRECTIONS,] | [ONE HONEST]',
  '[CALL,] AND | HANDS ON',
  'THE REINS FROM | SKETCH',
  'TO THE LAST | SHIPPED SCREEN.',
];
const html = (s: string) => s.trim().replace(/\[([^\]]+)\]/g, '<em>$1</em>');
const plain = lines.map((l) => l.replace(/[|[\]]/g, '').replace(/\s+/g, ' ').trim()).join(' ');

---
<Base title="Home, two lights · Lab · Chariot" bare>
  <div class="home">
    <Nav />
    <section class="night">
      <div class="track">
        <div class="spot" aria-hidden="true"></div>
        <div class="shadow" aria-hidden="true"></div>
        <canvas class="disc" aria-hidden="true"></canvas>
        <div class="hero" aria-hidden="true"></div>
        <div class="para" aria-label={plain}>
          {lines.map((l) => {
            const [a, b] = l.split('|');
            return <div class="ln" aria-hidden="true"><span class="a" set:html={html(a)} /><span class="b" set:html={html(b)} /></div>;
          })}
        </div>
        <span class="slot" aria-hidden="true"></span>
        <p class="dm" data-dm={'HOLD ON...\nTHIS SHADOW IS LONGER\nTHAN OUR PROCESS.\n(IT ISN\'T.)'}>Hold on… this shadow is longer than our process. (It isn't.)</p>
      </div>
    </section>

    <section class="paper" id="work">
      <span class="switch" aria-hidden="true"></span>
      <WorkList />

      <div class="ask">
        <h2>EVERY PROJECT STARTS<br />WITH A QUESTION.</h2>
        <a class="pill" href="mailto:hello@withchariot.com" data-tick>ASK!</a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ---- night: one object, one light ---- */
  .home { --night: #0E0D0A; --paper: #F5EFE6; --ink: #1E1710; --rubric: #E0661B; }
  .night { position: relative; background: var(--night); color: var(--paper); overflow: hidden; }
  .track { position: relative; }
  .hero { height: 100svh; }
  /* the bar's ink follows the light */
  .home.lit :global(.nav) { --nav-ink: #1E1710; }
  /* the spotlight: a soft cone from above, pooling on the floor under the wheel */
  .spot { position: absolute; left: 0; right: 0; top: -20vh; height: 130svh; pointer-events: none;
    background: radial-gradient(ellipse 34vh 60vh at 50% 0%, rgb(255 244 225 / .16), transparent 70%),
                radial-gradient(ellipse 60vw 26vh at 50% 82%, rgb(255 244 225 / .2), transparent 70%); }
  /* the long shadow: ink black, running from the wheel down through the words */
  .shadow { position: absolute; left: 50%; width: 92vw; transform: translateX(-50%); pointer-events: none;
    background: linear-gradient(#000, #000 85%, transparent);
    clip-path: polygon(41% 0, 59% 0, 100% 100%, 0 100%); filter: blur(10px); }
  .disc { position: absolute; left: 50%; top: 0; z-index: 2; pointer-events: none; }

  .para { position: relative; z-index: 1; padding-top: 10vh; font: 400 clamp(24px, 4.1vw, 74px)/1 var(--serif); letter-spacing: -.015em; }
  .ln { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: .28em; white-space: nowrap; }
  .ln .a, .ln .b { display: block; will-change: transform; }
  .ln .a { justify-self: end; }
  .ln .b { justify-self: start; }
  .ln :global(em) { font-style: normal; transition: color .5s var(--ease); }
  .ln.past :global(em) { color: var(--rubric); }
  .slot { display: block; }
  /* the deadpan line, in dot matrix; the real text stays for screen readers */
  .dm { position: relative; z-index: 1; margin: 4vh auto 0; padding-bottom: 26vh; text-align: center; font-size: 0; color: transparent; }
  .dm :global(canvas) { display: inline-block; }

  /* ---- paper: the light comes on ---- */
  /* until the switch line reaches the middle of the screen the room is still dark; then it cuts to paper, no fade */
  .paper { position: relative; background: var(--night); color: var(--night); padding: 14vh var(--gutter) 16vh; }
  .home.lit .paper { background: var(--paper); color: var(--ink); }
  .switch { position: absolute; top: 0; left: 0; height: 1px; width: 1px; }

  .ask { display: grid; justify-items: center; gap: 28px; margin-top: 26vh; text-align: center; }
  .ask h2 { margin: 0; font: 400 clamp(30px, 4.6vw, 80px)/1 var(--serif); letter-spacing: -.015em; }
  .pill { padding: 12px 26px; border: 1.5px solid currentColor; border-radius: 999px; font: 500 14px/1 var(--sans); letter-spacing: .08em; }
  .pill:hover { background: var(--rubric); border-color: var(--rubric); color: var(--paper); }

</style>

<script>
  import * as THREE from 'three';
  const VERT = /* glsl */ `
    varying vec2 vUv;
    void main() { vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }
  `;
  // printed like a lit engraving: paper-coloured lines that swell where the light hits the wood,
  // a cross-hatch in the brightest highlights, and a cut line around every edge
  const FRAG = /* glsl */ `
    uniform sampler2D tScene;
    uniform vec2 uRes;
    uniform float uCell;
    uniform vec3 uInk;
    float hatch(vec2 p, float ang, float w) {
      float c = cos(ang), s = sin(ang);
      float v = (p.x * c + p.y * s) / uCell;
      float d = abs(fract(v) - 0.5) * uCell;
      return 1.0 - smoothstep(w - 0.6, w + 0.6, d);
    }
    void main() {
      vec2 frag = gl_FragCoord.xy;
      vec4 s = texture2D(tScene, frag / uRes);
      float lum = dot(s.rgb, vec3(0.299, 0.587, 0.114));
      float lit = s.a * clamp(lum * 1.7, 0.0, 1.0);
      float a = hatch(frag, 0.78, lit * uCell * 0.42) * step(0.04, lit);
      a = max(a, hatch(frag, -0.78, (lit - 0.6) * uCell * 0.5) * step(0.6, lit));
      vec2 px = 1.5 / uRes;
      float e = abs(texture2D(tScene, frag / uRes + vec2(px.x, 0.0)).a - texture2D(tScene, frag / uRes - vec2(px.x, 0.0)).a)
              + abs(texture2D(tScene, frag / uRes + vec2(0.0, px.y)).a - texture2D(tScene, frag / uRes - vec2(0.0, px.y)).a);
      a = max(a, clamp(e * 1.4, 0.0, 1.0));
      gl_FragColor = vec4(uInk * a, a);
      #include <colorspace_fragment>
    }
  `;

  // ---- dot matrix: render the text tiny, then reprint every lit pixel as a round dot ----
  function dotMatrix(el: HTMLElement) {
    const rows = (el.dataset.dm || '').split('\n');
    const src = document.createElement('canvas').getContext('2d', { willReadFrequently: true })!;
    const fh = 8, lh = 10;
    src.font = `bold ${fh}px monospace`;
    const w = Math.ceil(Math.max(...rows.map((r) => src.measureText(r).width))) + 2;
    src.canvas.width = w; src.canvas.height = rows.length * lh + 2;
    src.font = `bold ${fh}px monospace`;
    src.textBaseline = 'top';
    src.fillStyle = '#fff';
    rows.forEach((r, i) => src.fillText(r, (w - src.measureText(r).width) / 2, i * lh + 1));
    const px = src.getImageData(0, 0, src.canvas.width, src.canvas.height).data;
    const dot = Math.max(3, Math.round(innerWidth / 360));
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const out = document.createElement('canvas');
    out.width = src.canvas.width * dot * dpr; out.height = src.canvas.height * dot * dpr;
    out.style.width = `${src.canvas.width * dot}px`; out.style.height = `${src.canvas.height * dot}px`;
    const o = out.getContext('2d')!;
    o.fillStyle = '#F5EFE6';
    for (let y = 0; y < src.canvas.height; y++) for (let x = 0; x < src.canvas.width; x++) {
      if (px[(y * src.canvas.width + x) * 4 + 3] > 110) {
        o.beginPath(); o.arc((x + .5) * dot * dpr, (y + .5) * dot * dpr, dot * dpr * .42, 0, Math.PI * 2); o.fill();
      }
    }
    out.setAttribute('aria-hidden', 'true');
    el.append(out);
  }

  type Cleanup = () => void;
  let cleanup: Cleanup | null = null;

  function init(home: HTMLElement): Cleanup {
    const section = home.querySelector<HTMLElement>('.night')!;
    const disc = section.querySelector<HTMLCanvasElement>('.disc')!;
    const slot = section.querySelector<HTMLElement>('.slot')!;
    const hero = section.querySelector<HTMLElement>('.hero')!;
    const shadow = section.querySelector<HTMLElement>('.shadow')!;
    const track = section.querySelector<HTMLElement>('.track')!;
    const rows = [...section.querySelectorAll<HTMLElement>('.ln')].map((el) => ({
      el, a: el.querySelector<HTMLElement>('.a')!, b: el.querySelector<HTMLElement>('.b')!,
    }));
    const para = section.querySelector<HTMLElement>('.para')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    section.querySelectorAll<HTMLElement>('.dm').forEach(dotMatrix);

    // ---- the wheel ----
    const renderer = new THREE.WebGLRenderer({ canvas: disc, antialias: false, alpha: true, premultipliedAlpha: true });
    const dpr = Math.min(devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(28, 1, 0.1, 50);
    camera.position.set(0, 0, 5.4);
    const wheel = new THREE.Group();
    const tilt = new THREE.Group();
    tilt.rotation.x = -0.12;
    tilt.add(wheel);
    scene.add(tilt);
    // built to the drawings in public/media/wheel: six turned spokes with collars at both ends,
    // a thick wooden rim with a thin tyre, a bronze plate clamped over the rim at every spoke,
    // a stepped turned hub with a linchpin and ring in front and the axle stub behind.
    // Flat-shaded so the engraving picks out every facet.
    const wood = new THREE.MeshStandardMaterial({ color: 0xb59772, metalness: 0, roughness: 0.85, flatShading: true });
    const brass = new THREE.MeshStandardMaterial({ color: 0xd9c49a, metalness: 0.35, roughness: 0.45, flatShading: true });
    const annulus = (outer: number, inner: number, depth: number, m: THREE.Material) => {
      const shape = new THREE.Shape().absarc(0, 0, outer, 0, Math.PI * 2, false);
      shape.holes.push(new THREE.Path().absarc(0, 0, inner, 0, Math.PI * 2, true));
      const g = new THREE.ExtrudeGeometry(shape, { depth, bevelEnabled: true, bevelSize: 0.008, bevelThickness: 0.008, bevelSegments: 1, curveSegments: 96 });
      g.translate(0, 0, -depth / 2);
      wheel.add(new THREE.Mesh(g, m));
    };
    annulus(1.0, 0.82, 0.16, wood);   // the rim, six felloes
    annulus(1.05, 0.995, 0.12, brass); // the tyre
    // rivets round the tyre, as in the edge-on drawing
    const rivet = new THREE.SphereGeometry(0.018, 6, 4);
    for (let i = 0; i < 18; i++) {
      const a = (i / 18) * Math.PI * 2;
      const n = new THREE.Mesh(rivet, brass);
      n.position.set(Math.cos(a) * 1.052, Math.sin(a) * 1.052, 0);
      wheel.add(n);
    }
    // a spoke turned on a lathe: collar, swell, slim waist, swell, collar
    const spokeGeo = new THREE.LatheGeometry([
      [0.0, 0.2], [0.075, 0.2], [0.075, 0.25], [0.06, 0.27], [0.065, 0.3], [0.05, 0.33],
      [0.034, 0.48], [0.04, 0.62], [0.055, 0.7], [0.065, 0.72], [0.075, 0.74], [0.075, 0.8], [0.0, 0.83],
    ].map(([r, h]) => new THREE.Vector2(r, h)), 10);
    const plateGeo = new THREE.BoxGeometry(0.17, 0.22, 0.2);
    for (let i = 0; i < 6; i++) {
      const a = Math.PI / 2 + (i / 6) * Math.PI * 2;
      const s = new THREE.Mesh(spokeGeo, wood);
      s.rotation.z = a - Math.PI / 2;
      wheel.add(s);
      // the bronze plate where the spoke meets the rim, two rivets on its face
      const plate = new THREE.Mesh(plateGeo, brass);
      plate.position.set(Math.cos(a) * 0.91, Math.sin(a) * 0.91, 0);
      plate.rotation.z = a - Math.PI / 2;
      wheel.add(plate);
      for (const o of [-0.05, 0.05]) {
        const n = new THREE.Mesh(rivet, brass);
        n.position.set(Math.cos(a) * (0.91 + o), Math.sin(a) * (0.91 + o), 0.105);
        wheel.add(n);
      }
    }
    // the hub: a stepped turned bulb, deeper behind than in front
    const hub = new THREE.Mesh(new THREE.LatheGeometry([
      [0.06, -0.34], [0.12, -0.32], [0.17, -0.27], [0.2, -0.2], [0.225, -0.1], [0.23, 0],
      [0.22, 0.07], [0.2, 0.1], [0.2, 0.12], [0.17, 0.15], [0.17, 0.17], [0.13, 0.2], [0.13, 0.22], [0.08, 0.25], [0.0, 0.26],
    ].map(([r, h]) => new THREE.Vector2(r, h)), 24), wood);
    hub.rotation.x = Math.PI / 2;
    wheel.add(hub);
    const knob = new THREE.Mesh(new THREE.SphereGeometry(0.055, 16, 10), brass);
    knob.position.z = 0.28;
    wheel.add(knob);
    const ringPin = new THREE.Mesh(new THREE.TorusGeometry(0.035, 0.009, 6, 20), brass);
    ringPin.scale.y = 1.9;
    ringPin.position.set(0, -0.08, 0.3);
    wheel.add(ringPin);
    const axle = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.22, 16), wood);
    axle.rotation.x = Math.PI / 2;
    axle.position.z = -0.42;
    wheel.add(axle);
    scene.add(new THREE.HemisphereLight(0xfff4e6, 0x1a140c, 0.9));
    const key = new THREE.DirectionalLight(0xffffff, 3.2); key.position.set(-2.5, 3, 3); scene.add(key);
    const rim = new THREE.DirectionalLight(0xffe2c0, 0.5); rim.position.set(3, -1.5, 2); scene.add(rim);

    const rt = new THREE.WebGLRenderTarget(1, 1, { type: THREE.HalfFloatType, samples: 4 });
    const uniforms = {
      tScene: { value: rt.texture },
      uRes: { value: new THREE.Vector2(1, 1) },
      uCell: { value: 3.2 * dpr },
      uInk: { value: new THREE.Color(getComputedStyle(section).color) },
    };
    const quad = new THREE.Scene();
    const quadCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    quad.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), new THREE.ShaderMaterial({ uniforms, vertexShader: VERT, fragmentShader: FRAG, transparent: true })));

    // ---- sizing ----
    // In the spotlight the wheel is big; by the time it reaches the words it has shrunk to
    // about a line and a half. The canvas is sized for the big wheel and the model scales.
    let R = 0, Rhero = 0, S = 0;
    function measure() {
      R = rows[0].el.getBoundingClientRect().height * 0.9;
      Rhero = Math.min(innerHeight * 0.26, innerWidth * 0.3);
      S = Math.ceil((2 * Rhero) / 0.78);
      disc.style.width = disc.style.height = `${S}px`;
      renderer.setSize(S, S, false);
      rt.setSize(S * dpr, S * dpr);
      uniforms.uRes.value.set(S * dpr, S * dpr);
      slot.style.height = `${2.6 * R}px`;
      // the shadow starts under the wheel in the spotlight and runs to the end of the words
      const top = hero.offsetTop + hero.offsetHeight * 0.5 + Rhero * 0.8;
      shadow.style.top = `${top}px`;
      shadow.style.height = `${slot.offsetTop + slot.offsetHeight - top}px`;
    }

    // ---- motion ----
    // The wheel starts in the spotlight and aims for the middle of the screen, trailing it a
    // little, so the words rise past it and it rolls down through them, parting each line;
    // it comes to rest in its slot above the dot-matrix line.
    let theta = 0.5, y = -1, raf = 0;
    function frame() {
      raf = requestAnimationFrame(frame);
      flip();
      const tr = track.getBoundingClientRect(), sr = slot.getBoundingClientRect();
      const heroY = hero.offsetTop + hero.offsetHeight * 0.5;
      const from = rows[0].el.offsetTop + para.offsetTop - R * 1.1;
      const land = sr.top + sr.height / 2 - tr.top;
      const want = innerHeight * 0.5 - tr.top;
      const aimY = Math.min(land, Math.max(heroY, want));
      y = y < 0 || reduce ? aimY : y + (aimY - y) * 0.1;
      const landed = aimY >= land - 1;
      // big in the light, line-sized among the words
      const k0 = Math.min(1, Math.max(0, (y - heroY) / Math.max(1, from - heroY)));
      const k = k0 * k0 * (3 - 2 * k0);
      tilt.scale.setScalar((Rhero + (R - Rhero) * k) / Rhero);
      disc.style.transform = `translate(-50%, ${y - S / 2}px)`;
      const reach = R * 2.1;
      for (const r of rows) {
        const cy = r.el.offsetTop + para.offsetTop + r.el.offsetHeight / 2;
        const t = Math.max(0, 1 - Math.abs(cy - y) / reach);
        const x = t * t * (3 - 2 * t) * R * 1.25;
        r.a.style.transform = `translateX(${-x}px)`;
        r.b.style.transform = `translateX(${x}px)`;
        r.el.classList.toggle('past', cy < y);
      }
      // it turns slowly under the light, rolls as it travels, and settles face-on when it lands
      const roll = (y - heroY) / (R * 1.6) + performance.now() / 6000 * (1 - k);
      const aimTheta = reduce ? 0.5 : landed ? Math.round(roll / Math.PI) * Math.PI : roll;
      theta += (aimTheta - theta) * 0.16;
      tilt.rotation.y = theta;
      wheel.rotation.z = theta * 0.35;
      renderer.setRenderTarget(rt);
      renderer.setClearColor(0x000000, 0);
      renderer.clear();
      renderer.render(scene, camera);
      renderer.setRenderTarget(null);
      renderer.clear();
      renderer.render(quad, quadCam);
    }

    // ---- the light switch: a hard cut to paper with a small click ----
    const sw = home.querySelector<HTMLElement>('.switch')!;
    let audio: AudioContext | null = null;
    const click = () => {
      try {
        audio ??= new AudioContext();
        const o = audio.createOscillator(), g = audio.createGain();
        o.frequency.value = 1800; g.gain.setValueAtTime(0.08, audio.currentTime);
        g.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + 0.04);
        o.connect(g).connect(audio.destination); o.start(); o.stop(audio.currentTime + 0.05);
      } catch {}
    };
    // the light is on once the top of the paper passes the middle of the screen
    const flip = () => {
      const on = sw.getBoundingClientRect().top < innerHeight * 0.55;
      if (on !== home.classList.contains('lit')) { home.classList.toggle('lit', on); if (on) click(); }
    };

    document.fonts.ready.then(measure);
    measure();
    addEventListener('resize', measure);
    frame();

    return () => {
      cancelAnimationFrame(raf);
      removeEventListener('resize', measure);
      rt.dispose();
      renderer.dispose();
    };
  }

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = null;
    const h = document.querySelector<HTMLElement>('.home');
    if (h) cleanup = init(h);
  });
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = null; });
</script>
