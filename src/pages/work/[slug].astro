---
// The case page, one template for every project, after dmcg's Groth page:
//   a huge wordmark and the project's line, then the object from the homepage (what Chariot made)
//   opening calmly in a big panel; then a narrow, readable column of text (18px) that alternates
//   with big media: clips and screens in rounded panels, full width, in pairs, or as rows of phones.
//   Impact, numbers, the client's words, the team and links close it, then the next project.
// All copy comes from the project's content file, which takes it from Chariot's own case study on
// withchariot.com. Projects without a case study show their summary and screens, and say so.
import Base from '../../layouts/Base.astro';
import Dock from '../../components/Dock.astro';
import Thinking from '../../components/Thinking.astro';
import SkywaySite from '../../components/SkywaySite.astro';
import KenSystem from '../../components/KenSystem.astro';
import StoaBrand from '../../components/StoaBrand.astro';
import AlaiProduct from '../../components/AlaiProduct.astro';
import PaperPlanes from '../../components/PaperPlanes.astro';
import HealthFlexSite from '../../components/HealthFlexSite.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length] },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const slug = project.id;
const kinds = { product: 'Product', web: 'Website', publication: 'Publication', brand: 'Brand' } as const;
const hasStory = d.story.length > 0 || d.overview.length > 0;

type M = { src: string; alt: string; shape: 'wide' | 'phone' | 'square' };
const isClip = (src: string) => /\.(mp4|webm)$/i.test(src);
// framer serves big originals; ask for a size that fits the panel
const sized = (src: string, w: number) => (src.includes('framerusercontent.com/images/') ? `${src}?scale-down-to=${w}` : src);
// consecutive media of the same shape travel together: wides one by one (two side by side when a
// pair), squares and phones in rows
function rows(list: M[]) {
  const out: { shape: M['shape']; items: M[] }[] = [];
  for (const m of list) {
    const last = out[out.length - 1];
    // a wide clip always gets the panel to itself; wide stills may pair up
    const solo = m.shape === 'wide' && (isClip(m.src) || (last && isClip(last.items[0].src)));
    if (last && !solo && last.shape === m.shape && (m.shape !== 'wide' || last.items.length < 2)) last.items.push(m);
    else out.push({ shape: m.shape, items: [m] });
  }
  return out;
}
// projects with no case study: their poster, screens and pieces, in that order
// (the poster already fills the hero when there is no object, so it only joins the gallery when there is)
const gallery: M[] = hasStory ? [] : [
  ...d.screens,
  ...(slug in { skyway: 1, 'the-ken': 1, stoa: 1, alai: 1, 'paper-planes': 1, healthflex: 1 } ? [{ src: d.poster, alt: `${d.title}`, shape: 'wide' as const }] : []),
  ...d.pieces.map((p) => ({ src: p.src, alt: p.label, shape: 'wide' as const })),
];
// the object from the homepage, if the project has one
const objects: Record<string, string> = { skyway: 'site3d', 'the-ken': 'ken3d', stoa: 'stoa-brand', alai: 'alai3d', 'paper-planes': 'pp3d', healthflex: 'hf3d' };
const hasObject = slug in objects;
const vtName = slug === 'skyway' ? 'sky-site' : 'sheet-poster';
---
<Base title={`${d.title} · Chariot`} description={d.summary} dock theme="paper">
  <Dock slot="dock" current={slug} />

  <article class="case" style={`--c:${d.color}`}>
    <header class="mast">
      <p class="kick">{kinds[d.kind]}{d.year ? ` · ${d.year}` : ''} · {d.disciplines.join(', ')}</p>
      <h1 class="word">{d.title}</h1>
      <p class="line">{d.tagline ?? d.summary}</p>
    </header>

    <figure class:list={['panel', 'hero', { object: hasObject }]} style={`view-transition-name: ${vtName}`} data-open>
      {slug === 'skyway' && <SkywaySite size={230} />}
      {slug === 'the-ken' && <KenSystem size={560} />}
      {slug === 'stoa' && <StoaBrand size={270} />}
      {slug === 'alai' && <AlaiProduct size={600} />}
      {slug === 'paper-planes' && <PaperPlanes size={520} />}
      {slug === 'healthflex' && <HealthFlexSite size={480} />}
      {!hasObject && <img src={sized(d.poster, 2400)} alt={`${d.title}: ${d.summary}`} decoding="async" />}
    </figure>

    <section class="col intro">
      {d.overview.length > 0
        ? <><h2 class="small-h">Overview</h2>{d.overview.map((p) => <p>{p}</p>)}</>
        : null}
      {d.services.length > 0 && (
        <>
          <h2 class="small-h">What we did</h2>
          <ul class="did">{d.services.map((s) => <li>{s}</li>)}</ul>
        </>
      )}
      <dl class="facts">
        <div><dt>Work</dt><dd>{d.disciplines.join(', ')}</dd></div>
        {d.year && <div><dt>Year</dt><dd>{d.year}</dd></div>}
        {d.live && <div><dt>Live</dt><dd><a href={d.live} target="_blank" rel="noopener" data-tick>{d.live.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗</a></dd></div>}
      </dl>
      {!hasStory && <p class="tocome">Write-up to come.</p>}
    </section>

    {d.lead.map((m) => (
      <figure class="panel full">
        {isClip(m.src)
          ? <video src={`${m.src}#t=0.5`} muted loop playsinline preload="metadata" data-play aria-label={m.alt}></video>
          : <img src={sized(m.src, 2400)} alt={m.alt} loading="lazy" decoding="async" />}
      </figure>
    ))}

    {d.impact.length > 0 && (
      <section class="impact" aria-label="Impact">
        <h2 class="small-h">Impact</h2>
        <ul>{d.impact.map((x) => <li><b>{x.head}</b><span>{x.body}</span></li>)}</ul>
      </section>
    )}

    {d.story.map((s) => (
      <>
        {(s.heading || s.text.length > 0) && (
          <section class="col">
            {s.kicker && <p class="small-h">{s.kicker}</p>}
            {s.heading && <h2 class="sec-h">{s.heading}</h2>}
            {s.text.map((p) => <p>{p}</p>)}
            {s.notes.length > 0 && <dl class="notes">{s.notes.map((n) => <div><dt>{n.head}</dt><dd>{n.body}</dd></div>)}</dl>}
          </section>
        )}
        {rows(s.media).map((r) => (
          <div class:list={['panel', 'media', `is-${r.shape}`, `n${r.items.length}`]}>
            {r.items.map((m) => (
              <figure>
                {isClip(m.src)
                  ? <video src={`${m.src}#t=0.5`} muted loop playsinline preload="metadata" data-play aria-label={m.alt}></video>
                  : <img src={sized(m.src, r.shape === 'wide' && r.items.length === 1 ? 2400 : 1400)} alt={m.alt} loading="lazy" decoding="async" />}
              </figure>
            ))}
          </div>
        ))}
      </>
    ))}

    {rows(gallery).map((r) => (
      <div class:list={['panel', 'media', `is-${r.shape}`, `n${r.items.length}`]}>
        {r.items.map((m) => <figure><img src={sized(m.src, 2400)} alt={m.alt} loading="lazy" decoding="async" /></figure>)}
      </div>
    ))}

    {d.thinking && <Thinking title={d.title} color={d.color} thinking={d.thinking} />}

    {d.stats.length > 0 && (
      <section class="stats" aria-label="In numbers">
        {d.stats.map((x) => <div><b>{x.value}</b><span>{x.label}</span></div>)}
      </section>
    )}

    {d.quote && (
      <figure class="quote">
        {d.quote.title && <p class="q-title">“{d.quote.title}”</p>}
        <blockquote>{d.quote.text.map((p) => <p>{p}</p>)}</blockquote>
        <figcaption><b>{d.quote.by}</b><span>{d.quote.role}</span></figcaption>
      </figure>
    )}

    {(d.team.length > 0 || d.links.length > 0) && (
      <section class="credits">
        {d.team.length > 0 && (
          <div><h2 class="small-h">Team</h2><ul>{d.team.map((t) => <li><b>{t.name}</b><span>{t.role}</span></li>)}</ul></div>
        )}
        {d.links.length > 0 && (
          <div><h2 class="small-h">Links</h2><ul>{d.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener" data-tick>{l.label} ↗</a></li>)}</ul></div>
        )}
      </section>
    )}

    <nav class="pager" aria-label="More projects">
      <a href={`/work/${prev.id}`} data-prev data-tick><span class="small-h">Previous</span><span class="t">{prev.data.title}</span></a>
      <a href={`/work/${next.id}`} data-next data-tick><span class="small-h">Next</span><span class="t">{next.data.title}</span></a>
    </nav>
  </article>
</Base>

<style>
  .case { --tint: color-mix(in srgb, var(--c) 7%, #F3F1EC); --ink: #1B1814; --soft: #6B655C;
    padding: 96px clamp(12px, 2vw, 24px) 0; display: grid; gap: clamp(28px, 5vw, 64px); color: var(--ink); }

  /* the wordmark fills the width, like a masthead */
  .mast { display: grid; gap: 14px; padding: 16px clamp(4px, 1vw, 12px) 0; }
  .kick { margin: 0; font: 500 12px/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--soft); }
  .word { margin: 0; font: 600 clamp(64px, 15vw, 260px)/.82 var(--serif); letter-spacing: -.045em; }
  .line { margin: 0; max-width: 28ch; font: 400 clamp(22px, 2.4vw, 36px)/1.15 var(--serif); letter-spacing: -.01em; }

  /* panels: rounded, tinted with the project's colour, holding the work like a print on a board */
  .panel { margin: 0; border-radius: clamp(14px, 1.6vw, 24px); background: var(--tint); overflow: hidden; }
  .panel img, .panel video { display: block; width: 100%; height: auto; }
  .hero { min-height: min(78vh, 760px); display: grid; place-items: center; padding: clamp(24px, 5vw, 80px); overflow: visible; }
  .hero > img { border-radius: 12px; box-shadow: 0 30px 60px -36px rgb(0 0 0 / .45); max-height: 70vh; width: auto; max-width: 100%; }
  .full { padding: clamp(14px, 3vw, 48px); }
  .full img, .full video { border-radius: 10px; }

  /* the readable column */
  .col { width: min(100%, 62ch); justify-self: center; display: grid; gap: 16px; padding: clamp(12px, 3vh, 36px) 0; }
  .col p, .did li, .notes dd { margin: 0; font: 300 18px/1.6 var(--sans); }
  .intro > p:first-of-type { font: 400 clamp(20px, 1.6vw, 24px)/1.45 var(--serif); }
  .small-h { margin: 18px 0 0; font: 500 12px/1.3 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--soft); }
  .col > .small-h:first-child { margin-top: 0; }
  .sec-h { margin: 0 0 4px; font: 600 clamp(28px, 2.6vw, 40px)/1.08 var(--serif); letter-spacing: -.02em; text-wrap: balance; }
  .did { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .did li { padding-left: 22px; position: relative; }
  .did li::before { content: ""; position: absolute; left: 0; top: .72em; width: 10px; height: 1px; background: var(--c); }
  .facts { margin: 14px 0 0; padding-top: 16px; border-top: 1px solid rgb(0 0 0 / .12); display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px 24px; }
  .facts dt { font: 500 12px/1.3 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--soft); }
  .facts dd { margin: 4px 0 0; font: 400 16px/1.4 var(--sans); }
  .facts a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--c); }
  .tocome { color: var(--soft); font-style: italic; }
  .notes { margin: 10px 0 0; display: grid; gap: 18px; }
  .notes div { padding-top: 14px; border-top: 1px solid rgb(0 0 0 / .1); }
  .notes dt { font: 600 19px/1.25 var(--serif); margin-bottom: 4px; }
  .notes dd { color: #3A352E; }

  /* media rows */
  .media { display: grid; gap: clamp(10px, 1.6vw, 24px); padding: clamp(14px, 3vw, 48px); align-items: center; }
  .media figure { margin: 0; }
  .media img, .media video { border-radius: 10px; }
  .media.is-wide.n2 { grid-template-columns: 1fr 1fr; }
  .media.is-square { grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .media.is-square.n4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .media.is-square.n1 figure { width: min(100%, 640px); justify-self: center; }
  .media.is-phone { grid-template-columns: repeat(auto-fit, minmax(150px, 280px)); justify-content: center; padding-block: clamp(28px, 5vw, 72px); }
  .media.is-phone img, .media.is-phone video { border-radius: 22px; box-shadow: 0 30px 50px -34px rgb(0 0 0 / .5); }

  .impact { display: grid; gap: 16px; padding: 0 clamp(4px, 1vw, 12px); }
  .impact ul { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .impact li { display: grid; gap: 8px; align-content: start; padding: 22px; border-radius: 16px; background: var(--tint); }
  .impact b { font: 600 22px/1.15 var(--serif); }
  .impact span { font: 300 16px/1.5 var(--sans); color: #3A352E; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .stats div { display: grid; gap: 4px; padding: clamp(20px, 3vw, 40px); border-radius: 18px; background: var(--tint); }
  .stats b { font: 600 clamp(48px, 6vw, 96px)/.9 var(--serif); letter-spacing: -.04em; color: var(--c); }
  .stats span { font: 500 13px/1.3 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--soft); }

  .quote { margin: 0; justify-self: center; width: min(100%, 62ch); display: grid; gap: 18px; padding: clamp(20px, 5vh, 56px) 0; }
  .q-title { margin: 0; font: 600 clamp(30px, 3vw, 48px)/1.05 var(--serif); letter-spacing: -.02em; }
  .quote blockquote { margin: 0; display: grid; gap: 14px; }
  .quote blockquote p { margin: 0; font: 300 18px/1.6 var(--sans); }
  .quote figcaption { display: grid; gap: 2px; font: 400 15px/1.4 var(--sans); }
  .quote figcaption span { color: var(--soft); }

  .credits { justify-self: center; width: min(100%, 62ch); display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; padding: clamp(16px, 3vh, 36px) 0; border-top: 1px solid rgb(0 0 0 / .12); }
  .credits ul { margin: 12px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .credits li { display: grid; gap: 2px; font: 400 16px/1.35 var(--sans); }
  .credits li span { color: var(--soft); font-size: 14px; }
  .credits a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--c); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; margin: clamp(16px, 3vh, 36px) 0 clamp(60px, 10vh, 120px); border-top: 1px solid rgb(0 0 0 / .12); }
  .pager a { display: grid; gap: 6px; padding: 22px clamp(4px, 1vw, 12px); }
  .pager a:last-child { text-align: right; }
  .pager .t { font: 600 clamp(28px, 3.4vw, 52px)/1 var(--serif); letter-spacing: -.02em; }

  /* the object opens once, slowly, when the page arrives: no spring, no bounce */
  .hero :global(:is(.site3d, .ken3d, .stoa-brand, .alai3d, .pp3d, .hf3d)) { --x: 0; transition: --x 2.2s cubic-bezier(.33, .1, .25, 1) .3s; }
  .hero.open :global(:is(.site3d, .ken3d, .stoa-brand, .alai3d, .pp3d, .hf3d)) { --x: 1; }

  @media (max-width: 760px) {
    .case { padding-top: 76px; }
    .hero { min-height: 0; padding: 40px 12px; overflow: hidden; }
    /* zoom shrinks the object and its room together, so it stays centred */
    .hero :global(:is(.ken3d, .alai3d, .pp3d, .hf3d)) { zoom: .52; }
    .hero :global(.site3d) { zoom: .75; }
    .media.is-wide.n2, .impact ul, .media.is-square.n4 { grid-template-columns: minmax(0, 1fr); }
    .media.is-phone { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .credits { grid-template-columns: minmax(0, 1fr); }
    .col p, .did li, .notes dd { font-size: 17px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(:is(.site3d, .ken3d, .stoa-brand, .alai3d, .pp3d, .hf3d)) { transition: none; }
  }
</style>

<script>
  // Clips play only while on screen. The hero object opens once on arrival, and Alai's build plays.
  let io: IntersectionObserver | null = null;
  function init() {
    io?.disconnect();
    const hero = document.querySelector<HTMLElement>('.case [data-open]');
    if (!hero) return;
    requestAnimationFrame(() => hero.classList.add('open'));
    hero.querySelectorAll<HTMLVideoElement>('video[data-hover-play]').forEach((v) => { v.loop = true; v.play().catch(() => {}); });
    io = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
    }), { rootMargin: '10% 0px' });
    document.querySelectorAll<HTMLVideoElement>('.case video[data-play]').forEach((v) => io!.observe(v));
  }
  document.addEventListener('astro:page-load', init);
</script>
