---
import Base from '../../layouts/Base.astro';
import Halftone from '../../components/Halftone.astro';
import Dock from '../../components/Dock.astro';
import Thinking from '../../components/Thinking.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  // projects with a bespoke page (presentation: custom) are built by their own file in this folder
  return all.flatMap((project, i) => project.data.presentation === 'custom' ? [] : [{
    params: { slug: project.id },
    props: { project, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length], index: i },
  }]);
}

const { project, prev, next, index } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const hasWriteup = Boolean(project.body?.trim());
const pad = (i: number) => String(i).padStart(2, '0');

// Four piece cells. Projects with fewer pieces reuse the poster, cropped differently.
const crops = ['left top', 'right center', 'center bottom', 'right top'];
const sheetPieces = Array.from({ length: 4 }, (_, i) =>
  d.pieces[i] ? { src: d.pieces[i].src, label: d.pieces[i].label, pos: 'center top' } : { src: d.poster, label: 'Cover detail', pos: crops[i] },
);
const vt = (i: number) => `view-transition-name: sheet-c${i}`;
---
<Base title={`${d.title} · Chariot`} description={d.summary} dock theme="paper">
  <Dock slot="dock" current={project.id} />

  <section class="sheet" style={`--c:${d.color}`} aria-label={`${d.title} project sheet`}>
    <div class="cell meta" style={vt(0)}>
      <span class="label">Cat. {pad(index + 1)}{d.year ? ` · ${d.year}` : ''}</span>
      <span class="label">{[d.kind, ...d.disciplines].map((x) => <>{x}<br /></>)}</span>
    </div>
    <div class="cell piece" style={vt(1)} data-cursor={`${sheetPieces[0].label}|${d.title}`}>
      <Halftone src={sheetPieces[0].src} alt={`${d.title}: ${sheetPieces[0].label}`} tint={d.color} position={sheetPieces[0].pos} eager />
    </div>
    <div class="cell meta" style={vt(2)}>
      <span class="label">Frame 01</span>
      <p class="summary">{d.summary}</p>
    </div>
    <div class="cell name" style={vt(3)}>
      <h1>{d.title}</h1>
      <span class="label">{d.disciplines[0]}</span>
    </div>
    <div class="cell centre" style="view-transition-name: sheet-poster">
      <img src={d.poster} alt={`${d.title} cover`} decoding="async" />
    </div>
    <div class="cell piece" style={vt(5)} data-cursor={`${sheetPieces[1].label}|${d.title}`}>
      <Halftone src={sheetPieces[1].src} alt={`${d.title}: ${sheetPieces[1].label}`} tint={d.color} position={sheetPieces[1].pos} eager />
    </div>
    <div class="cell piece" style={vt(6)} data-cursor={`${sheetPieces[2].label}|${d.title}`}>
      <Halftone src={sheetPieces[2].src} alt={`${d.title}: ${sheetPieces[2].label}`} tint={d.color} position={sheetPieces[2].pos} />
    </div>
    <div class="cell meta" style={vt(7)}>
      <span class="label">{d.live ? 'Live' : 'Next'}</span>
      {d.live
        ? <a class="go" href={d.live} target="_blank" rel="noopener" data-tick>Visit the site ↗</a>
        : <a class="go" href={`/work/${next.id}`} data-tick>{next.data.title} →</a>}
      <span class="label keys">← → to move between projects</span>
    </div>
    <div class="cell piece" style={vt(8)} data-cursor={`${sheetPieces[3].label}|${d.title}`}>
      <Halftone src={sheetPieces[3].src} alt={`${d.title}: ${sheetPieces[3].label}`} tint={d.color} position={sheetPieces[3].pos} />
    </div>
    {[[1, 1], [2, 1], [1, 2], [2, 2]].map(([x, y]) => <span class="cross" style={`left:${x * 33.333}%;top:${y * 33.333}%`} aria-hidden="true"></span>)}
  </section>

  {d.thinking && <Thinking title={d.title} color={d.color} thinking={d.thinking} />}

  <article class="writeup">
    <aside class="label">{hasWriteup ? 'The work' : 'Write-up'}</aside>
    <div class="prose">
      {hasWriteup ? <Content /> : <p class="pending">No write-up yet. This project is live with its pieces, which is the point: a write-up gets added when we have one.</p>}
    </div>
  </article>

  {d.pieces.length > 0 && (
    <section class="pieces" aria-label="Pieces">
      {d.pieces.map((p) => (
        <figure data-reveal>
          <img src={p.src} alt={`${d.title}: ${p.label}`} loading="lazy" decoding="async" />
          <figcaption class="label">{p.label}</figcaption>
        </figure>
      ))}
    </section>
  )}

  <nav class="pager" aria-label="More projects">
    <a href={`/work/${prev.id}`} data-prev data-tick><span class="label">Previous</span><span class="t">{prev.data.title}</span></a>
    <a href={`/work/${next.id}`} data-next data-tick><span class="label">Next</span><span class="t">{next.data.title}</span></a>
  </nav>
</Base>

<style>

  /* the sheet: 3x3, dashed hairlines, dots where the lines cross */
  .sheet {
    position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(0, 1fr));
    height: calc(100svh - 150px); min-height: 520px; margin: 92px var(--gutter) 0;
    border-top: 1px dashed var(--line); border-bottom: 1px dashed var(--line);
  }
  /* cells are isolated by their view-transition names, so each paints its own paper for the halftone to multiply onto */
  .cell { position: relative; min-width: 0; min-height: 0; overflow: hidden; background: var(--bg); border-right: 1px dashed var(--line); border-bottom: 1px dashed var(--line); }
  .cell:nth-child(3n) { border-right: 0; }
  .cell:nth-child(n + 7) { border-bottom: 0; }
  .cross { position: absolute; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: var(--c); z-index: 3; }

  .meta { padding: 16px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }
  .summary { margin: 0; font: 400 clamp(17px, 1.5vw, 21px)/1.3 var(--serif); max-width: 26ch; }
  .go { font: 400 clamp(20px, 1.9vw, 28px)/1.1 var(--serif); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: var(--c); }
  .keys { opacity: .8; }
  .name { background: var(--c); color: #fff; padding: 16px; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; }
  .name h1 { margin: 0; font: 400 clamp(34px, 4.2vw, 64px)/.95 var(--serif); letter-spacing: -.02em; text-wrap: balance; }
  .name .label { color: rgb(255 255 255 / .75); }
  .centre { display: grid; place-items: center; padding: 14px; background: var(--surface); }
  .centre img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; box-shadow: 0 18px 40px -22px rgb(0 0 0 / .45); animation: turn 1.1s var(--ease) both; }
  @keyframes turn { from { transform: perspective(900px) rotateY(-28deg) scale(.94); opacity: .4; } }
  .piece { cursor: crosshair; }

  /* write-up and pieces */
  .writeup { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 32px; padding: 14vh var(--gutter) 10vh; max-width: 1180px; margin: 0 auto; }
  .prose { max-width: 62ch; display: grid; gap: 12px; }
  .prose :global(h2) { margin: 22px 0 0; font: 400 13px/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0; font: 400 clamp(19px, 1.6vw, 23px)/1.45 var(--serif); }
  .pending { color: var(--muted); }

  .pieces { display: grid; gap: 4vh; padding: 0 var(--gutter); max-width: 1180px; margin: 0 auto; }
  .pieces figure { margin: 0; display: grid; gap: 10px; }
  .pieces img { width: 100%; border-radius: 16px; background: var(--surface); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 16vh var(--gutter) 12vh; border-top: 1px dashed var(--line); }
  .pager a { display: grid; gap: 4px; padding: 22px 0; }
  .pager a:last-child { text-align: right; }
  .pager .t { font: 400 clamp(26px, 3vw, 40px)/1.05 var(--serif); }

  @media (max-width: 820px) {
    .sheet { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; grid-auto-rows: 34vw; height: auto; min-height: 0; margin-top: 76px; }
    .cell:nth-child(n) { border-right: 1px dashed var(--line); border-bottom: 1px dashed var(--line); }
    .cell:nth-child(2n) { border-right: 0; }
    .centre { grid-column: span 2; grid-row: span 2; order: -1; }
    .name { grid-column: span 2; order: -2; min-height: 30vw; }
    .cross { display: none; }
    .writeup { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .centre img { animation: none; } }
</style>
