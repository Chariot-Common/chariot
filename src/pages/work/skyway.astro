---
// Skyway: what we made was the website, so the case opens on the website itself, in 3D.
// It continues the homepage hover. The 3D site you clicked lands here (view transition); as you
// scroll it comes apart into the layers we designed, each one labelled, with Skyway's clouds.
//   1. The site, exploded: hero, nutrition, ingredients, product page with the checkout
//   2. The brief
//   3. Made for the thumb: the mobile-first screens, on a patch of sky
//   4. Three clicks to checkout
//   5. The pages
//   6. Pager
// Copy is from skyway.md (the current withchariot.com case study).
import Base from '../../layouts/Base.astro';
import Dock from '../../components/Dock.astro';
import SkywaySite from '../../components/SkywaySite.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((p) => p.id === 'skyway');
const me = all[i].data;
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];
const m = (p: string) => `/media/home/${p}`;
const small = (src: string) => `${src}?scale-down-to=2048`;

const phones = [
  { src: m('sky-1.jpg'), label: 'Nutrition, up front' },
  { src: m('sky-3-screen.jpg'), label: 'One shake, one decision' },
  { src: m('sky-2.jpg'), label: 'What goes in, and why' },
];
const steps = [
  { n: '1', head: 'Pick a flavour', body: 'Banana-berry or choco-hazel, right on the product page.' },
  { n: '2', head: 'Pick a pack', body: 'Six or twelve, with the price per bottle beside it.' },
  { n: '3', head: 'Check out', body: 'No detours. Three clicks from Instagram to ordered.' },
];
const cloud = 'M18 56C6 56 0 48 2 40c2-8 10-12 18-10 0-12 12-20 24-16C50 4 66 0 76 8c8-6 24-2 26 12 10 0 18 10 14 20-2 10-10 16-20 16Z';
---
<Base title="Skyway · Chariot" description={me.summary} dock theme="paper">
  <Dock slot="dock" current="skyway" />

  <svg width="0" height="0" class="defs" aria-hidden="true"><defs>
    <linearGradient id="sw-cloud" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" /><stop offset=".68" stop-color="#fff" /><stop offset="1" stop-color="#D6E5F8" /></linearGradient>
  </defs></svg>

  <!-- 1. The site, exploded -->
  <section class="hero" data-progress="pin">
    <div class="pin">
      <div class="sky" aria-hidden="true"></div>
      <div class="title">
        <p class="label">Case No. 03</p>
        <h1 class="display">Skyway</h1>
        <p class="sub">{me.summary}</p>
        <ul class="made" aria-label="What we made">
          {me.disciplines.map((d) => <li>{d}</li>)}
        </ul>
      </div>
      <div class="stage">
        <SkywaySite size={205} style="view-transition-name: sky-site" />
      </div>
      <p class="hint label" aria-hidden="true">Scroll to take it apart</p>
    </div>
  </section>

  <!-- 2. The brief -->
  <section class="brief">
    <p class="lede display">Skyway makes fitness-first food that satisfies cravings. With the branding and packaging done, they needed a website that balances conversions, the brand story and an experience people enjoy.</p>
    <dl class="facts">
      <div><dt class="label">Client</dt><dd>Skyway</dd></div>
      <div><dt class="label">Work</dt><dd>{me.disciplines.join(', ')}</dd></div>
      <div><dt class="label">Built for</dt><dd>Mobile first, for people arriving from Instagram and X</dd></div>
    </dl>
  </section>

  <!-- 3. Made for the thumb -->
  <section class="thumb">
    <div class="patch">
      <svg class="pc pc1" viewBox="0 0 120 60" aria-hidden="true"><path fill="url(#sw-cloud)" d={cloud} /></svg>
      <svg class="pc pc2" viewBox="0 0 120 60" aria-hidden="true"><path fill="url(#sw-cloud)" d={cloud} /></svg>
      <header>
        <span class="label">What we did</span>
        <h2 class="display">Made for the thumb.</h2>
        <p>Conversion-focused D2C UX, sleek and mobile-first, keeping decisions to a minimum. Content that explains nutrition, ingredients and the brand story in an engaging way.</p>
      </header>
      <div class="row">
        {phones.map((p, k) => (
          <figure data-reveal style={`--k:${k}`}>
            <div class="ph big"><img src={p.src} alt={`Skyway on mobile: ${p.label}`} loading="lazy" class:list={{ framed: p.framed }} /></div>
            <figcaption class="label">{p.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Three clicks to checkout -->
  <section class="clicks">
    <span class="label">What changed</span>
    <h2 class="display">Three clicks to checkout.</h2>
    <ol>
      {steps.map((s) => (
        <li data-reveal>
          <span class="n display">{s.n}</span>
          <h3>{s.head}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="also">And full transparency on ingredients, so visitors know not just what goes into a bottle of Skyway, but why it's there.</p>
  </section>

  <!-- 5. The pages -->
  <section class="pages" aria-label="Pages">
    {me.pieces.map((p) => (
      <figure data-reveal>
        <img src={small(p.src)} alt={`Skyway: ${p.label}`} loading="lazy" decoding="async" />
        <figcaption class="label">{p.label}</figcaption>
      </figure>
    ))}
  </section>

  <nav class="pager" aria-label="More projects">
    <a href={`/work/${prev.id}`} data-prev data-tick><span class="label">Previous</span><span class="display">{prev.data.title}</span></a>
    <a href={`/work/${next.id}`} data-next data-tick><span class="label">Next</span><span class="display">{next.data.title}</span></a>
  </nav>
</Base>

<style>
  :global(html.theme-paper) { --sky: #2F5BD3; --sky-soft: #CFE2FA; --shake: #F4C7C3; }
  .defs { position: absolute; }
  .label { color: var(--muted); }

  /* ---- 1. the site, exploded: --p runs 0 → 1 across the pinned hero ---- */
  .hero { height: 230vh; }
  .pin { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: center; padding: 0 var(--gutter); }
  /* the site comes apart over the first two thirds of the scroll, then holds */
  .hero :global(.site3d) { --x: clamp(0, calc((var(--p, 0) - .04) * 1.6), 1); }
  .sky { position: absolute; inset: 0; background: radial-gradient(60vw 70vh at 66% 55%, var(--sky-soft), #EEF4FC 50%, #fff 78%);
    opacity: clamp(0, calc(var(--p, 0) * 3), 1); }
  .title { position: relative; z-index: 2; display: grid; gap: 14px; align-content: center; padding-left: 4vw; }
  .title h1 { margin: 0; font-size: clamp(56px, 8vw, 140px); line-height: .9; }
  .title .sub { margin: 0; max-width: 30ch; font: 300 clamp(16px, 1.4vw, 20px)/1.4 var(--sans); color: var(--muted); }
  .made { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .made li { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); font: 400 14px/1 var(--sans); }
  .stage { position: relative; z-index: 2; display: grid; place-items: center; translate: 0 4vh; }
  .hint { position: absolute; bottom: 3vh; left: 0; right: 0; text-align: center; z-index: 6; opacity: calc(1 - var(--p, 0) * 6); }

  /* phone frames, used in "made for the thumb" */
  .ph { position: relative; aspect-ratio: 9 / 19.2; border-radius: 30px; background: #1E1710; padding: 6px;
    box-shadow: 0 30px 60px -30px rgb(30 23 16 / .5); overflow: hidden; }
  .ph img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 24px; }
  .ph img.framed { object-position: center; scale: 1.1; }
  @keyframes drift { to { transform: translateX(1.4vw) translateY(-.6vh); } }

  /* ---- 2. brief ---- */
  .brief { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 4vw; padding: 16vh var(--gutter) 12vh; max-width: 1400px; margin: 0 auto; }
  .lede { margin: 0; font-size: clamp(26px, 2.8vw, 44px); line-height: 1.12; }
  .facts { margin: 0; display: grid; gap: 18px; align-content: start; }
  .facts dd { margin: 4px 0 0; font-size: 17px; }

  /* ---- 3. made for the thumb ---- */
  .thumb { padding: 0 var(--gutter); }
  .patch { position: relative; overflow: hidden; max-width: 1400px; margin: 0 auto; border-radius: 28px; padding: 10vh 4vw 12vh;
    background: linear-gradient(#6E97EC, var(--sky) 60%); color: #fff; }
  .patch .label { color: rgb(255 255 255 / .75); }
  .patch header { position: relative; z-index: 2; max-width: 46ch; display: grid; gap: 14px; }
  .patch h2 { margin: 0; font-size: clamp(40px, 5vw, 80px); line-height: .95; }
  .patch header p { margin: 0; font-size: 18px; line-height: 1.5; color: rgb(255 255 255 / .9); }
  .pc { position: absolute; height: auto; z-index: 1; filter: drop-shadow(0 14px 16px rgb(20 40 110 / .25)); animation: drift 9s ease-in-out infinite alternate; }
  .pc1 { width: 26vw; right: -5vw; top: 5vh; }
  .pc2 { width: 16vw; left: 30%; bottom: -3vh; animation-duration: 11s; }
  .row { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3vw; margin-top: 8vh; }
  .row figure { margin: 0; display: grid; justify-items: center; gap: 16px; }
  .row figure:nth-child(2) { translate: 0 6vh; }
  .ph.big { position: relative; width: min(100%, 260px); }

  /* ---- 4. three clicks ---- */
  .clicks { max-width: 1400px; margin: 0 auto; padding: 18vh var(--gutter) 12vh; }
  .clicks h2 { margin: 10px 0 0; font-size: clamp(40px, 5.4vw, 88px); line-height: .95; }
  .clicks ol { list-style: none; margin: 8vh 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3vw; counter-reset: none; }
  .clicks li { position: relative; display: grid; gap: 8px; padding-top: 22px; border-top: 1px solid var(--line); }
  /* each step sits on its own little cloud, joined by a dotted flight path */
  .clicks .n { width: 64px; height: 64px; display: grid; place-items: center; border-radius: 50%; background: var(--shake); font-size: 30px; }
  .clicks li:not(:last-child)::after { content: ""; position: absolute; top: 54px; left: 76px; right: -2vw; border-top: 2px dotted var(--shake); }
  .clicks h3 { margin: 10px 0 0; font: 500 22px/1.2 var(--sans); }
  .clicks li p { margin: 0; color: var(--muted); max-width: 30ch; }
  .also { margin: 10vh 0 0; max-width: 40ch; font: 400 clamp(22px, 2.2vw, 32px)/1.25 var(--serif); }

  /* ---- 5. pages ---- */
  .pages { display: grid; gap: 6vh; padding: 0 var(--gutter) 10vh; max-width: 1400px; margin: 0 auto; }
  .pages figure { margin: 0; display: grid; gap: 10px; }
  .pages img { width: 100%; border-radius: 18px; background: var(--surface); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; padding: 4vh var(--gutter) 14vh; max-width: 1400px; margin: 0 auto; border-top: 1px solid var(--line); }
  .pager a { display: grid; gap: 4px; padding-top: 18px; }
  .pager a:last-child { text-align: right; }
  .pager .display { font-size: clamp(26px, 3vw, 40px); }

  @media (max-width: 820px) {
    .brief { grid-template-columns: minmax(0, 1fr); }
    .row { grid-template-columns: minmax(0, 1fr); gap: 6vh; }
    .row figure:nth-child(2) { translate: none; }
    .clicks ol { grid-template-columns: minmax(0, 1fr); gap: 5vh; }
    .clicks li:not(:last-child)::after { display: none; }
    .pin { grid-template-columns: minmax(0, 1fr); align-content: center; gap: 2vh; padding-top: 70px; }
    .title { padding-left: 0; justify-items: center; text-align: center; }
    .made { justify-content: center; }
    .stage { scale: .62; margin: -14vh 0; }
    .pc1 { width: 50vw; }
    .pc2 { width: 34vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pc { animation: none; }
  }
</style>
