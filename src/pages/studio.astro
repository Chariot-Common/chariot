---
// Studio, as a small museum of Chariot: old craft, new tools. Calm, not cute.
// After the references: Gem Quest (the "WE( )ARE" opener, the team as a tree of lines), the
// Staatliche Museen zu Berlin (type collage with figures set into the words, an orange wall),
// the old masters with a MacBook (AI detection boxes over a painting), dmcg.co (everything comes
// into focus out of a soft blur), and teenage engineering (still figures, nothing hops).
//   1. Night: CHARI( )OT. Products, brands and websites take turns in the brackets; the four aims below
//   2. Paper: what we believe, as a type collage
//   3. Paper: the Charioteers as a tree; point at one and the machine finds their thing (their power)
//   4. Orange: how we work, four exhibits on plinths (only one is the chariot)
//   5. Paper: join, and say hello
// Every line of copy is Chariot's own, from withchariot.com. Nothing here is made up.
//
// Images: the six paintings cut close round each figure, no paper edge: for the night
// (public/media/people/night, cut with scripts/cut-night.py) and for paper (public/media/people/fig,
// scripts/cut-tight.py). Prompts for redrawn, cleaner figures: docs/character-prompts.md.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

// the v3 paintings (13 Nov): each Charioteer at rest, and with their power (one orange mark)
const v3 = (slug: string, k: 'rest' | 'power') => `/media/people/v3/${({ backpack: 'tanujaa', glasses: 'shreesh', handstand: 'siddharth' } as Record<string, string>)[slug] ?? slug}-${k}.webp`;

// The crew. Fill in the blanks (name, role) and drop a real photo at
// public/media/people/photos/<slug>.jpg, then set photo: true. box is where their one thing sits
// in the figure (x, y, w, h in %), for the detection box.
const head = { slug: 'aakash', img: 'aakash-armour.webp', w: 901, h: 1361, name: 'Aakash Rodrigues', role: 'Creative Director & Lead Designer', thing: 'laptop', score: '0.97', box: [1, 10, 29, 15], photo: false };
const crew = [
  { slug: 'joshua', img: 'joshua-speaker.webp', w: 936, h: 1364, name: 'Joshua Rodrigues', role: '', thing: 'speaker', score: '0.98', box: [0, 23, 18, 20], photo: false },
  { slug: 'samridhi', img: 'samridhi-visor.webp', w: 981, h: 1299, name: 'Samridhi Aggarwal', role: '', thing: 'visor', score: '0.96', box: [7, 0, 25, 13], photo: false },
  { slug: 'backpack', img: 'backpack.webp', w: 975, h: 1387, name: 'Tanujaa Hemakumar', role: '', thing: 'backpack', score: '0.95', box: [60, 1, 34, 44], photo: false },
  { slug: 'glasses', img: 'glasses.webp', w: 929, h: 1382, name: 'Shreesh Kuliyal', role: 'UI/UX & Product Designer', thing: 'glasses', score: '0.94', box: [32, 8, 21, 7], photo: false },
  { slug: 'handstand', img: 'handstand.webp', w: 1003, h: 1354, name: 'Siddharth Thorat', role: 'Jr. UI/UX & Product Designer', thing: 'sneakers', score: '0.93', box: [0, 1, 15, 16], photo: false },
];
const everyone = [head, ...crew];

// the opener: what we make takes turns in the brackets, and what we aim for runs along the foot
const makes = ['products', 'brands', 'websites'];
const aims = ['Distinguished', 'Effective', 'Delightful', 'Tailored'];

// how we work: four exhibits on plinths, in Chariot's own words. Only the last is the chariot;
// the others are drawn here in ink (the question mark, rays in every direction, frames zooming in).
const habits = [
  { no: 'No. 1', name: 'The question', body: 'We ask the "why" to every "what".', obj: 'why' },
  { no: 'No. 2', name: 'Every direction', body: 'We explore every direction. We dig beyond the "that\'s how they\'re doing it".', obj: 'rays' },
  { no: 'No. 3', name: 'Zoom out, then in', body: 'We consider the psychology, not just the "features". We zoom out before we zoom in. We distill.', obj: 'zoom' },
  { no: 'No. 4', name: 'Test and iterate', body: 'We test and iterate. Distinguished, effective, delightful, tailored.', obj: 'chariot' },
];
const rays = Array.from({ length: 12 }, (_, i) => { const a = (i / 12) * Math.PI * 2 - Math.PI / 2, r = i % 2 ? 70 : 92; return { x: 100 + Math.cos(a) * r, y: 100 + Math.sin(a) * r, i }; });
---
<Base title="Studio · Chariot" description="Chariot crafts products, brands and websites with nuance and good taste. Who we are and how we work." bare>
  <div class="museum">
    <Nav />

    <!-- 1. night: no figures here; the Charioteers are further down -->
    <header class="opener" data-night>
      <div class="stage">
        <h1 class="title" aria-label="Chariot crafts products, brands and websites with nuance and good taste.">
          <span class="rise" style="--d:.05s" aria-hidden="true">Chari(</span>
          <span class="gap rise" style="--d:.25s" aria-hidden="true" data-gap>
            {makes.map((w, i) => <span class:list={{ on: i === 0 }}>{w}</span>)}
          </span>
          <span class="rise" style="--d:.15s" aria-hidden="true">)ot</span>
        </h1>
        <p class="line rise" style="--d:.35s">Chariot crafts products, brands and websites<br />with nuance and good taste.</p>
      </div>
      <div class="aims">
        <p class="aims-k rise" style="--d:.5s">That's what we aim for</p>
        <ol>
          {aims.map((a, i) => <li class="rise" style={`--d:${0.55 + i * 0.08}s`}><span class="n">{String(i + 1).padStart(2, '0')}</span>{a}</li>)}
        </ol>
      </div>
    </header>

    <!-- 2. paper: what we believe -->
    <section class="paper believe" aria-labelledby="h-believe">
      <div class="intro" data-reveal>
        <h2 id="h-believe" class="label-h">About us</h2>
        <p class="small">Chariot crafts products, brands and websites with nuance and good taste.</p>
        <p class="creed">We believe great design stems from deep insights, radical vision, clarity of the jobs to be done, a will to delight and a ton of attention to detail.</p>
      </div>
      <p class="collage" aria-label="That's why we ask the why to every what. We explore every direction. We consider the psychology, not just the features. We zoom out before we zoom in. We distill. We test and iterate.">
        <span class="row" data-reveal aria-hidden="true"><span class="s">We ask the</span> <b class="caps">why</b> <span class="s">to every</span> <span class="o caps">what.</span></span>
        <span class="row" data-reveal aria-hidden="true"><span class="s">We explore</span> <b class="caps">every</b> <span class="o s">direction.</span></span>
        <span class="row" data-reveal aria-hidden="true"><span class="s">We consider the</span> <span class="o caps">psychology,</span></span>
        <span class="row" data-reveal aria-hidden="true"><span class="s">not just the features.</span></span>
        <span class="row" data-reveal aria-hidden="true"><span class="s">We zoom</span> <b class="caps">out</b> <span class="s">before we zoom</span> <b class="caps">in.</b></span>
        <span class="row" data-reveal aria-hidden="true"><span class="o caps">We distill.</span> <span class="s">We test and iterate.</span></span>
      </p>
    </section>

    <!-- 3. paper: the Charioteers, as a tree -->
    <section class="paper tree" aria-labelledby="h-team" data-tree>
      <h2 id="h-team" class="tree-h" data-reveal><span class="dots" aria-hidden="true">· · · ·</span>The Charioteers</h2>
      <p class="hint" data-reveal>Point at a Charioteer to see them at work.</p>
      <div class="family">
        <svg class="lines" aria-hidden="true" data-lines></svg>
        {everyone.map((c, i) => (
          <figure class:list={['node', { top: i === 0 }]} data-node data-reveal style={`--i:${i}`} data-thing={c.thing} data-score={c.score}>
            <div class="pose-wrap">
              <div class="pose">
                <img class="art" src={v3(c.slug, 'rest')} width="640" height="960" alt={`${c.name}, painted with their ${c.thing}`} loading="eager" decoding="async" />
                <img class="power" src={v3(c.slug, 'power')} width="640" height="960" alt="" aria-hidden="true" loading="eager" decoding="async" />
                {c.photo && <img class="real" src={`/media/people/photos/${c.slug}.jpg`} alt="" loading="lazy" />}
              </div>
              <span class="floor" aria-hidden="true"></span>
            </div>
            <figcaption><span class="mono">{c.name || 'Name to come'}</span><span class="role">{c.role || 'Charioteer'}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 4. orange: how we work, four exhibits on plinths -->
    <section class="wall" aria-labelledby="h-work" data-exhibits tabindex="-1">
      <div class="wall-head" data-reveal>
        <h2 id="h-work" class="label-h">How we work</h2>
        <p class="small">Thoroughly conceptualised, thoughtfully crafted.</p>
      </div>
      <div class="hall" data-hall data-reveal>
        {habits.map((h, i) => (
          <figure class="exhibit" data-i={i} style={`--o:${i}`} aria-hidden={i === 0 ? 'false' : 'true'}>
            <div class:list={['obj', h.obj]} aria-hidden="true">
              {h.obj === 'why' && <span class="q">?</span>}
              {h.obj === 'rays' && (
                <svg viewBox="0 0 200 218">
                  {rays.map((r) => <line class="base" x1="100" y1="100" x2={r.x.toFixed(1)} y2={r.y.toFixed(1)} />)}
                  {rays.map((r) => <line x1="100" y1="100" x2={r.x.toFixed(1)} y2={r.y.toFixed(1)} pathLength="1" style={`--k:${r.i}`} />)}
                  {rays.map((r) => <circle cx={r.x.toFixed(1)} cy={r.y.toFixed(1)} r="3.2" style={`--k:${r.i}`} />)}
                  <circle class="hub" cx="100" cy="100" r="6" />
                </svg>
              )}
              {h.obj === 'zoom' && (
                <svg viewBox="0 0 200 226">
                  {[0, 1, 2, 3, 4].map((k) => <rect x="36" y="30" width="128" height="128" rx="4" style={`--k:${k}`} />)}
                  <circle class="dot" cx="100" cy="94" r="4" />
                </svg>
              )}
              {h.obj === 'chariot' && <img src="/media/wheel/ink/chariot.webp" alt="" loading="lazy" draggable="false" />}
            </div>
            <div class="plinth" aria-hidden="true"><span class="lid"></span><span class="body"><span class="plate">{h.no}</span></span></div>
            <figcaption><b>{h.name}</b><span>{h.body}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="keys" data-reveal>
        <button type="button" class="key" data-prev aria-label="Previous habit">←</button>
        <span class="count" data-count>1 / {habits.length}</span>
        <button type="button" class="key" data-next aria-label="Next habit">→</button>
      </div>
    </section>

    <!-- 5. paper: join, and hello -->
    <section class="paper join" aria-labelledby="h-join">
      <h2 id="h-join" class="tree-h" data-reveal><span class="dots" aria-hidden="true">· · · ·</span>Join the Charioteers</h2>
      <ul class="rows" data-reveal>
        <li><a href="mailto:hello@withchariot.com?subject=Joining%20Chariot"><span class="mono">Designers who sweat the details</span><span class="arrow" aria-hidden="true">↗</span></a></li>
        <li><a href="mailto:hello@withchariot.com"><span class="mono">Every project starts with a question. Ask us yours</span><span class="arrow" aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .museum { --paper: #EEF0EC; --ink: #16130F; --soft: #6B6B66; --night: #121110; --cream: #F3EADB; --orange: #F0582E; --line: rgb(22 19 15 / .22);
    --mono: ui-monospace, "SFMono-Regular", Menlo, monospace; --ease: cubic-bezier(.2, .8, .2, 1); --spring: cubic-bezier(.3, 1.5, .4, 1);
    background: #FFFFFF; color: var(--ink); padding: 10px; display: grid; gap: 10px; overflow-x: clip; }
  :global(html:has(.museum)), :global(body:has(.museum)) { background: #FFFFFF; color-scheme: light; }
  .museum :global(.nav) { --nav-ink: #16130F; }
  .museum.over-night :global(.nav) { --nav-ink: #F3EADB; }
  .mono { font: 400 13px/1.3 var(--mono); }
  .label-h { margin: 0; font: 400 18px/1 var(--serif); }
  .small { margin: 0; font: 400 12px/1.5 var(--mono); color: var(--soft); max-width: 34ch; }

  /* everything comes into focus out of a soft blur (after dmcg) */
  .rise { animation: focus-in 1.1s var(--ease) var(--d, 0s) both; }
  @keyframes focus-in { from { opacity: 0; filter: blur(14px); translate: 0 24px; } }
  :global(html.js) [data-reveal] { opacity: 0; filter: blur(12px); translate: 0 28px; transition: opacity .9s var(--ease), filter .9s var(--ease), translate .9s var(--ease); transition-delay: calc(var(--i, 0) * 90ms); }
  :global(html.js) [data-reveal].in { opacity: 1; filter: none; translate: 0 0; }


  /* ---- 1. the opener ---- */
  .opener { position: relative; border-radius: 22px; overflow: hidden; background: var(--night); color: var(--cream);
    min-height: calc(100svh - 20px); display: grid; grid-template-rows: 1fr auto; padding: 90px clamp(16px, 2.4vw, 32px) 22px; }
  .opener::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background: radial-gradient(60% 50% at 50% 42%, rgb(243 234 219 / .08), transparent 70%); }
  .stage { align-self: center; display: grid; justify-items: center; gap: clamp(18px, 3vh, 34px); }
  .title { margin: 0; display: flex; align-items: flex-end; font: 400 clamp(64px, 14vw, 250px)/.85 var(--serif); letter-spacing: -.03em; white-space: nowrap; }
  /* the brackets hold one word at a time, in a slow cross-fade out of a blur */
  .gap { display: inline-grid; align-self: center; justify-items: center; margin: 0 .06em; font: italic 400 .3em/1 var(--serif); letter-spacing: 0; color: var(--orange); }
  .gap span { grid-area: 1 / 1; opacity: 0; filter: blur(8px); translate: 0 .25em; transition: opacity 1.2s var(--ease), filter 1.2s var(--ease), translate 1.2s var(--ease); }
  .gap span.on { opacity: 1; filter: none; translate: 0 0; }
  .gap span.off { opacity: 0; filter: blur(8px); translate: 0 -.25em; }
  .line { margin: 0; font: 400 12px/1.5 var(--mono); text-align: center; color: rgb(243 234 219 / .7); }
  .aims { display: grid; gap: 14px; border-top: 1px solid rgb(243 234 219 / .18); padding-top: 16px; }
  .aims-k { margin: 0; font: 400 11px/1 var(--mono); color: rgb(243 234 219 / .45); }
  .aims ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(8px, 2vw, 28px); }
  .aims li { display: grid; gap: 8px; font: 400 clamp(22px, 2.6vw, 40px)/1 var(--serif); }
  .aims .n { font: 400 10px/1 var(--mono); color: var(--orange); }

  /* ---- paper ---- */
  .paper { border-radius: 22px; background: var(--paper); padding: clamp(40px, 9vh, 110px) clamp(16px, 4vw, 64px); }

  /* ---- 2. what we believe ---- */
  .believe { display: grid; gap: 9vh; }
  .intro { display: grid; grid-template-columns: 200px minmax(0, 34ch) minmax(0, 1fr); gap: 32px; align-items: start; }
  .creed { margin: 0; font: 400 clamp(20px, 1.8vw, 28px)/1.15 var(--serif); max-width: 26ch; }
  .collage { margin: 0; display: grid; justify-items: center; gap: .1em; text-align: center; font-size: clamp(30px, 5vw, 84px); line-height: .95; }
  .row { display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .22em; }
  .s { font-family: var(--serif); font-weight: 400; letter-spacing: -.03em; }
  .caps { font: 800 1em/1 var(--sans); letter-spacing: -.04em; text-transform: uppercase; }
  .o { color: var(--orange); }
  /* two Charioteers stand in the words */

  /* ---- 3. the tree ---- */
  .tree { display: grid; justify-items: center; gap: 14px; }
  .tree-h { margin: 0; display: grid; justify-items: center; gap: 6px; font: 400 clamp(26px, 2.6vw, 40px)/1 var(--serif); }
  .dots { font: 700 14px/1 var(--mono); letter-spacing: .2em; }
  .hint { margin: 0 0 4vh; font: 400 12px/1.4 var(--mono); color: var(--soft); }
  .family { position: relative; width: 100%; max-width: 1180px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: clamp(12px, 2.4vw, 36px); row-gap: 12vh; }
  .lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .lines :global(path) { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s var(--ease); }
  .lines.in :global(path) { stroke-dashoffset: 0; }
  .lines.in :global(path:nth-child(2)) { transition-delay: .08s; } .lines.in :global(path:nth-child(3)) { transition-delay: .16s; }
  .lines.in :global(path:nth-child(4)) { transition-delay: .24s; } .lines.in :global(path:nth-child(5)) { transition-delay: .32s; }
  .node { margin: 0; display: grid; justify-items: center; align-content: end; gap: 14px; text-align: center; position: relative; z-index: 1; cursor: crosshair; }
  .node.top { grid-column: 1 / -1; justify-self: center; width: clamp(170px, 20vw, 260px); }
  .pose-wrap { position: relative; width: 100%; }
  .pose { position: relative; }
  .art { display: block; width: 100%; height: auto; filter: drop-shadow(0 2px 1px rgb(22 19 15 / .18)); }
  .real { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .4s; }
  .node:hover .real { opacity: 1; }
  .floor { position: absolute; left: 18%; right: 18%; bottom: -6px; height: 12px; border-radius: 50%; background: radial-gradient(closest-side, rgb(22 19 15 / .22), transparent); z-index: -1; }
  /* rest, and on hover their power: the same figure at work, with its one orange mark */
  .power { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .5s ease; filter: drop-shadow(0 2px 1px rgb(22 19 15 / .18)); }
  .art { transition: opacity .5s ease; }
  .node:hover .power, .node.on .power, .node:focus-within .power { opacity: 1; }
  .node:hover .art, .node.on .art, .node:focus-within .art { opacity: 0; }
  figcaption { display: grid; gap: 3px; }
  .role { font: 400 clamp(14px, 1.2vw, 17px)/1.2 var(--serif); }

  /* ---- 4. the orange wall ---- */
  .wall { border-radius: 22px; background: var(--orange); color: var(--ink); padding: clamp(36px, 7vh, 80px) clamp(16px, 4vw, 64px); display: grid; gap: 4vh; overflow: hidden; outline: none; }
  .wall .small { color: rgb(22 19 15 / .7); }
  .wall-head { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 32px; }
  .hall { position: relative; height: clamp(440px, 60vh, 600px); touch-action: pan-y; user-select: none; cursor: grab; }
  .hall:active { cursor: grabbing; }
  .exhibit { position: absolute; left: 50%; bottom: 0; margin: 0; width: clamp(240px, 30vw, 380px); display: grid; justify-items: center;
    translate: calc(-50% + var(--o, 0) * clamp(250px, 34vw, 480px)) 0; scale: calc(1 - min(1, abs(var(--o, 0))) * .5); transform-origin: 50% 100%;
    opacity: calc(1 - min(1, max(0, abs(var(--o, 0)) - 1))); transition: translate 1s var(--ease), scale 1s var(--ease), opacity .5s; }
  .obj { width: 100%; height: clamp(200px, 32vh, 320px); display: grid; place-items: end center; padding-bottom: 14px; }
  .obj svg { max-width: 100%; }
  .obj.zoom { padding-bottom: 30px; }
  .obj svg { height: 100%; width: auto; overflow: visible; }
  .obj > img { max-width: 100%; max-height: 100%; width: auto; height: auto; }
  /* 1. the question mark turns slowly on its plinth, like a sculpture */
  .q { font: 400 clamp(200px, 30vh, 320px)/.8 var(--serif); color: var(--ink); animation: turnY 9s ease-in-out infinite; text-shadow: .015em .02em 0 rgb(22 19 15 / .25); }
  @keyframes turnY { 0%, 100% { transform: perspective(700px) rotateY(-28deg); } 50% { transform: perspective(700px) rotateY(28deg); } }
  /* 2. every direction: rays draw out one after another, then fade together, and again */
  .rays line { stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: ray 6s var(--ease) infinite; animation-delay: calc(var(--k) * .12s - .6s); }
  .rays circle { fill: var(--ink); opacity: 0; animation: tip 6s var(--ease) infinite; animation-delay: calc(var(--k) * .12s - .6s); }
  .rays .hub { opacity: 1; animation: none; }
  .rays .base { stroke: rgb(22 19 15 / .2); stroke-width: 1.5; stroke-dasharray: none; stroke-dashoffset: 0; animation: none; }
  @keyframes ray { 0% { stroke-dashoffset: 1; opacity: 1; } 22%, 70% { stroke-dashoffset: 0; opacity: 1; } 90%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes tip { 0%, 14% { opacity: 0; } 24%, 70% { opacity: 1; } 90%, 100% { opacity: 0; } }
  /* 3. zoom out, then in: frames come out of the centre and grow past the edge */
  .zoom rect { fill: none; stroke: var(--ink); stroke-width: 2; transform-origin: 100px 94px; transform-box: view-box; animation: frame 8s linear infinite; animation-delay: calc(var(--k) * -1.6s); }
  .zoom .dot { fill: var(--ink); }
  @keyframes frame { 0% { transform: scale(.04); opacity: 0; } 15% { opacity: 1; } 60% { opacity: 1; } 100% { transform: scale(1); opacity: 0; } }
  /* 4. the chariot rolls a little way and back */
  .chariot img { animation: roll 7s ease-in-out infinite; }
  @keyframes roll { 0%, 100% { translate: -6% 0; } 50% { translate: 6% 0; } }
  /* only the exhibit in front moves */
  .exhibit[aria-hidden="true"] * { animation-play-state: paused !important; }
  .plinth { width: 62%; display: grid; }
  .lid { height: 18px; background: #2A2520; clip-path: polygon(6% 0, 94% 0, 100% 100%, 0 100%); }
  .body { height: 64px; background: var(--ink); display: grid; place-items: center; }
  .plate { padding: 5px 10px; background: #C9A45C; color: var(--ink); font: 500 10px/1 var(--mono); letter-spacing: .08em; box-shadow: inset 0 1px 0 rgb(255 255 255 / .35), inset 0 -1px 0 rgb(0 0 0 / .25); }
  .exhibit figcaption { margin-top: 22px; display: grid; gap: 10px; justify-items: center; text-align: center; max-width: 34ch; transition: opacity .5s, filter .5s; }
  .exhibit[aria-hidden="true"] figcaption { opacity: 0; filter: blur(6px); }
  .exhibit b { font: 400 clamp(24px, 2.4vw, 36px)/1.05 var(--serif); }
  .exhibit figcaption span { font: 400 13px/1.5 var(--mono); }
  /* real, pressable keys (after teenage engineering) */
  .keys { justify-self: center; display: flex; align-items: center; gap: 16px; margin-top: 2vh; }
  .count { font: 400 12px/1 var(--mono); min-width: 5ch; text-align: center; }
  .key { width: 52px; height: 40px; border: 0; border-radius: 8px; cursor: pointer; font: 500 16px/1 var(--mono); color: var(--ink);
    background: linear-gradient(#F4F1EC, #DEDAD3); box-shadow: 0 4px 0 #A8A39A, 0 6px 10px rgb(22 19 15 / .25), inset 0 1px 0 #fff;
    transition: translate .08s, box-shadow .08s; }
  .key:hover { background: linear-gradient(#FAF8F4, #E6E2DB); }
  .key:active { translate: 0 3px; box-shadow: 0 1px 0 #A8A39A, 0 2px 4px rgb(22 19 15 / .25), inset 0 1px 0 #fff; }
  .key:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }

  /* ---- 5. join ---- */
  .join { display: grid; gap: 4vh; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4vw; padding: 22px 0; }
  .rows .mono { font-size: clamp(16px, 1.6vw, 22px); }
  .arrow { font-size: 24px; transition: translate .3s; }
  .rows a:hover .arrow { translate: 4px -4px; }

  @media (max-width: 860px) {
    .title { font-size: 15vw; }
    .gap { font-size: .34em; }
    .aims ol { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 18px; }
    .intro, .wall-head { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .exhibit { width: min(78vw, 320px); translate: calc(-50% + var(--o, 0) * 86vw) 0; }
    .hall { height: 520px; }
    .family { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 8vh; }
    .node.top { width: 62%; }
    .lines { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .museum *, .museum *::before, .museum *::after { animation: none !important; transition-duration: .01ms !important; }
    :global(html.js) [data-reveal], .rise { opacity: 1; filter: none; translate: none; }
  }
</style>

<script>
  // The bar is cream over the night. The Charioteers take turns in the brackets, slowly (or the one
  // you point at). Sections come into focus as they scroll in. The tree draws its lines to each
  // Charioteer, and the detector names their thing.
  let stop: AbortController | null = null;
  function init() {
    stop?.abort();
    const page = document.querySelector<HTMLElement>('.museum');
    if (!page) return;
    stop = new AbortController();
    const { signal } = stop;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const timers: number[] = [];
    signal.addEventListener('abort', () => timers.forEach((t) => clearInterval(t)));

    // night bar
    const night = page.querySelector<HTMLElement>('[data-night]')!;
    const onNight = () => page.classList.toggle('over-night', night.getBoundingClientRect().bottom > 40);

    // 1. the brackets: products, brands, websites, slowly
    const words = [...page.querySelectorAll<HTMLElement>('[data-gap] span')];
    let at = 0;
    const put = (n: number) => {
      const prev = words[at];
      prev.classList.remove('on'); prev.classList.add('off');
      setTimeout(() => prev.classList.remove('off'), 1300);
      at = n; words[at].classList.add('on');
    };
    if (!calm) timers.push(window.setInterval(() => { if (!document.hidden) put((at + 1) % words.length); }, 3000));

    // reveals
    const io = new IntersectionObserver((es) => es.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }), { rootMargin: '0px 0px -12% 0px' });
    page.querySelectorAll('[data-reveal]').forEach((n) => io.observe(n));
    signal.addEventListener('abort', () => io.disconnect());

    // 3. the tree: lines from the head to each Charioteer
    const tree = page.querySelector<HTMLElement>('[data-tree]')!;
    const svg = tree.querySelector<SVGSVGElement>('[data-lines]')!;
    const nodes = [...tree.querySelectorAll<HTMLElement>('[data-node]')];
    const draw = () => {
      const box = svg.getBoundingClientRect();
      const [top, ...kids] = nodes.map((n) => n.querySelector<HTMLElement>('.pose-wrap')!.getBoundingClientRect());
      const hx = top.left + top.width / 2 - box.left, hy = nodes[0].getBoundingClientRect().bottom - box.top + 14;
      svg.innerHTML = kids.map((k) => {
        const cx = k.left + k.width / 2 - box.left, cy = k.top - box.top - 14, m = (hy + cy) / 2;
        return `<path pathLength="1" d="M${hx} ${hy} C${hx} ${m} ${cx} ${m} ${cx} ${cy}" />`;
      }).join('');
    };
    draw();
    const lio = new IntersectionObserver((es) => es.forEach((en) => { if (en.isIntersecting) { svg.classList.add('in'); lio.disconnect(); } }), { threshold: .3 });
    lio.observe(svg);
    signal.addEventListener('abort', () => lio.disconnect());
    const ro = new ResizeObserver(draw);
    ro.observe(tree);
    signal.addEventListener('abort', () => ro.disconnect());

    // the detector counts up to its score
    const count = (n: HTMLElement) => {
      const label = n.querySelector<HTMLElement>('[data-label]');
      if (!label) return;
      const thing = n.dataset.thing!, score = Number(n.dataset.score);
      if (calm) { label.textContent = `${thing} ${score.toFixed(2)}`; return; }
      const t0 = performance.now() + 450;
      const tick = (t: number) => {
        const k = Math.min(1, Math.max(0, (t - t0) / 600));
        label.textContent = `${thing} ${(score * (0.4 + 0.6 * k)).toFixed(2)}`;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    nodes.forEach((n) => n.addEventListener('pointerenter', () => count(n), { signal }));
    if (!matchMedia('(hover: hover)').matches) {
      const tio = new IntersectionObserver((es) => es.forEach((en) => {
        en.target.classList.toggle('on', en.isIntersecting);
        if (en.isIntersecting) count(en.target as HTMLElement);
      }), { rootMargin: '-35% 0px -35% 0px' });
      nodes.forEach((n) => tio.observe(n));
      signal.addEventListener('abort', () => tio.disconnect());
    }

    // 4. the wall: the arrows, keys or a swipe; it moves on by itself while you look at it
    const wall = page.querySelector<HTMLElement>('[data-exhibits]')!;
    const hall = wall.querySelector<HTMLElement>('[data-hall]')!;
    const items = [...wall.querySelectorAll<HTMLElement>('.exhibit')];
    const counter = wall.querySelector<HTMLElement>('[data-count]')!;
    let ex = 0, lastTouch = 0;
    const show = () => {
      items.forEach((el, i) => { el.style.setProperty('--o', String(i - ex)); el.setAttribute('aria-hidden', String(i !== ex)); });
      counter.textContent = `${ex + 1} / ${items.length}`;
    };
    const go = (d: number, auto = false) => { if (!auto) lastTouch = Date.now(); ex = (ex + d + items.length) % items.length; show(); };
    wall.querySelector('[data-prev]')!.addEventListener('click', () => go(-1), { signal });
    wall.querySelector('[data-next]')!.addEventListener('click', () => go(1), { signal });
    wall.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') go(-1); if (e.key === 'ArrowRight') go(1); }, { signal });
    let x0: number | null = null;
    hall.addEventListener('pointerdown', (e) => { x0 = e.clientX; }, { signal });
    addEventListener('pointerup', (e) => { if (x0 === null) return; const dx = e.clientX - x0; x0 = null; if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1); }, { signal });
    let wallSeen = false;
    const wio = new IntersectionObserver((es) => es.forEach((en) => { wallSeen = en.isIntersecting; }), { threshold: .5 });
    wio.observe(wall);
    signal.addEventListener('abort', () => wio.disconnect());
    if (!calm) timers.push(window.setInterval(() => { if (wallSeen && !document.hidden && Date.now() - lastTouch > 10000) go(1, true); }, 6000));
    show();

    const onScroll = () => { onNight(); };
    onScroll();
    addEventListener('scroll', onScroll, { passive: true, signal });
  }
  document.addEventListener('astro:page-load', init);
</script>
