---
// Studio, after teenage engineering's EP-1320 Medieval page: a dark, speckled earth ground, cream
// cards with slightly rough edges, uppercase captions, a blackletter wordmark with a red initial,
// chunky dark pills, and a red scroll band between sections. Calm: nothing hops; things come into
// focus as they arrive, and a Charioteer picks up their thing when you point at them.
//   1. The wordmark, what we make, and the four aims. No figures here.
//   2. A card: what we believe, as a type collage
//   3. The Charioteers: six equal cards, in alphabetical order, nobody on top
//   4. How we work: a console, a screen and four keys you can press 
//   5. Join, and say hello
// Every line of copy is Chariot's own (withchariot.com) or the team's. Nothing here is made up.
// The paintings: public/media/people/v3 (rest and power). Prompts, and the six things drawn on their
// own for future cards: docs/character-prompts.md.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

const v3 = (slug: string, k: 'rest' | 'power') => `/media/people/v3/${slug}-${k}.webp`;

// Fill in the blank roles when the team sends them.
const people = [
  { slug: 'aakash', name: 'Aakash Rodrigues', role: 'Creative Director & Lead Designer', thing: 'laptop' },
  { slug: 'joshua', name: 'Joshua Rodrigues', role: '', thing: 'speaker' },
  { slug: 'samridhi', name: 'Samridhi Aggarwal', role: '', thing: 'visor' },
  { slug: 'tanujaa', name: 'Tanujaa Hemakumar', role: '', thing: 'case' },
  { slug: 'shreesh', name: 'Shreesh Kuliyal', role: 'UI/UX & Product Designer', thing: 'glasses' },
  { slug: 'siddharth', name: 'Siddharth Thorat', role: 'Jr. UI/UX & Product Designer', thing: 'sneakers' },
];
// Nobody stands above anyone: all the same size, in alphabetical order.
const everyone = [...people].sort((a, b) => a.name.localeCompare(b.name));

const aims = ['Distinguished', 'Effective', 'Delightful', 'Tailored'];

// how we work: four exhibits on plinths, in Chariot's own words. 
// the others are drawn here in ink (the question mark, rays in every direction, frames zooming in).
const habits = [
  { no: 'No. 1', name: 'The question', body: 'We ask the "why" to every "what".', obj: 'why' },
  { no: 'No. 2', name: 'Every direction', body: 'We explore every direction. We dig beyond the "that\'s how they\'re doing it".', obj: 'rays' },
  { no: 'No. 3', name: 'Zoom out, then in', body: 'We consider the psychology, not just the "features". We zoom out before we zoom in. We distill.', obj: 'zoom' },
  { no: 'No. 4', name: 'Test and iterate', body: 'We test and iterate. Distinguished, effective, delightful, tailored.', obj: 'loop' },
];
const rays = Array.from({ length: 12 }, (_, i) => { const a = (i / 12) * Math.PI * 2 - Math.PI / 2, r = i % 2 ? 70 : 92; return { x: 100 + Math.cos(a) * r, y: 100 + Math.sin(a) * r, i }; });
---
<Base title="Studio · Chariot" description="Chariot crafts products, brands and websites with nuance and good taste. Who we are and how we work." bare>
  <div class="museum">
    <Nav />

    <!-- 1. the wordmark; no figures here, the Charioteers are further down -->
    <header class="opener">
      <h1 class="mark rise" style="--d:.05s">Chariot<i class="sun" aria-hidden="true"></i></h1>
      <p class="line rise" style="--d:.3s">Chariot crafts products, brands and websites <br />with nuance and good taste.</p>
      <div class="aims">
        <p class="cap rise" style="--d:.45s">That's what we aim for</p>
        <ol>
          {aims.map((a, i) => (
            <li class="card tag rise" style={`--d:${0.5 + i * 0.08}s`}><span class="cap">{String(i + 1).padStart(2, '0')}</span><span class="aim">{a}</span></li>
          ))}
        </ol>
      </div>
    </header>

    <div class="band" aria-hidden="true"><div class="run">{[0, 1, 2, 3, 4, 5].map(() => aims.map((a) => <span>{a}<i></i></span>))}</div></div>

    <!-- 2. what we believe -->
    <section class="sec" aria-labelledby="h-believe">
      <div class="card sheet believe">
        <div class="intro" data-reveal>
          <h2 id="h-believe" class="cap">About us</h2>
          <p class="creed">We believe great design stems from deep insights, radical vision, clarity of the jobs to be done, a will to delight and a ton of attention to detail.</p>
        </div>
        <p class="collage" aria-label="That's why we ask the why to every what. We explore every direction. We consider the psychology, not just the features. We zoom out before we zoom in. We distill. We test and iterate.">
          <span class="row" data-reveal aria-hidden="true"><span class="s">We ask the</span> <b class="caps">why</b> <span class="s">to every</span> <span class="o caps">what.</span></span>
          <span class="row" data-reveal aria-hidden="true"><span class="s">We explore</span> <b class="caps">every</b> <span class="o s">direction.</span></span>
          <span class="row" data-reveal aria-hidden="true"><span class="s">We consider the</span> <span class="o caps">psychology,</span></span>
          <span class="row" data-reveal aria-hidden="true"><span class="s">not just the features.</span></span>
          <span class="row" data-reveal aria-hidden="true"><span class="s">We zoom</span> <b class="caps">out</b> <span class="s">before we zoom</span> <b class="caps">in.</b></span>
          <span class="row" data-reveal aria-hidden="true"><span class="o caps">We distill.</span> <span class="s">We test and iterate.</span></span>
        </p>
      </div>
    </section>

    <div class="band" aria-hidden="true"><div class="run">{[0, 1, 2, 3, 4, 5].map(() => aims.map((a) => <span>{a}<i></i></span>))}</div></div>

    <!-- 3. the Charioteers: six equal cards, each their own person, nobody on top -->
    <section class="sec team" aria-labelledby="h-team" data-team>
      <h2 id="h-team" class="gothic" data-reveal>The Charioteers</h2>
      <p class="creed-team" data-reveal>Everyone here has their own identity. Wherever you go next, you carry the taste with you: you're from Chariot.</p>
      <p class="cap hint" data-reveal>In alphabetical order. Point at a Charioteer to see them at work.</p>
      <div class="cards">
        {everyone.map((c, i) => (
          <figure class="card person" data-node data-reveal style={`--i:${i % 3}`} tabindex="0">
            <div class="pose">
              <img class="art" src={v3(c.slug, 'rest')} width="640" height="960" alt={`${c.name}, painted with their ${c.thing}`} loading="eager" decoding="async" />
              <img class="power" src={v3(c.slug, 'power')} width="640" height="960" alt="" aria-hidden="true" loading="eager" decoding="async" />
            </div>
            <figcaption>
              <span class="who"><span class="nm">{c.name}</span><span class="rl">{c.role || 'Charioteer'}</span></span>
              <span class="pill">the {c.thing}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <div class="band" aria-hidden="true"><div class="run">{[0, 1, 2, 3, 4, 5].map(() => aims.map((a) => <span>{a}<i></i></span>))}</div></div>

    <!-- 4. how we work, four exhibits on plinths -->
    <section class="sec" aria-labelledby="h-work">
      <div class="card sheet olive wall" data-exhibits tabindex="-1">
        <div class="wall-head" data-reveal>
          <h2 id="h-work" class="gothic ink">How we work</h2>
          <p class="cap">Thoroughly conceptualised, thoughtfully crafted.</p>
        </div>
        <!-- a console: a screen that shows the habit, and four keys you can press -->
        <div class="console" data-reveal>
          <div class="strip"><span><i class="led on"></i>Chariot · Method</span><span data-count>1 / {habits.length}</span></div>
          <div class="hall" data-hall>
            {habits.map((h, i) => (
              <figure class="exhibit" data-i={i} aria-hidden={i === 0 ? 'false' : 'true'}>
                <div class:list={['obj', h.obj]} aria-hidden="true">
                  {h.obj === 'why' && <span class="q">?</span>}
                  {h.obj === 'rays' && (
                    <svg viewBox="0 0 200 200">
                      {rays.map((r) => <line class="base" x1="100" y1="100" x2={r.x.toFixed(1)} y2={r.y.toFixed(1)} />)}
                      {rays.map((r) => <line x1="100" y1="100" x2={r.x.toFixed(1)} y2={r.y.toFixed(1)} pathLength="1" style={`--k:${r.i}`} />)}
                      {rays.map((r) => <circle cx={r.x.toFixed(1)} cy={r.y.toFixed(1)} r="3.2" style={`--k:${r.i}`} />)}
                      <circle class="hub" cx="100" cy="100" r="7" />
                    </svg>
                  )}
                  {h.obj === 'zoom' && (
                    <svg viewBox="0 0 200 200">
                      {[0, 1, 2, 3, 4].map((k) => <rect x="20" y="20" width="160" height="160" rx="5" style={`--k:${k}`} />)}
                      <circle class="dot" cx="100" cy="100" r="6" />
                    </svg>
                  )}
                  {h.obj === 'loop' && (
                    <svg viewBox="0 0 200 200">
                      <circle class="track" cx="100" cy="100" r="78" />
                      {[0, 1, 2, 3].map((k) => <circle class="stop" cx="100" cy="22" r="4" style={`--k:${k}`} />)}
                      <g class="turn">
                        <path d="M100 22a78 78 0 0 1 78 78" />
                        <path d="M166 86l12 14 12-14" />
                        <circle class="dot" cx="100" cy="22" r="7" />
                      </g>
                    </svg>
                  )}
                </div>
                <figcaption><span class="cap no">{h.no}</span><b>{h.name}</b><span class="say">{h.body}</span></figcaption>
              </figure>
            ))}
          </div>
          <div class="pads" role="group" aria-label="The four habits">
            {habits.map((h, i) => (
              <button type="button" class="pad" data-pad={i} aria-pressed={i === 0 ? 'true' : 'false'} data-tick>
                <span class="top"><span class="n">{String(i + 1).padStart(2, '0')}</span><i class="led"></i></span>
                <span class="nm2">{h.name}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="band" aria-hidden="true"><div class="run">{[0, 1, 2, 3, 4, 5].map(() => aims.map((a) => <span>{a}<i></i></span>))}</div></div>

    <!-- 5. join, and hello -->
    <section class="sec join" aria-labelledby="h-join">
      <h2 id="h-join" class="gothic" data-reveal>Join the Charioteers</h2>
      <ul class="rows">
        <li class="card row-card" data-reveal><a href="mailto:hello@withchariot.com?subject=Joining%20Chariot"><span class="cap big">Designers who sweat the details</span><span class="pill">write to us</span></a></li>
        <li class="card row-card" data-reveal style="--i:1"><a href="mailto:hello@withchariot.com"><span class="cap big">Every project starts with a question. Ask us yours</span><span class="pill">ask!</span></a></li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .museum { --earth: #11110A; --card: #F2F1EC; --olive: #FF8D25; --ink: #11110A; --soft: #5F5D55; --cream: #F2F1EC; --rubric: #E0661B; --gold: #F2F1EC;
    --gothic: var(--serif);
    --ease: cubic-bezier(.2, .8, .2, 1);
    background-color: var(--earth); color: var(--cream);
    display: grid; overflow-x: clip; min-height: 100svh; }
  :global(html:has(.museum)), :global(body:has(.museum)) { background: #11110A; color-scheme: dark; }
  .museum :global(.nav) { --nav-ink: #F2F1EC; }

  /* type */
  .cap { margin: 0; font: 500 13px/1.35 var(--sans); letter-spacing: .07em; text-transform: uppercase; }
  .gothic { margin: 0; font: 600 clamp(44px, 6vw, 96px)/.95 var(--serif); letter-spacing: -.035em; text-align: center; color: var(--cream); }
  .gothic.ink { color: var(--ink); }

  /* the cards: cream, with a slightly rough edge drawn underneath so the text stays sharp */
  .card { position: relative; isolation: isolate; color: var(--ink); }
  .card::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--card);
    border-radius: clamp(20px, 2.2vw, 32px); }
  .card.olive::before { background: var(--olive); }

  /* the dark pills, after EP-1320's "add to bag" */
  .pill { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; background: var(--ink); color: var(--cream);
    font: 500 12px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
  .pill::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #FF8D25; }

  /* between sections: the four aims run past on Chariot's orange, slowly */
  .band { margin: clamp(56px, 9vh, 100px) 0; background: #FF8D25; color: var(--ink); overflow: hidden; padding: 12px 0 14px; }
  .run { display: flex; width: max-content; animation: run 60s linear infinite; }
  .run span { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font: 600 clamp(22px, 2.2vw, 34px)/1 var(--serif); letter-spacing: -.02em; white-space: nowrap; }
  .run i { width: 10px; height: 10px; border-radius: 50%; background: var(--ink); }
  @keyframes run { to { translate: -50% 0; } }

  .sec { width: min(1360px, 100% - 2 * clamp(16px, 3vw, 40px)); margin: 0 auto; }
  .sheet { padding: clamp(40px, 8vh, 96px) clamp(20px, 5vw, 80px); }

  /* everything comes into focus out of a soft blur */
  .rise { animation: focus-in 1.1s var(--ease) var(--d, 0s) both; }
  @keyframes focus-in { from { opacity: 0; filter: blur(14px); translate: 0 24px; } }
  :global(html.js) [data-reveal] { opacity: 0; filter: blur(12px); translate: 0 28px; transition: opacity .9s var(--ease), filter .9s var(--ease), translate .9s var(--ease); transition-delay: calc(var(--i, 0) * 90ms); }
  :global(html.js) [data-reveal].in { opacity: 1; filter: none; translate: 0 0; }

  /* ---- 1. the wordmark ---- */
  .opener { min-height: calc(100svh - 34px - 9vh); display: grid; align-content: center; justify-items: center; gap: clamp(20px, 3.4vh, 40px); padding: 110px clamp(16px, 3vw, 40px) 0; text-align: center; }
  .mark { margin: 0; display: inline-flex; align-items: baseline; gap: .06em; font: 600 clamp(88px, 18vw, 290px)/.86 var(--serif); color: var(--cream); letter-spacing: -.05em; }
  /* the sun from the Chariot mark */
  .mark .sun { width: .2em; height: .2em; border-radius: 50%; background: #FF8D25; }
  .line { margin: 0; font: 300 clamp(18px, 1.7vw, 26px)/1.4 var(--sans); color: #B2B0A9; }
  .aims { display: grid; justify-items: center; gap: 16px; margin-top: 2vh; }
  .aims > .cap { color: rgb(236 229 213 / .55); }
  .aims ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 22px); }
  .tag { display: grid; gap: 10px; justify-items: center; padding: 18px clamp(14px, 2vw, 30px) 20px; }
  .tag .cap { font-size: 11px; color: var(--rubric); }
  .aim { font: 600 clamp(24px, 2.5vw, 38px)/1 var(--serif); letter-spacing: -.02em; }

  /* ---- 2. what we believe ---- */
  .believe { display: grid; gap: 7vh; }
  .intro { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 32px; align-items: start; }
  .intro .cap { color: var(--rubric); padding-top: .4em; }
  .creed { margin: 0; font: 600 clamp(22px, 2.1vw, 32px)/1.2 var(--serif); letter-spacing: -.02em; max-width: 32ch; }
  .collage { margin: 0; display: grid; justify-items: center; gap: .1em; text-align: center; font-size: clamp(30px, 5vw, 80px); line-height: .95; }
  .row { display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .22em; }
  .s { font-family: var(--serif); font-weight: 600; letter-spacing: -.03em; }
  .caps { font: 500 .94em/1 var(--sans); letter-spacing: -.04em; text-transform: uppercase; }
  .o { color: var(--rubric); }

  /* ---- 3. the Charioteers ---- */
  .team { display: grid; justify-items: center; gap: 16px; }
  .creed-team { margin: 8px 0 0; max-width: 34ch; text-align: center; text-wrap: balance; font: 300 clamp(18px, 1.6vw, 24px)/1.4 var(--sans); color: #B2B0A9; }
  .hint { color: rgb(236 229 213 / .55); font-size: 11px; margin-bottom: 4vh; }
  .cards { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 2vw, 28px); }
  .person { margin: 0; display: grid; grid-template-rows: auto auto; padding: clamp(24px, 3vw, 44px) clamp(18px, 2.4vw, 34px) clamp(18px, 2.4vw, 30px); outline: none; }
  .pose { position: relative; width: min(64%, 260px); justify-self: center; }
  .art, .power { display: block; width: 100%; height: auto; filter: drop-shadow(0 3px 2px rgb(30 22 17 / .2)); transition: opacity .5s ease; }
  .power { position: absolute; inset: 0; height: 100%; opacity: 0; }
  .person:hover .power, .person.on .power, .person:focus-visible .power { opacity: 1; }
  .person:hover .art, .person.on .art, .person:focus-visible .art { opacity: 0; }
  .person figcaption { margin-top: 22px; display: flex; align-items: end; justify-content: space-between; gap: 12px; }
  .who { display: grid; gap: 4px; }
  .nm { font: 600 clamp(18px, 1.5vw, 23px)/1.15 var(--serif); letter-spacing: -.01em; }
  .rl { font: 400 14px/1.3 var(--sans); color: var(--soft); }

  /* ---- 4. how we work ---- */
  .wall { display: grid; gap: 3vh; outline: none; overflow: hidden; }
  .wall-head { display: grid; justify-items: center; gap: 14px; text-align: center; }
  .wall-head .cap { color: var(--soft); }
  /* the console: an ink body with a little depth, a dark screen set into it, and four real keys */
  .console { width: min(1040px, 100%); justify-self: center; display: grid; gap: clamp(12px, 1.6vw, 20px); padding: clamp(14px, 1.8vw, 24px);
    border-radius: clamp(22px, 2.4vw, 34px); background: linear-gradient(#24241C, #14140D 30%, #0D0D08);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .16), inset 0 -3px 0 rgb(0 0 0 / .6), 0 2px 0 #000, 0 30px 50px -18px rgb(17 17 10 / .65), 0 60px 80px -40px rgb(17 17 10 / .5); }
  .strip { display: flex; justify-content: space-between; align-items: center; padding: 2px 8px 0; color: rgb(242 241 236 / .6); font: 500 11px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .strip span { display: inline-flex; align-items: center; gap: 8px; }
  .led { width: 7px; height: 7px; border-radius: 50%; background: #3A382F; box-shadow: inset 0 1px 1px rgb(0 0 0 / .6); transition: background .15s, box-shadow .15s; }
  .led.on, .pad[aria-pressed="true"] .led { background: #FF8D25; box-shadow: 0 0 0 1px rgb(0 0 0 / .4), 0 0 10px 2px rgb(255 141 37 / .7); }
  /* the screen */
  .hall { --ink: #F2F1EC; position: relative; height: clamp(300px, 42vh, 400px); border-radius: clamp(12px, 1.4vw, 20px); overflow: hidden; color: var(--cream);
    background: radial-gradient(120% 90% at 30% 0%, #1B1B13, #090905 70%);
    box-shadow: inset 0 2px 10px #000, inset 0 0 0 1px rgb(0 0 0 / .8), 0 1px 0 rgb(255 255 255 / .1); touch-action: pan-y; user-select: none; }
  /* a faint grid of dots, like a display */
  .hall::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(rgb(242 241 236 / .07) 1px, transparent 1.2px) 0 0 / 9px 9px;
    -webkit-mask: linear-gradient(90deg, #000, transparent 60%); mask: linear-gradient(90deg, #000, transparent 60%); }
  .exhibit { position: absolute; inset: 0; margin: 0; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); align-items: center; gap: clamp(16px, 3vw, 48px);
    padding: clamp(20px, 3vw, 44px); opacity: 0; translate: 0 10px; transition: opacity .45s, translate .6s var(--ease); }
  .exhibit[aria-hidden="false"] { opacity: 1; translate: 0 0; }
  .obj { height: clamp(150px, 26vh, 250px); display: grid; place-items: center; }
  .obj svg { height: clamp(150px, 26vh, 250px); width: auto; max-width: 100%; overflow: visible; }
  .obj > img { max-width: 100%; max-height: 100%; width: auto; height: auto; filter: invert(1) brightness(1.6); }
  /* 1. the question mark turns slowly, like a sculpture */
  .q { font: 600 clamp(150px, 26vh, 250px)/.8 var(--serif); color: var(--ink); animation: turnY 9s ease-in-out infinite; }
  @keyframes turnY { 0%, 100% { transform: perspective(700px) rotateY(-28deg); } 50% { transform: perspective(700px) rotateY(28deg); } }
  /* 2. every direction: rays draw out one after another, then fade together, and again */
  .rays line { stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: ray 6s var(--ease) infinite; animation-delay: calc(var(--k) * .12s - .6s); }
  .rays circle { fill: var(--ink); opacity: 0; animation: tip 6s var(--ease) infinite; animation-delay: calc(var(--k) * .12s - .6s); }
  .rays .hub { opacity: 1; animation: none; fill: #FF8D25; }
  .rays .base { stroke: rgb(242 241 236 / .16); stroke-width: 1.5; stroke-dasharray: none; stroke-dashoffset: 0; animation: none; }
  @keyframes ray { 0% { stroke-dashoffset: 1; opacity: 1; } 22%, 70% { stroke-dashoffset: 0; opacity: 1; } 90%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes tip { 0%, 14% { opacity: 0; } 24%, 70% { opacity: 1; } 90%, 100% { opacity: 0; } }
  /* 3. zoom out, then in: frames come out of the centre and grow */
  .zoom rect { fill: none; stroke: var(--ink); stroke-width: 2; transform-origin: 100px 100px; transform-box: view-box; animation: frame 8s linear infinite; animation-delay: calc(var(--k) * -1.6s); }
  .zoom .dot { fill: #FF8D25; }
  @keyframes frame { 0% { transform: scale(.04); opacity: 0; } 15% { opacity: 1; } 60% { opacity: 1; } 100% { transform: scale(1); opacity: 0; } }
  /* 4. test and iterate: round the loop, past each check, and round again */
  .loop .track { fill: none; stroke: rgb(242 241 236 / .18); stroke-width: 1.5; }
  .loop .stop { fill: #090905; stroke: var(--ink); stroke-width: 1.5; transform-origin: 100px 100px; transform-box: view-box; transform: rotate(calc(var(--k) * 90deg)); }
  .loop .turn { transform-origin: 100px 100px; transform-box: view-box; animation: turn 8s cubic-bezier(.6, 0, .4, 1) infinite; }
  .loop .turn path { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .loop .dot { fill: #FF8D25; }
  @keyframes turn { 0% { transform: rotate(0); } 25% { transform: rotate(90deg); } 50% { transform: rotate(180deg); } 75% { transform: rotate(270deg); } 100% { transform: rotate(360deg); } }
  /* only the habit on screen moves */
  .exhibit[aria-hidden="true"] * { animation-play-state: paused !important; }
  .exhibit figcaption { display: grid; gap: 12px; align-content: center; }
  .exhibit .no { color: #FF8D25; font-size: 11px; }
  .exhibit b { font: 600 clamp(30px, 3.6vw, 56px)/1 var(--serif); letter-spacing: -.03em; }
  .say { max-width: 30ch; font: 300 clamp(16px, 1.3vw, 20px)/1.45 var(--sans); color: #B2B0A9; }

  /* the keys: cream caps with real depth, sitting in a well. They go down when pressed, and the one in play stays down, lit */
  .pads { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(8px, 1vw, 14px); padding: clamp(10px, 1.2vw, 16px) clamp(10px, 1.2vw, 16px) calc(clamp(10px, 1.2vw, 16px) + 7px);
    border-radius: clamp(14px, 1.6vw, 22px); background: #060603; box-shadow: inset 0 3px 8px #000, 0 1px 0 rgb(255 255 255 / .08); }
  .pad { position: relative; display: grid; gap: clamp(18px, 3.4vh, 36px); padding: 12px 14px 14px; border: 0; border-radius: 12px; cursor: pointer; text-align: left; color: #11110A;
    background: linear-gradient(#FDFCF8, #E9E7DF 55%, #DDDBD2);
    box-shadow: inset 0 1px 0 #fff, inset 0 -1px 0 rgb(0 0 0 / .12), 0 7px 0 #A9A69A, 0 8px 0 1px #000, 0 16px 16px rgb(0 0 0 / .55);
    transition: translate .09s, box-shadow .09s, background .2s; -webkit-tap-highlight-color: transparent; }
  .pad:hover { background: linear-gradient(#fff, #F1EFE8 55%, #E4E2D9); }
  .pad:active, .pad[aria-pressed="true"] { translate: 0 5px;
    box-shadow: inset 0 1px 0 #fff, inset 0 -1px 0 rgb(0 0 0 / .12), 0 2px 0 #A9A69A, 0 3px 0 1px #000, 0 6px 8px rgb(0 0 0 / .5); }
  .pad:active { translate: 0 6px; }
  .pad:focus-visible { outline: 2px solid #FF8D25; outline-offset: 3px; }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .n { font: 500 11px/1 var(--sans); letter-spacing: .12em; color: #5F5D55; }
  .nm2 { font: 600 clamp(15px, 1.5vw, 22px)/1.05 var(--serif); letter-spacing: -.02em; }

  /* ---- 5. join ---- */
  .join { display: grid; gap: 4vh; padding-bottom: clamp(60px, 12vh, 140px); }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .row-card a { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 26px clamp(20px, 3vw, 40px); color: var(--ink); text-decoration: none; }
  .cap.big { font: 600 clamp(20px, 2.4vw, 36px)/1.1 var(--serif); letter-spacing: -.02em; text-transform: none; }
  .row-card .pill { transition: translate .2s var(--ease); }
  .row-card a:hover .pill { translate: 0 -2px; }
  .row-card a:focus-visible { outline: 2px dashed var(--cream); outline-offset: 6px; border-radius: 40px; }

  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .aims ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .intro { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .exhibit { grid-template-columns: minmax(0, 1fr); align-content: center; gap: 14px; }
    .obj, .q { height: 150px; font-size: 150px; }
    .obj { place-items: center start; }
    .hall { height: 400px; }
    .pads { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 16px; }
    .pad { gap: 16px; }
    .line br { display: none; }
    .line { max-width: 30ch; }
    .cards { gap: 12px; }
    .pose { width: 78%; }
    .person { padding: 22px 14px 16px; }
    .person figcaption { flex-direction: column; align-items: start; }
    .nm { font-size: 12px; }
    .rl { font-size: 13px; }
    .row-card a { flex-direction: column; align-items: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .museum *, .museum *::before, .museum *::after { animation: none !important; transition-duration: .01ms !important; }
    :global(html.js) [data-reveal], .rise { opacity: 1; filter: none; translate: none; }
  }
</style>

<script>
  // Sections come into focus as they scroll in. Each Charioteer picks up their thing when you point at
  // them (on a phone, as they scroll through the middle). How we work moves on by itself while in view.
  let stop: AbortController | null = null;
  function init() {
    stop?.abort();
    const page = document.querySelector<HTMLElement>('.museum');
    if (!page) return;
    stop = new AbortController();
    const { signal } = stop;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const timers: number[] = [];
    signal.addEventListener('abort', () => timers.forEach((t) => clearInterval(t)));

    // reveals
    const io = new IntersectionObserver((es) => es.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }), { rootMargin: '0px 0px -12% 0px' });
    page.querySelectorAll('[data-reveal]').forEach((n) => io.observe(n));
    signal.addEventListener('abort', () => io.disconnect());

    // 3. the Charioteers, on touch screens
    const nodes = [...page.querySelectorAll<HTMLElement>('[data-node]')];
    if (!matchMedia('(hover: hover)').matches) {
      const tio = new IntersectionObserver((es) => es.forEach((en) => en.target.classList.toggle('on', en.isIntersecting)), { rootMargin: '-35% 0px -35% 0px' });
      nodes.forEach((n) => tio.observe(n));
      signal.addEventListener('abort', () => tio.disconnect());
    }

    // 4. the wall: the arrows, keys or a swipe; it moves on by itself while you look at it
    const wall = page.querySelector<HTMLElement>('[data-exhibits]')!;
    const hall = wall.querySelector<HTMLElement>('[data-hall]')!;
    const items = [...wall.querySelectorAll<HTMLElement>('.exhibit')];
    const counter = wall.querySelector<HTMLElement>('[data-count]')!;
    let ex = 0, lastTouch = 0;
    const pads = [...wall.querySelectorAll<HTMLElement>('[data-pad]')];
    const show = () => {
      items.forEach((el, i) => el.setAttribute('aria-hidden', String(i !== ex)));
      pads.forEach((el, i) => el.setAttribute('aria-pressed', String(i === ex)));
      counter.textContent = `${ex + 1} / ${items.length}`;
    };
    const go = (d: number, auto = false) => { if (!auto) lastTouch = Date.now(); ex = (ex + d + items.length) % items.length; show(); };
    pads.forEach((el, i) => el.addEventListener('click', () => { lastTouch = Date.now(); ex = i; show(); }, { signal }));
    wall.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') go(-1); if (e.key === 'ArrowRight') go(1); }, { signal });
    let x0: number | null = null;
    hall.addEventListener('pointerdown', (e) => { x0 = e.clientX; }, { signal });
    addEventListener('pointerup', (e) => { if (x0 === null) return; const dx = e.clientX - x0; x0 = null; if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1); }, { signal });
    let wallSeen = false;
    const wio = new IntersectionObserver((es) => es.forEach((en) => { wallSeen = en.isIntersecting; }), { threshold: .5 });
    wio.observe(wall);
    signal.addEventListener('abort', () => wio.disconnect());
    if (!calm) timers.push(window.setInterval(() => { if (wallSeen && !document.hidden && Date.now() - lastTouch > 10000) go(1, true); }, 6000));
    show();
  }
  document.addEventListener('astro:page-load', init);
</script>
