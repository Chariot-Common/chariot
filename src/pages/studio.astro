---
// Studio, as a small museum of Chariot: old craft, new tools.
// After the references: Gem Quest (the "WE( )ARE" opener, the team as a tree of lines), the
// Staatliche Museen zu Berlin (type collage with pictures set into the words, a collection on
// pedestals against an orange wall), the old masters with a MacBook (AI detection boxes over a
// painting), mew.xyz (cut-out characters that act in front of the type), dmcg.co (everything
// comes into focus out of a soft blur).
//   1. Night: CHARI( )OT. A Charioteer jumps into the brackets; the rest stand in a row below
//   2. Paper: what we believe, as a type collage with the engravings printed into the words
//   3. Paper: the Charioteers as a tree; point at one and the machine finds their thing
//   4. Orange: how we work, four engravings on plinths
//   5. Paper: join, and say hello
// Every line of copy is Chariot's own, from withchariot.com. Nothing here is made up.
//
// Images: the paintings are cut out of their parchment (public/media/people/cut, with a paper
// edge left round each figure) and the engravings are ink only, on transparency
// (public/media/wheel/ink), so they print onto any colour.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

const cut = (img: string) => `/media/people/cut/${img}`;
const ink = (img: string) => `/media/wheel/ink/${img}`;

// The crew. Fill in the blanks (name, role) and drop a real photo at
// public/media/people/photos/<slug>.jpg, then set photo: true. box is where their one thing sits
// in the cut-out (x, y, w, h in %), for the detection box. idle is how they move at rest.
const head = { slug: 'aakash', img: 'aakash-armour.webp', w: 665, h: 1000, name: 'Aakash Rodrigues', role: 'Creative Director & Lead Designer', thing: 'laptop', score: '0.97', box: [1, 10, 29, 15], idle: 'sway', photo: false };
const crew = [
  { slug: 'joshua', img: 'joshua-speaker.webp', w: 691, h: 1000, name: 'Joshua Rodrigues', role: '', thing: 'speaker', score: '0.98', box: [0, 23, 18, 20], idle: 'bob', photo: false },
  { slug: 'samridhi', img: 'samridhi-visor.webp', w: 720, h: 951, name: 'Samridhi Aggarwal', role: '', thing: 'visor', score: '0.96', box: [7, 0, 25, 13], idle: 'lean', photo: false },
  { slug: 'backpack', img: 'backpack.webp', w: 705, h: 1000, name: '', role: '', thing: 'backpack', score: '0.95', box: [60, 1, 34, 44], idle: 'hop', photo: false },
  { slug: 'glasses', img: 'glasses.webp', w: 676, h: 1000, name: '', role: '', thing: 'glasses', score: '0.94', box: [32, 8, 21, 7], idle: 'hop', photo: false },
  { slug: 'handstand', img: 'handstand.webp', w: 720, h: 968, name: '', role: '', thing: 'sneakers', score: '0.93', box: [0, 1, 15, 16], idle: 'wobble', photo: false },
];
const everyone = [head, ...crew];

const exhibits = [
  { src: ink('wheel-hub.webp'), no: 'No. 1', name: 'The hub', line: 'The question', body: 'We ask the "why" to every "what".', move: 'spin' },
  { src: ink('wheel-34.webp'), no: 'No. 2', name: 'The spokes', line: 'Every direction', body: 'We explore every direction, and dig beyond "that\'s how they\'re doing it".', move: 'rock' },
  { src: ink('wheel-edge.webp'), no: 'No. 3', name: 'The rim', line: 'The psychology, not just the features', body: 'We zoom out before we zoom in. We distill.', move: 'turn' },
  { src: ink('chariot.webp'), no: 'No. 4', name: 'The chariot', line: 'Shipped', body: 'We test and iterate. Distinguished, effective, delightful, tailored.', move: 'roll' },
];
---
<Base title="Studio · Chariot" description="Chariot crafts products, brands and websites with nuance and good taste. Who we are and how we work." bare>
  <div class="museum">
    <Nav />

    <!-- 1. night -->
    <header class="opener" data-night>
      <span class="corner tl rise" style="--d:.5s">Products</span><span class="corner tr rise" style="--d:.55s">Brands</span>
      <span class="corner bl rise" style="--d:.6s">Websites</span><span class="corner br rise" style="--d:.65s">&amp; the Charioteers</span>
      <div class="stage">
        <h1 class="title" aria-label="Chariot crafts products, brands and websites with nuance and good taste.">
          <span class="rise" style="--d:.05s" aria-hidden="true">Chari(</span>
          <span class="gap" aria-hidden="true" data-gap>
            {everyone.map((p, i) => <img src={cut(p.img)} alt="" width={p.w} height={p.h} class:list={{ on: i === 0 }} decoding="async" />)}
          </span>
          <span class="rise" style="--d:.15s" aria-hidden="true">)ot</span>
        </h1>
        <p class="line rise" style="--d:.35s">Chariot crafts products, brands and websites<br />with nuance and good taste.</p>
      </div>
      <ol class="parade" aria-label="The Charioteers">
        {everyone.map((p, i) => (
          <li class="rise" style={`--d:${0.45 + i * 0.07}s`}>
            <button type="button" data-pick={i} class:list={{ on: i === 0 }} aria-label={p.name || 'A Charioteer'}>
              <span class:list={['walk', p.idle]} style={`--k:${i}`}><img src={cut(p.img)} alt="" width={p.w} height={p.h} loading="eager" /></span>
              <span class="fig">Fig. {i + 1}</span>
              <span class="cap">{p.name || 'A Charioteer'}</span>
            </button>
          </li>
        ))}
      </ol>
    </header>

    <!-- 2. paper: what we believe -->
    <section class="paper believe" aria-labelledby="h-believe">
      <div class="intro" data-reveal>
        <h2 id="h-believe" class="label-h">About us</h2>
        <p class="small">Chariot crafts products, brands and websites with nuance and good taste.</p>
        <p class="creed">We believe great design stems from deep insights, radical vision, clarity of the jobs to be done, a will to delight and a ton of attention to detail.</p>
      </div>
      <p class="collage" aria-label="That's why we ask the why to every what. We explore every direction. We consider the psychology, not just the features. We zoom out before we zoom in. We distill. We test and iterate.">
        <span class="row" data-reveal aria-hidden="true"><span class="s">We ask the</span> <b class="caps">why</b> <img class="pic spin" src={ink('wheel-hub.webp')} alt="" /> <span class="s">to every</span> <span class="o caps">what.</span></span>
        <span class="row" data-reveal aria-hidden="true"><span class="s">We explore</span> <b class="caps">every</b> <img class="pic roll-in" src={ink('wheel-front.webp')} alt="" /> <span class="o s">direction.</span></span>
        <span class="row" data-reveal aria-hidden="true"><span class="s">We consider the</span> <span class="o caps">psychology,</span></span>
        <span class="row" data-reveal aria-hidden="true"><span class="s">not just the features.</span> <img class="pic guy hop" src={cut('glasses.webp')} alt="" /></span>
        <span class="row zoom" data-reveal data-zoom aria-hidden="true"><span class="s">We zoom</span> <b class="caps">out</b> <span class="track"><img class="pic cart" src={ink('chariot.webp')} alt="" /></span> <span class="s">before we zoom</span> <b class="caps">in.</b></span>
        <span class="row" data-reveal aria-hidden="true"><span class="o caps">We distill.</span> <span class="s">We test and iterate.</span> <img class="pic guy run" src={cut('backpack.webp')} alt="" /></span>
      </p>
    </section>

    <!-- 3. paper: the Charioteers, as a tree -->
    <section class="paper tree" aria-labelledby="h-team" data-tree>
      <h2 id="h-team" class="tree-h" data-reveal><span class="dots" aria-hidden="true">· · · ·</span>The Charioteers</h2>
      <p class="hint" data-reveal>Point at a Charioteer. The machine will tell you what they carry.</p>
      <div class="family">
        <svg class="lines" aria-hidden="true" data-lines></svg>
        {everyone.map((c, i) => (
          <figure class:list={['node', { top: i === 0 }]} data-node data-reveal style={`--i:${i}`} data-thing={c.thing} data-score={c.score}>
            <div class="pose-wrap">
              <div class:list={['pose', c.idle]} style={`--k:${i}`}>
                <img class="art" src={cut(c.img)} width={c.w} height={c.h} alt={c.name ? `${c.name}, painted with their ${c.thing}` : `A Charioteer, painted with their ${c.thing}`} loading="lazy" />
                {c.photo && <img class="real" src={`/media/people/photos/${c.slug}.jpg`} alt="" loading="lazy" />}
                <span class="scan" style={`--m:url(${cut(c.img)})`} aria-hidden="true"></span>
                <span class="pbox" aria-hidden="true"><i>person 0.99</i></span>
                <span class="box" style={`--x:${c.box[0]}%;--y:${c.box[1]}%;--w:${c.box[2]}%;--h:${c.box[3]}%`} aria-hidden="true"><i data-label>{c.thing} {c.score}</i></span>
              </div>
              <span class="floor" aria-hidden="true"></span>
            </div>
            <figcaption><span class="mono">{c.name || 'Name to come'}</span><span class="role">{c.role || 'Charioteer'}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 4. orange: how we work, on plinths -->
    <section class="wall" aria-labelledby="h-work" data-exhibits tabindex="-1">
      <div class="wall-head" data-reveal>
        <h2 id="h-work" class="label-h">How we work</h2>
        <p class="small">Thoroughly conceptualised, thoughtfully crafted. Four parts of the wheel, four habits.</p>
      </div>
      <div class="hall" data-hall>
        {exhibits.map((e, i) => (
          <figure class="exhibit" data-i={i} style={`--o:${i}`} aria-hidden={i === 0 ? 'false' : 'true'}>
            <div class="obj"><img class={e.move} src={e.src} alt={e.name} loading="lazy" draggable="false" /></div>
            <div class="plinth" aria-hidden="true"><span class="lid"></span><span class="body"><span class="plate">{e.no}</span></span></div>
            <figcaption><b>{e.name}: {e.line}</b><span>{e.body}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="nav-ex">
        <button type="button" data-prev aria-label="Previous exhibit">←</button>
        <span data-count>1 / {exhibits.length}</span>
        <button type="button" data-next aria-label="Next exhibit">→</button>
      </div>
    </section>

    <!-- 5. paper: join, and hello -->
    <section class="paper join" aria-labelledby="h-join">
      <h2 id="h-join" class="tree-h" data-reveal><span class="dots" aria-hidden="true">· · · ·</span>Join the Charioteers</h2>
      <ul class="rows" data-reveal>
        <li><a href="mailto:hello@withchariot.com?subject=Joining%20Chariot"><span class="who"><img src={cut('backpack.webp')} alt="" /></span><span class="mono">Designers who sweat the details</span><span class="arrow" aria-hidden="true">↗</span></a></li>
        <li><a href="mailto:hello@withchariot.com"><span class="who"><img src={cut('handstand.webp')} alt="" /></span><span class="mono">Every project starts with a question. Ask us yours</span><span class="arrow" aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .museum { --paper: #EEF0EC; --ink: #16130F; --soft: #6B6B66; --night: #121110; --cream: #F3EADB; --orange: #F0582E; --line: rgb(22 19 15 / .22);
    --mono: ui-monospace, "SFMono-Regular", Menlo, monospace; --ease: cubic-bezier(.2, .8, .2, 1); --spring: cubic-bezier(.3, 1.5, .4, 1);
    background: #FFFFFF; color: var(--ink); padding: 10px; display: grid; gap: 10px; overflow-x: clip; }
  :global(html:has(.museum)), :global(body:has(.museum)) { background: #FFFFFF; color-scheme: light; }
  .museum :global(.nav) { --nav-ink: #16130F; }
  .museum.over-night :global(.nav) { --nav-ink: #F3EADB; }
  .mono { font: 400 13px/1.3 var(--mono); }
  .label-h { margin: 0; font: 400 18px/1 var(--serif); }
  .small { margin: 0; font: 400 12px/1.5 var(--mono); color: var(--soft); max-width: 34ch; }

  /* everything comes into focus out of a soft blur (after dmcg) */
  .rise { animation: focus-in 1.1s var(--ease) var(--d, 0s) both; }
  @keyframes focus-in { from { opacity: 0; filter: blur(14px); translate: 0 24px; } }
  :global(html.js) [data-reveal] { opacity: 0; filter: blur(12px); translate: 0 28px; transition: opacity .9s var(--ease), filter .9s var(--ease), translate .9s var(--ease); transition-delay: calc(var(--i, 0) * 90ms); }
  :global(html.js) [data-reveal].in { opacity: 1; filter: none; translate: 0 0; }

  /* idle motion: each Charioteer moves in their own way */
  .sway { animation: sway 4.2s ease-in-out calc(var(--k, 0) * -.7s) infinite; transform-origin: 50% 100%; }
  .lean { animation: sway 6s ease-in-out calc(var(--k, 0) * -.7s) infinite; transform-origin: 60% 100%; }
  .bob { animation: bob 2.6s ease-in-out calc(var(--k, 0) * -.4s) infinite; }
  .hop { animation: hop 2.2s var(--ease) calc(var(--k, 0) * -.5s) infinite; transform-origin: 50% 100%; }
  .wobble { animation: wobble 3s ease-in-out calc(var(--k, 0) * -.3s) infinite; transform-origin: 50% 0; }
  @keyframes sway { 0%, 100% { rotate: -2deg; } 50% { rotate: 2deg; } }
  @keyframes bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -3%; } }
  @keyframes hop { 0%, 55%, 100% { translate: 0 0; scale: 1 1; } 10% { scale: 1.04 .95; } 28% { translate: 0 -9%; scale: .97 1.04; } 45% { translate: 0 0; scale: 1.03 .97; } }
  @keyframes wobble { 0%, 100% { rotate: -3deg; } 50% { rotate: 3deg; } }

  /* ---- 1. the opener ---- */
  .opener { position: relative; border-radius: 22px; overflow: hidden; background: var(--night); color: var(--cream);
    min-height: calc(100svh - 20px); display: grid; grid-template-rows: 1fr auto; padding: 90px clamp(16px, 2.4vw, 32px) 22px; }
  .opener::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background: radial-gradient(60% 50% at 50% 42%, rgb(243 234 219 / .08), transparent 70%); }
  .corner { position: absolute; font: 400 12px/1 var(--mono); color: rgb(243 234 219 / .45); }
  .tl { left: clamp(16px, 2.4vw, 32px); top: 90px; } .tr { right: clamp(16px, 2.4vw, 32px); top: 90px; }
  .bl { left: clamp(16px, 2.4vw, 32px); top: 46%; } .br { right: clamp(16px, 2.4vw, 32px); top: 46%; }
  .stage { align-self: center; display: grid; justify-items: center; gap: clamp(18px, 3vh, 34px); }
  .title { margin: 0; display: flex; align-items: flex-end; font: 400 clamp(64px, 14vw, 250px)/.85 var(--serif); letter-spacing: -.03em; white-space: nowrap; }
  /* the brackets hold one Charioteer at a time; they stand taller than the letters, as on mew */
  .gap { position: relative; display: block; width: 1.12em; height: .78em; margin: 0 .02em; }
  .gap img { position: absolute; left: 50%; bottom: .01em; height: 1.32em; width: auto; max-width: none; translate: -50% -60%; rotate: -14deg; scale: .7; opacity: 0;
    filter: drop-shadow(0 .05em .06em rgb(0 0 0 / .45)); transition: translate .55s var(--spring), rotate .55s var(--spring), scale .55s var(--spring), opacity .2s; pointer-events: none; }
  .gap img.on { translate: -50% 0; rotate: 0deg; scale: 1; opacity: 1; }
  .gap img.off { translate: -50% 40%; rotate: 10deg; scale: .85; opacity: 0; transition-duration: .35s; transition-timing-function: ease-in; }
  .line { margin: 0; font: 400 12px/1.5 var(--mono); text-align: center; color: rgb(243 234 219 / .7); }
  .parade { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(8px, 2vw, 28px); align-items: end; }
  .parade button { all: unset; cursor: pointer; display: grid; justify-items: center; gap: 6px; width: 100%; }
  .parade button:focus-visible { outline: 1px dashed var(--cream); outline-offset: 6px; }
  .walk { display: block; height: clamp(90px, 17vh, 170px); }
  .walk img { height: 100%; width: auto; filter: drop-shadow(0 6px 8px rgb(0 0 0 / .45)) saturate(.9); transition: filter .3s, translate .4s var(--spring); }
  .parade button:hover .walk img, .parade button.on .walk img { filter: drop-shadow(0 10px 12px rgb(0 0 0 / .5)) saturate(1.1); translate: 0 -8px; }
  .fig, .cap { font: 400 10px/1 var(--mono); color: rgb(243 234 219 / .45); transition: color .3s; }
  .parade button.on .cap, .parade button:hover .cap { color: var(--cream); }
  .parade button.on .fig { color: var(--orange); }

  /* ---- paper ---- */
  .paper { border-radius: 22px; background: var(--paper); padding: clamp(40px, 9vh, 110px) clamp(16px, 4vw, 64px); }

  /* ---- 2. what we believe ---- */
  .believe { display: grid; gap: 9vh; }
  .intro { display: grid; grid-template-columns: 200px minmax(0, 34ch) minmax(0, 1fr); gap: 32px; align-items: start; }
  .creed { margin: 0; font: 400 clamp(20px, 1.8vw, 28px)/1.15 var(--serif); max-width: 26ch; }
  .collage { margin: 0; display: grid; justify-items: center; gap: .1em; text-align: center; font-size: clamp(30px, 5vw, 84px); line-height: .95; }
  .row { display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .22em; }
  .s { font-family: var(--serif); font-weight: 400; letter-spacing: -.03em; }
  .caps { font: 800 1em/1 var(--sans); letter-spacing: -.04em; text-transform: uppercase; }
  .o { color: var(--orange); }
  /* engravings print into the words; figures step out of the line */
  .pic { height: .9em; width: auto; transition: scale .8s var(--spring) .25s, opacity .3s .25s; }
  :global(html.js) .pic { scale: .4; opacity: 0; }
  :global(html.js) .row.in .pic { scale: 1; opacity: 1; }
  .pic.spin { animation: turn 18s linear infinite; }
  :global(html.js) .pic.roll-in { translate: -1.5em 0; rotate: -200deg; transition: scale .8s var(--spring) .25s, opacity .3s .25s, translate 1.4s var(--ease) .2s, rotate 1.4s var(--ease) .2s; }
  :global(html.js) .row.in .pic.roll-in { translate: 0 0; rotate: 0deg; }
  .pic.guy { height: 1.5em; margin: -.35em 0 -.2em; filter: drop-shadow(0 .06em .05em rgb(22 19 15 / .25)); }
  .pic.run { height: 1.35em; }
  .track { display: inline-block; width: 1.6em; height: .8em; position: relative; }
  .pic.cart { position: absolute; left: 0; top: 50%; height: .75em; translate: calc(var(--p, 0) * (1.6em - 100%)) -50%; }
  @keyframes turn { to { rotate: 360deg; } }

  /* ---- 3. the tree ---- */
  .tree { display: grid; justify-items: center; gap: 14px; }
  .tree-h { margin: 0; display: grid; justify-items: center; gap: 6px; font: 400 clamp(26px, 2.6vw, 40px)/1 var(--serif); }
  .dots { font: 700 14px/1 var(--mono); letter-spacing: .2em; }
  .hint { margin: 0 0 4vh; font: 400 12px/1.4 var(--mono); color: var(--soft); }
  .family { position: relative; width: 100%; max-width: 1180px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: clamp(12px, 2.4vw, 36px); row-gap: 12vh; }
  .lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .lines :global(path) { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s var(--ease); }
  .lines.in :global(path) { stroke-dashoffset: 0; }
  .lines.in :global(path:nth-child(2)) { transition-delay: .08s; } .lines.in :global(path:nth-child(3)) { transition-delay: .16s; }
  .lines.in :global(path:nth-child(4)) { transition-delay: .24s; } .lines.in :global(path:nth-child(5)) { transition-delay: .32s; }
  .node { margin: 0; display: grid; justify-items: center; align-content: end; gap: 14px; text-align: center; position: relative; z-index: 1; cursor: crosshair; }
  .node.top { grid-column: 1 / -1; justify-self: center; width: clamp(170px, 20vw, 260px); }
  .pose-wrap { position: relative; width: 100%; }
  .pose { position: relative; }
  .art { display: block; width: 100%; height: auto; filter: drop-shadow(0 2px 1px rgb(22 19 15 / .18)); }
  .real { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .4s; }
  .node:hover .real { opacity: 1; }
  .floor { position: absolute; left: 18%; right: 18%; bottom: -6px; height: 12px; border-radius: 50%; background: radial-gradient(closest-side, rgb(22 19 15 / .22), transparent); z-index: -1; }
  /* the machine reads the painting: a scan line sweeps the figure only */
  .scan { position: absolute; inset: 0; pointer-events: none; opacity: 0;
    -webkit-mask: var(--m) center / 100% 100% no-repeat; mask: var(--m) center / 100% 100% no-repeat;
    background: linear-gradient(180deg, transparent 0 40%, rgb(240 88 46 / .55) 49%, rgb(255 255 255 / .8) 50%, transparent 60%) 0 0 / 100% 250% no-repeat; }
  .node:hover .scan, .node.on .scan { animation: scan 1.1s var(--ease) both; }
  @keyframes scan { 0% { opacity: 1; background-position: 0 100%; } 85% { opacity: 1; } 100% { opacity: 0; background-position: 0 0; } }
  /* first it finds a person, then it locks onto their thing */
  .pbox, .box { position: absolute; pointer-events: none; opacity: 0; }
  .pbox { inset: -2% -3%; border: 1px dashed rgb(22 19 15 / .5); transition: opacity .2s; }
  .pbox i, .box i { position: absolute; left: -1px; bottom: 100%; padding: 3px 5px; font: 500 10px/1 var(--mono); font-style: normal; white-space: nowrap; }
  .pbox i { background: var(--ink); color: var(--paper); }
  .box { left: 0; top: 0; width: 100%; height: 100%; border: 1.5px solid var(--orange); box-shadow: 0 0 0 1px rgb(255 255 255 / .6) inset;
    transition: left .5s var(--ease), top .5s var(--ease), width .5s var(--ease), height .5s var(--ease), opacity .15s; }
  .box i { background: var(--orange); color: var(--ink); }
  .box::before, .box::after { content: ""; position: absolute; width: 7px; height: 7px; border: 2px solid var(--orange); }
  .box::before { right: -4px; top: -4px; border-left: 0; border-bottom: 0; } .box::after { left: -4px; bottom: -4px; border-right: 0; border-top: 0; }
  .node:hover .pbox, .node.on .pbox { opacity: 1; }
  .node:hover .box, .node.on .box { opacity: 1; left: var(--x); top: var(--y); width: var(--w); height: var(--h); transition-delay: .45s; }
  .node:hover .pose, .node.on .pose { animation-play-state: paused; }
  figcaption { display: grid; gap: 3px; }
  .role { font: 400 clamp(14px, 1.2vw, 17px)/1.2 var(--serif); }

  /* ---- 4. the orange wall ---- */
  .wall { border-radius: 22px; background: var(--orange); color: var(--ink); padding: clamp(36px, 7vh, 80px) clamp(16px, 4vw, 64px); display: grid; gap: 4vh; overflow: hidden; outline: none; }
  .wall .small { color: rgb(22 19 15 / .7); }
  .wall-head { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 32px; }
  .hall { position: relative; height: clamp(420px, 62vh, 620px); touch-action: pan-y; user-select: none; cursor: grab; }
  .hall:active { cursor: grabbing; }
  .exhibit { position: absolute; left: 50%; bottom: 0; margin: 0; width: clamp(240px, 30vw, 380px); display: grid; justify-items: center;
    translate: calc(-50% + var(--o, 0) * clamp(250px, 34vw, 480px)) 0; scale: calc(1 - min(1, abs(var(--o, 0))) * .55); transform-origin: 50% 100%;
    opacity: calc(1 - min(1, max(0, abs(var(--o, 0)) - 1))); transition: translate .8s var(--ease), scale .8s var(--ease), opacity .4s; }
  .obj { width: 100%; height: clamp(220px, 36vh, 360px); display: flex; align-items: flex-end; justify-content: center; padding-bottom: 8px; }
  .obj img { max-width: 100%; max-height: 100%; width: auto; height: auto; min-height: 0; }
  .obj .spin { height: 92%; max-height: 92%; animation: turn 30s linear infinite; }
  .spin { -webkit-mask: radial-gradient(circle closest-side, #000 90%, transparent 100%); mask: radial-gradient(circle closest-side, #000 90%, transparent 100%); }
  .obj .rock { animation: rock 5s ease-in-out infinite; transform-origin: 50% 100%; }
  .obj .turn { animation: spinY 6s ease-in-out infinite; }
  .obj .roll { animation: roll 6s ease-in-out infinite; }
  @keyframes rock { 0%, 100% { rotate: -4deg; } 50% { rotate: 4deg; } }
  @keyframes spinY { 0%, 100% { transform: perspective(600px) rotateY(-35deg); } 50% { transform: perspective(600px) rotateY(35deg); } }
  @keyframes roll { 0%, 100% { translate: -8% 0; } 50% { translate: 8% 0; } }
  .plinth { width: 62%; display: grid; }
  .lid { height: 18px; background: #2A2520; clip-path: polygon(6% 0, 94% 0, 100% 100%, 0 100%); }
  .body { height: 60px; background: var(--ink); display: grid; place-items: center; }
  .plate { padding: 4px 9px; background: #C9A45C; color: var(--ink); font: 500 10px/1 var(--mono); letter-spacing: .08em; }
  .exhibit figcaption { margin-top: 20px; display: grid; gap: 8px; justify-items: center; text-align: center; max-width: 32ch; transition: opacity .4s, filter .4s; }
  .exhibit[aria-hidden="true"] figcaption { opacity: 0; filter: blur(6px); }
  .exhibit b { font: 600 17px/1.2 var(--sans); text-transform: uppercase; letter-spacing: .02em; }
  .exhibit figcaption span:last-child { font: 400 13px/1.4 var(--mono); }
  .nav-ex { justify-self: center; display: flex; align-items: center; gap: 14px; margin-top: 6vh; font: 400 12px/1 var(--mono); }
  .nav-ex button { width: 38px; height: 26px; border-radius: 4px; border: 1px solid var(--ink); background: none; color: var(--ink); cursor: pointer; font: 14px/1 var(--mono); }
  .nav-ex button:hover { background: var(--ink); color: var(--orange); }

  /* ---- 5. join ---- */
  .join { display: grid; gap: 4vh; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { display: grid; grid-template-columns: 90px minmax(0, 1fr) auto; align-items: center; gap: 4vw; padding: 10px 0; }
  .who { height: 72px; display: grid; place-items: end center; }
  .who img { height: 100%; width: auto; transition: translate .4s var(--spring), rotate .4s var(--spring); }
  .rows a:hover .who img { translate: 0 -10px; rotate: -6deg; }
  .rows .mono { font-size: clamp(16px, 1.6vw, 22px); }
  .arrow { font-size: 24px; transition: translate .3s; }
  .rows a:hover .arrow { translate: 4px -4px; }

  @media (max-width: 860px) {
    .corner { display: none; }
    .title { font-size: 17vw; }
    .walk { height: 13vh; }
    .parade { gap: 4px; }
    .parade .cap { display: none; }
    .intro, .wall-head { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .family { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 8vh; }
    .node.top { width: 62%; }
    .lines { display: none; }
    .rows a { grid-template-columns: 64px minmax(0, 1fr) auto; }
    .who { height: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .museum *, .museum *::before, .museum *::after { animation: none !important; transition-duration: .01ms !important; }
    :global(html.js) [data-reveal], .rise { opacity: 1; filter: none; translate: none; }
    :global(html.js) .pic { scale: 1; opacity: 1; translate: none; rotate: none; }
  }
</style>

<script>
  // The bar is cream over the night. A Charioteer jumps into the brackets every couple of
  // seconds (or the one you point at). Sections come into focus as they scroll in. The chariot
  // rolls along its line with the scroll. The tree draws its lines to each Charioteer, and the
  // detector names their thing. The exhibits move along the wall with the arrows, keys or a swipe.
  let stop: AbortController | null = null;
  function init() {
    stop?.abort();
    const page = document.querySelector<HTMLElement>('.museum');
    if (!page) return;
    stop = new AbortController();
    const { signal } = stop;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const timers: number[] = [];
    signal.addEventListener('abort', () => timers.forEach((t) => clearInterval(t)));

    // night bar
    const night = page.querySelector<HTMLElement>('[data-night]')!;
    const onNight = () => page.classList.toggle('over-night', night.getBoundingClientRect().bottom > 40);

    // 1. the brackets
    const gapImgs = [...page.querySelectorAll<HTMLImageElement>('[data-gap] img')];
    const picks = [...page.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    let at = 0, held = false;
    const put = (n: number) => {
      if (n === at) return;
      gapImgs[at].classList.remove('on'); gapImgs[at].classList.add('off');
      const prev = gapImgs[at];
      setTimeout(() => prev.classList.remove('off'), 400);
      at = n; gapImgs[at].classList.remove('off'); gapImgs[at].classList.add('on');
      picks.forEach((p, i) => p.classList.toggle('on', i === at));
    };
    picks.forEach((p, i) => {
      p.addEventListener('pointerenter', () => { held = true; put(i); }, { signal });
      p.addEventListener('pointerleave', () => { held = false; }, { signal });
      p.addEventListener('focus', () => { held = true; put(i); }, { signal });
      p.addEventListener('blur', () => { held = false; }, { signal });
      p.addEventListener('click', () => put(i), { signal });
    });
    if (!calm) timers.push(window.setInterval(() => { if (!held && !document.hidden) put((at + 1) % gapImgs.length); }, 1900));

    // reveals
    const io = new IntersectionObserver((es) => es.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }), { rootMargin: '0px 0px -12% 0px' });
    page.querySelectorAll('[data-reveal]').forEach((n) => io.observe(n));
    signal.addEventListener('abort', () => io.disconnect());

    // 2. the chariot rolls along its line
    const zoom = page.querySelector<HTMLElement>('[data-zoom]')!;
    const onZoom = () => {
      const r = zoom.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, 1 - (r.top + r.height / 2) / innerHeight));
      zoom.style.setProperty('--p', (p * 1.6 - .3).toFixed(3));
    };

    // 3. the tree: lines from the head to each Charioteer
    const tree = page.querySelector<HTMLElement>('[data-tree]')!;
    const svg = tree.querySelector<SVGSVGElement>('[data-lines]')!;
    const nodes = [...tree.querySelectorAll<HTMLElement>('[data-node]')];
    const draw = () => {
      const box = svg.getBoundingClientRect();
      const [top, ...kids] = nodes.map((n) => n.querySelector<HTMLElement>('.pose-wrap')!.getBoundingClientRect());
      const hx = top.left + top.width / 2 - box.left, hy = nodes[0].getBoundingClientRect().bottom - box.top + 14;
      svg.innerHTML = kids.map((k) => {
        const cx = k.left + k.width / 2 - box.left, cy = k.top - box.top - 14, m = (hy + cy) / 2;
        return `<path pathLength="1" d="M${hx} ${hy} C${hx} ${m} ${cx} ${m} ${cx} ${cy}" />`;
      }).join('');
    };
    draw();
    const lio = new IntersectionObserver((es) => es.forEach((en) => { if (en.isIntersecting) { svg.classList.add('in'); lio.disconnect(); } }), { threshold: .3 });
    lio.observe(svg);
    signal.addEventListener('abort', () => lio.disconnect());
    const ro = new ResizeObserver(draw);
    ro.observe(tree);
    signal.addEventListener('abort', () => ro.disconnect());

    // the detector counts up to its score
    const count = (n: HTMLElement) => {
      const label = n.querySelector<HTMLElement>('[data-label]')!;
      const thing = n.dataset.thing!, score = Number(n.dataset.score);
      if (calm) { label.textContent = `${thing} ${score.toFixed(2)}`; return; }
      const t0 = performance.now() + 450;
      const tick = (t: number) => {
        const k = Math.min(1, Math.max(0, (t - t0) / 600));
        label.textContent = `${thing} ${(score * (0.4 + 0.6 * k)).toFixed(2)}`;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    nodes.forEach((n) => n.addEventListener('pointerenter', () => count(n), { signal }));
    if (!matchMedia('(hover: hover)').matches) {
      const tio = new IntersectionObserver((es) => es.forEach((en) => {
        en.target.classList.toggle('on', en.isIntersecting);
        if (en.isIntersecting) count(en.target as HTMLElement);
      }), { rootMargin: '-35% 0px -35% 0px' });
      nodes.forEach((n) => tio.observe(n));
      signal.addEventListener('abort', () => tio.disconnect());
    }

    // 4. the wall
    const wall = page.querySelector<HTMLElement>('[data-exhibits]')!;
    const hall = wall.querySelector<HTMLElement>('[data-hall]')!;
    const items = [...wall.querySelectorAll<HTMLElement>('.exhibit')];
    const counter = wall.querySelector<HTMLElement>('[data-count]')!;
    let ex = 0, lastTouch = 0;
    const show = () => {
      items.forEach((el, i) => { el.style.setProperty('--o', String(i - ex)); el.setAttribute('aria-hidden', String(i !== ex)); });
      counter.textContent = `${ex + 1} / ${items.length}`;
    };
    const go = (d: number, auto = false) => { if (!auto) lastTouch = Date.now(); ex = (ex + d + items.length) % items.length; show(); };
    wall.querySelector('[data-prev]')!.addEventListener('click', () => go(-1), { signal });
    wall.querySelector('[data-next]')!.addEventListener('click', () => go(1), { signal });
    wall.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') go(-1); if (e.key === 'ArrowRight') go(1); }, { signal });
    let x0: number | null = null;
    hall.addEventListener('pointerdown', (e) => { x0 = e.clientX; }, { signal });
    addEventListener('pointerup', (e) => { if (x0 === null) return; const dx = e.clientX - x0; x0 = null; if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1); }, { signal });
    let wallSeen = false;
    const wio = new IntersectionObserver((es) => es.forEach((en) => { wallSeen = en.isIntersecting; }), { threshold: .5 });
    wio.observe(wall);
    signal.addEventListener('abort', () => wio.disconnect());
    if (!calm) timers.push(window.setInterval(() => { if (wallSeen && !document.hidden && Date.now() - lastTouch > 9000) go(1, true); }, 4800));
    show();

    const onScroll = () => { onNight(); onZoom(); };
    onScroll();
    addEventListener('scroll', onScroll, { passive: true, signal });
  }
  document.addEventListener('astro:page-load', init);
</script>
