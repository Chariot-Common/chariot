---
// The Ken, as what we made: India's premium business publication, redefined from the ground up,
// everywhere a reader meets it. At rest it is the homepage, standing on the paper as a sheet.
// Raise --x from 0 to 1 and the sheet turns to face you while the rest of The Ken comes out of it
// and settles round it: a story on the iPad, the writers, the pricing page,
// and the app on two phones (welcome, and "never miss a story"). Real screens from the case
// study (public/media/ken), no labels. Each piece leaves from the place it would live on the page.
// The homepage animates --x on hover; the case page drives it when the hero opens.
interface Props { size?: number; style?: string }
const { size = 420, style } = Astro.props;
// final spot (left/top, % of the page width) and the spot on the page it comes from (hx/hy);
// z is how far toward you it floats
const parts = [
  // UI/UX: reading, discovery, engagement (left)
  { cls: 'ipad', src: 'ipad-story', left: -54, top: 0, w: 46, hx: 10, hy: 20, z: 60 },
  { cls: 'paper', src: 'writers', left: -54, top: 37, w: 21, hx: 6, hy: 40, z: 110 },
  { cls: 'paper', src: 'story-metro', left: -30, top: 37, w: 22, hx: 30, hy: 36, z: 90 },
  // Product: the subscription flow and the apps (right)
  { cls: 'pricing', src: 'pricing', left: 108, top: 0, w: 46, hx: 70, hy: 20, z: 60 },
  { cls: 'phone', src: 'app-welcome', left: 110, top: 39, w: 14, hx: 50, hy: 30, z: 120 },
  { cls: 'phone', src: 'app-notify', left: 127, top: 39, w: 14, hx: 60, hy: 34, z: 100 },
];
// what we did, in three words, each over the work it names. The lines are from our case study.
const what = [
  { head: 'UI/UX', line: 'Reading, discovery and engagement', left: -54, w: 46 },
  { head: 'Visual redesign', line: 'Premium, credible, distinguished', left: 0, w: 100 },
  { head: 'Product', line: 'The subscription flow, and apps on every platform', left: 108, w: 46 },
];
const sheet = Array.from({ length: 6 }, (_, i) => i);
---
<div class="ken3d" style={`--w:${size}px;${style ?? ''}`} role="img" aria-label="The Ken: its homepage, with the iPad story, the writers, the pricing page and the app around it">
  <div class="rig">
    <div class="sheet" aria-hidden="true">
      {sheet.map((i) => <i style={`--i:${i}`}></i>)}
      <img class="face" src="/media/objects/ken-home.jpg" alt="" loading="eager" decoding="async" data-vt="sheet-poster" />
    </div>

    {what.map((w, i) => (
      <p class="what" style={`--l:${w.left};--pw:${w.w};--i:${i}`}><b>{w.head}</b><span>{w.line}</span></p>
    ))}

    {parts.map((p, i) => (
      <div class:list={['part', p.cls]} aria-hidden="true"
           style={`--l:${p.left};--t:${p.top};--pw:${p.w};--dx:${p.hx - p.left};--dy:${p.hy - p.top};--z:${p.z};--i:${i}`}>
        {p.cls === 'logo'
          ? <div class="card"><img src="/media/objects/ken-logo.png" alt="" loading="eager" /></div>
          : <div class="card"><img src={`/media/ken/${p.src}.webp`} alt="" loading="eager" decoding="async" /></div>}
      </div>
    ))}
  </div>
</div>

<style>
  @property --x { syntax: '<number>'; inherits: true; initial-value: 0; }

  .ken3d { --x: 0; --red: #E8432B; --ink: #1B1613; --paper: #F4EDE3;
    position: relative; width: var(--w); height: calc(var(--w) * .72); perspective: calc(var(--w) * 3.2); }
  /* at rest the sheet is turned a little away; as the system comes out it turns to face you */
  .rig { position: absolute; inset: 0; transform-style: preserve-3d;
    transform: rotateX(calc(14deg - var(--x) * 8deg)) rotateY(calc(-26deg + var(--x) * 18deg)) scale(calc(1 - var(--x) * .14)); }

  /* the page, as a sheet of card with a little thickness */
  .sheet { position: absolute; inset: 0; transform-style: preserve-3d; }
  .sheet i { position: absolute; inset: 0; border-radius: 4px; background: #E6DDD0; transform: translateZ(calc(var(--i) * -1.4px)); }
  .sheet i:last-of-type { box-shadow: 0 calc(var(--w) * .08) calc(var(--w) * .12) calc(var(--w) * -.04) rgb(30 23 16 / .35); }
  .face { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 4px; transform: translateZ(1px);
    box-shadow: 0 0 0 1px rgb(30 23 16 / .08); }
  /* registration marks: the print tell */

  /* the parts: each leaves its home on the page and floats out to its place on the specimen */
  .part { position: absolute; left: calc(var(--l) * 1%); top: calc(var(--t) * var(--w) / 100); width: calc(var(--pw) * 1%); transform-style: preserve-3d;
    transform: translate3d(calc((1 - var(--x)) * var(--dx) * var(--w) / 100), calc((1 - var(--x)) * var(--dy) * var(--w) / 100), calc(2px + var(--x) * var(--z) * var(--w) / 420))
               scale(calc(.35 + var(--x) * .65));
    opacity: clamp(0, calc(var(--x) * 2.6 - var(--i) * .22), 1); }
  .card { background: #fff; border-radius: 4px; box-shadow: 0 0 0 1px rgb(30 23 16 / .08), 0 calc(var(--w) * .04) calc(var(--w) * .06) calc(var(--w) * -.03) rgb(30 23 16 / .35); overflow: hidden; }

  /* what we did: a word and a line over each group, set once the pieces have settled */
  .what { position: absolute; left: calc(var(--l) * 1%); width: calc(var(--pw) * 1%); bottom: calc(100% + var(--w) * .035); margin: 0;
    display: grid; gap: calc(var(--w) * .008); padding-top: calc(var(--w) * .014); border-top: 1px solid rgb(30 23 16 / .22); text-align: left;
    transform: translateZ(calc(var(--x) * 60px)); opacity: clamp(0, calc(var(--x) * 4 - 2.6 - var(--i) * .2), 1); }
  .what b { font: 500 calc(var(--w) * .019) / 1.2 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: #E0661B; }
  .what span { font: 400 calc(var(--w) * .027) / 1.25 var(--serif); color: #1E1710; text-wrap: balance; }
  @media (max-width: 760px) { .what { display: none; } }

  .logo .card { padding: 10px 12px; background: var(--paper); }
  .logo img { display: block; width: 100%; height: auto; }
  .card img { display: block; width: 100%; height: auto; }
  /* the iPad and the phones get a dark bezel; paper pieces stay as sheets */
  .ipad .card { padding: 2.4%; border-radius: 12px; background: #1E1A17; }
  .ipad .card img { border-radius: 6px; }
  .phone .card { padding: 5%; border-radius: 16px; background: #1E1A17; }
  .phone .card img { border-radius: 10px; }
  .pricing .card, .paper .card { background: var(--paper); }
</style>
