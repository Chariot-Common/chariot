---
// Frosted pill of every project; icons swell around the pointer (see frame.ts).
import { getCollection } from 'astro:content';
interface Props { current: string }
const { current } = Astro.props;
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<nav class="dock" aria-label="Projects">
  <a href="/" class="dock-close" aria-label="Back to all work" data-tick data-back>
    <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" /></svg>
  </a>
  <div class="dock-items">
    {all.map((p) => (
      <a
        href={`/work/${p.id}`}
        class:list={['dock-item', { current: p.id === current }]}
        aria-current={p.id === current ? 'page' : undefined}
        aria-label={p.data.title}
        data-cursor={p.data.title}
        data-tick
      >
        <img src={p.data.poster} alt="" loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
</nav>

<script>
  // × goes back to the list you came from (the lab homepage records itself), else the live home
  document.addEventListener('astro:page-load', () => {
    let back: string | null = null;
    try { back = sessionStorage.getItem('chariot:back'); } catch {}
    if (back) document.querySelectorAll<HTMLAnchorElement>('[data-back]').forEach((a) => (a.href = back!));
  });
</script>

<style>
  .dock { justify-self: center; display: flex; align-items: center; gap: 8px; }
  .dock-close, .dock-items {
    background: rgb(33 33 27 / .55); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgb(255 255 255 / .07); border-radius: 999px;
  }
  .dock-close { width: 36px; height: 36px; display: grid; place-items: center; color: #F2F1EC; }
  .dock-close svg { width: 10px; height: 10px; stroke: currentColor; stroke-width: 1.4; }
  .dock-items { display: flex; align-items: flex-end; gap: 7px; padding: 6px 10px; }
  .dock-item {
    flex: none; width: 26px; height: 26px; border-radius: 50%; overflow: hidden;
    outline: 1.5px solid transparent; outline-offset: 2px;
    transform-origin: 50% 100%; transition: transform 160ms var(--ease), outline-color var(--fast);
  }
  .dock-item img { width: 100%; height: 100%; object-fit: cover; }
  .dock-item.current { outline-color: var(--accent); }
  /* on paper the pill is frosted white, like dmcg */
  :global(html.theme-paper) .dock-close, :global(html.theme-paper) .dock-items {
    background: rgb(255 255 255 / .72); border-color: rgb(30 23 16 / .1); box-shadow: 0 6px 20px -12px rgb(30 23 16 / .3);
  }
  :global(html.theme-paper) .dock-close { color: var(--ink); }
  @media (max-width: 820px) { .dock-items { max-width: 46vw; overflow-x: auto; scrollbar-width: none; } }
</style>
