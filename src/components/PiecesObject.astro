---
// A project's own screen, and the pieces that matter on it, cut from the real screenshots
// (public/media/pieces). At rest the screen lies on the paper, turned a little away: a sheet for a
// website or dashboard, a phone for an app. Raise --x from 0 to 1 and it turns to face you while
// its pieces lift off the place they live on the screen and settle round it, nearer to you.
// Used for Neon Fund, Value Research, Doxel and Tortoise. No labels: the pieces say it.
//   left/top/w: where a piece settles, in % of the screen's width (top too, so it scales with it)
//   hx/hy:      where the piece lives on the screen, same units
//   z:          how far toward you it floats
interface Part { src: string; left: number; top: number; w: number; hx: number; hy: number; z: number; scan?: boolean }
interface Props {
  size?: number; label: string;
  // page + bar: a long capture of the real site that scrolls through the screen while you point, under its own top bar
  base: { src: string; ratio: number; kind: 'sheet' | 'phone'; page?: string; bar?: string };
  parts: Part[];
  rays?: boolean; // Neon's sunburst opens behind the phone, and keeps turning
  glow?: boolean; // Neon: the phone is a light, and its pieces switch on like a sign
  // a region of the screen that draws itself in from the left while you point (Value Research's chart); % of the width
  wipe?: { left: number; top: number; w: number; h: number; color?: string };
  style?: string;
}
const { size = 420, label, base, parts, rays = false, glow = false, wipe, style } = Astro.props;
---
<div class:list={['pc3d', base.kind, { glow }]} style={`--w:${size}px;--ratio:${base.ratio};${style ?? ''}`} role="img" aria-label={label}>
  {rays && <span class="rays" aria-hidden="true" data-nofit></span>}
  <div class="rig">
    <div class="face">{base.page
      ? <div class="scroller"><img class="page" data-nofit src={base.page} alt="" loading="eager" decoding="sync" />{base.bar && <img class="bar" src={base.bar} alt="" />}</div>
      : <img src={base.src} alt="" loading="eager" decoding="async" />}
      {wipe && <span class="wipe" aria-hidden="true" style={`--wl:${wipe.left};--wt:${wipe.top};--ww:${wipe.w};--wh:${wipe.h};--wc:${wipe.color ?? '#fff'}`}><i></i></span>}
    </div>
    {parts.map((p, i) => (
      <div class:list={['part', { scan: p.scan }]} aria-hidden="true"
           style={`--l:${p.left};--t:${p.top};--pw:${p.w};--dx:${p.hx - p.left};--dy:${p.hy - p.top};--z:${p.z};--i:${i}`}>
        <img src={`/media/pieces/${p.src}.webp`} alt="" loading="eager" decoding="async" />
      </div>
    ))}
  </div>
</div>

<style>
  @property --x { syntax: '<number>'; inherits: true; initial-value: 0; }

  .pc3d { --x: 0; position: relative; width: var(--w); height: calc(var(--w) * var(--ratio)); perspective: calc(var(--w) * 3.4); }
  .rig { position: absolute; inset: 0; transform-style: preserve-3d;
    transform: rotateX(calc(14deg - var(--x) * 10deg)) rotateY(calc(-24deg + var(--x) * 18deg)) scale(calc(1 - var(--x) * .1)); }
  .phone .rig { transform: rotateX(calc(10deg - var(--x) * 8deg)) rotateY(calc(-20deg + var(--x) * 14deg)) scale(calc(1 - var(--x) * .1)); }

  .face { position: absolute; inset: 0; border-radius: 6px; overflow: hidden; background: #fff; transform: translateZ(1px);
    box-shadow: 0 0 0 1px rgb(30 23 16 / .08), 0 calc(var(--w) * .07) calc(var(--w) * .1) calc(var(--w) * -.04) rgb(30 23 16 / .35); }
  .face img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  /* a phone: a dark bezel round the screen */
  .phone .face { border-radius: calc(var(--w) * .12); padding: calc(var(--w) * .035); background: #1E1A17; }
  .phone .face img { border-radius: calc(var(--w) * .09); }

  /* a real page, scrolling through the screen: down to the end, slowly, and back */
  .scroller { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: calc(var(--w) * .09); background: #FBFFEA; }
  .face .scroller img { position: absolute; left: 0; top: 0; width: 100%; height: auto; border-radius: 0; object-fit: fill; }
  .face .scroller .page { padding-top: 13.4%; --run: calc(-100% + var(--w) * (var(--ratio) - .07)); }
  .face .scroller .bar { box-shadow: 0 1px 6px rgb(30 23 16 / .12); }
  :global(.proj:is(:hover, :focus-visible, .peek)) .scroller .page { animation: pc-page 9s cubic-bezier(.45, 0, .55, 1) 1s infinite alternate; }
  @keyframes pc-page { 0%, 4% { transform: translateY(0); } 96%, 100% { transform: translateY(var(--run)); } }

  /* each piece leaves its place on the screen and floats out to where it settles */
  .part { position: absolute; left: calc(var(--l) * 1%); top: calc(var(--t) * var(--w) / 100); width: calc(var(--pw) * 1%); transform-style: preserve-3d;
    transform: translate3d(calc((1 - var(--x)) * var(--dx) * var(--w) / 100), calc((1 - var(--x)) * var(--dy) * var(--w) / 100), calc(2px + var(--x) * var(--z) * var(--w) / 420))
               scale(calc(.4 + var(--x) * .6));
    opacity: clamp(0, calc(var(--x) * 2.6 - var(--i) * .2), 1); }
  .part img { display: block; width: 100%; height: auto; border-radius: 6px; background: #fff;
    box-shadow: 0 0 0 1px rgb(30 23 16 / .08), 0 calc(var(--w) * .04) calc(var(--w) * .06) calc(var(--w) * -.03) rgb(30 23 16 / .35); }

  /* Neon: the site's sunburst opens behind the phone, slowly */
  .rays { position: absolute; left: 50%; top: 50%; width: calc(var(--w) * 3.2); aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; pointer-events: none;
    background: repeating-conic-gradient(from 0deg, rgb(214 250 90 / .95) 0 8deg, rgb(240 255 190 / .35) 8deg 20deg);
    -webkit-mask: radial-gradient(closest-side, #000 22%, transparent 82%); mask: radial-gradient(closest-side, #000 22%, transparent 82%);
    opacity: var(--x); scale: calc(.4 + var(--x) * .6); rotate: calc(var(--x) * 20deg); }

  /* the product at work. Value Research: the performance line draws itself, left to right */
  .wipe { position: absolute; left: calc(var(--wl) * 1%); top: calc(var(--wt) * var(--w) / 100); width: calc(var(--ww) * 1%); height: calc(var(--wh) * var(--w) / 100);
    background: var(--wc); transform-origin: 100% 50%; opacity: 0; }
  .wipe i { position: absolute; left: -1px; top: 0; bottom: 0; width: 2px; background: #1E9E5A; box-shadow: 0 0 10px 2px rgb(30 158 90 / .5); }
  :global(.proj:is(:hover, :focus-visible, .peek)) .wipe { animation: pc-draw 2.6s cubic-bezier(.45, 0, .2, 1) .5s both; }
  @keyframes pc-draw { 0% { opacity: 0; transform: scaleX(1); } 10% { opacity: 1; transform: scaleX(1); } 96% { opacity: 1; transform: scaleX(0); } 100% { opacity: 0; transform: scaleX(0); } }

  /* Doxel: a scan passes over the model, again and again, as the product tracks the build */
  .part.scan { overflow: hidden; border-radius: 6px; }
  .part.scan::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 18%; opacity: 0;
    background: linear-gradient(90deg, transparent, rgb(255 141 37 / .28) 80%, rgb(255 141 37 / .9) 98%, transparent); }
  :global(.proj:is(:hover, :focus-visible, .peek)) .part.scan::after { animation: pc-scan 2.8s cubic-bezier(.45, 0, .55, 1) 1s infinite; }
  @keyframes pc-scan { 0% { opacity: 0; translate: -100% 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { opacity: 0; translate: 560% 0; } }

  /* Neon: the phone glows, and the headline and the button switch on like a sign, once */
  .glow .face { box-shadow: 0 0 0 1px rgb(30 23 16 / .08), 0 0 calc(var(--w) * .5) calc(var(--w) * .04) rgb(205 245 70 / calc(var(--x) * .75)); }
  .glow .part img { box-shadow: 0 0 0 1px rgb(60 80 10 / .12), 0 0 calc(var(--w) * .16) rgb(205 245 70 / .9), 0 calc(var(--w) * .04) calc(var(--w) * .06) calc(var(--w) * -.03) rgb(60 80 10 / .4); }
  :global(.proj:is(:hover, :focus-visible, .peek)) .glow .part { animation: pc-sign .9s linear calc(.5s + var(--i) * .25s) backwards; }
  @keyframes pc-sign { 0% { opacity: 0; } 12% { opacity: 1; } 22% { opacity: .2; } 38% { opacity: 1; } 50% { opacity: .5; } 62%, 100% { opacity: 1; } }

  /* Neon: the sunburst keeps turning, slowly */
  :global(.proj:is(:hover, :focus-visible, .peek)) .rays { animation: pc-spin 50s linear infinite; }
  @keyframes pc-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .wipe, .part.scan::after, .rays, .glow .part, .scroller .page { animation: none !important; } }
</style>
