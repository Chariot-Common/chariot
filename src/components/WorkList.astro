---
// The work, as real interfaces on real devices, in the order from the Figma sketch.
//   In view: the device wakes up; its screens cycle, long pages scroll, keywords set in.
//   Hover, after dmcg.co: the device stays put and the work fans out around it, a few real
//   screens from the project, with a "Name · Kind" chip on the front card; the rest of the
//   list steps back. Projects with a language of their own show that instead:
//   What Chariot made is the object: Skyway's website coming apart in 3D, The Ken's design
//   system coming out of its homepage, Stoa's mark drawing its grid and fanning out its identity.
//   HealthFlex still has its leaves.
//   Click: the screen carries over into the project page (view transition).
// Sizes: organic (big and small) by default; an ancestor with data-layout="even" makes them
// all one size. Colours are light unless an ancestor has data-theme="dark".
import { getCollection } from 'astro:content';
import SkywaySite from './SkywaySite.astro';
import KenSystem from './KenSystem.astro';
import StoaBrand from './StoaBrand.astro';
import AlaiProduct from './AlaiProduct.astro';
import PaperPlanes from './PaperPlanes.astro';

type Screen = { src: string; video?: string; framed?: boolean };
type Project = {
  name: string; slug?: string; size: 'big' | 'small'; tags: string[];
  desktop?: Screen[]; phone?: Screen[]; extra?: 'site' | 'leaves' | 'stoa' | 'ken' | 'alai' | 'planes'; soon?: boolean;
};
const m = (p: string) => `/media/home/${p}`;
const projects: Project[] = [
  { name: 'Cruise', size: 'big', tags: ['Product strategy', 'Product design'], soon: true },
  { name: 'Rang De', size: 'big', tags: ['Brand', 'Website'], soon: true },
  { name: 'AtLabs', size: 'small', tags: ['Product design'], soon: true },
  { name: 'Paper Planes', slug: 'paper-planes', size: 'big', tags: ['UI/UX', 'Website', 'Editorial design'], extra: 'planes' },
  { name: 'Freight Tiger', size: 'small', tags: ['Product design'], soon: true },
  { name: 'Alai', slug: 'alai', size: 'big', tags: ['Product design', 'AI UX', 'Design system'], extra: 'alai' },
  { name: 'The Ken', slug: 'the-ken', size: 'big', tags: ['Product strategy', 'Visual design', 'Design system'], extra: 'ken' },
  { name: 'HealthFlex by Loop', slug: 'healthflex', size: 'small', tags: ['Website', 'Visual design'], phone: [{ src: m('healthflex.jpg') }], extra: 'leaves' },
  { name: 'Skyway', slug: 'skyway', size: 'small', tags: ['Website', 'D2C eCommerce', 'Content'], extra: 'site' },
  { name: 'Draconic', slug: 'draconic', size: 'small', tags: ['Website', 'Visual design'], soon: true },
  { name: 'Stoa', slug: 'stoa', size: 'small', tags: ['Brand identity', 'Website', 'Product design'], extra: 'stoa' },
  { name: 'Neon Fund', slug: 'neon-fund', size: 'small', tags: ['Website'], phone: [{ src: m('neon.jpg') }] },
  { name: 'Value Research', slug: 'value-research', size: 'big', tags: ['Product design', 'UI/UX'], desktop: [{ src: m('vr.jpg') }] },
  { name: 'Doxel', slug: 'doxel', size: 'small', tags: ['Website'], desktop: [{ src: m('doxel.jpg') }] },
  { name: 'Tortoise', slug: 'tortoise', size: 'small', tags: ['Product design', 'UI/UX'], phone: [{ src: m('tortoise.jpg') }] },
];

// the fan: up to three real screens per project, from its case study
const kinds = { product: 'Product', web: 'Website', publication: 'Publication', brand: 'Brand' } as const;
const entries = new Map((await getCollection('projects')).map((e) => [e.id, e.data]));
// framer serves big originals; ask for a card-sized copy
const small = (src: string) => (src.includes('framerusercontent.com') ? `${src}?scale-down-to=1024` : src);
const fanFor = (p: Project): string[] => {
  const d = p.slug ? entries.get(p.slug) : undefined;
  if (!d || p.soon || p.extra === 'leaves' || p.extra === 'site' || p.extra === 'stoa' || p.extra === 'ken' || p.extra === 'alai' || p.extra === 'planes') return [];
    return (d.pieces.length ? d.pieces.slice(0, 3).map((x) => x.src) : [d.poster]).map(small);
};
// where each card lands: behind top-right, in front bottom-right (carries the chip), behind left
const slots = (n: number) => (n === 1 ? ['front'] : n === 2 ? ['back', 'front'] : ['back', 'front', 'side']);

// two smalls in a row pair up, left then right (the right one steps down); a small on its own
// takes the whole row but leans to one side, alternating; big ones take the middle
let lean = 0;
const placed = projects.map((p, i) => {
  const extra = { fan: fanFor(p), kind: p.slug ? kinds[entries.get(p.slug)?.kind ?? 'web'] : p.tags[0] };
  if (p.size === 'big') return { ...p, ...extra, side: 'c' };
  const prev = projects[i - 1], next = projects[i + 1];
  const pairedWithPrev = prev?.size === 'small' && placed_isLeft(i - 1);
  if (pairedWithPrev) return { ...p, ...extra, side: 'r' };
  if (next?.size === 'small') return { ...p, ...extra, side: 'l' };
  return { ...p, ...extra, side: lean++ % 2 ? 'solo lean-r' : 'solo lean-l' };
});
function placed_isLeft(i: number): boolean {
  // a small is the left of a pair if the run of smalls before it has even length and one follows
  let run = 0;
  for (let k = i - 1; k >= 0 && projects[k].size === 'small'; k--) run++;
  return run % 2 === 0 && projects[i + 1]?.size === 'small';
}

// HealthFlex: eight leaves, four a side, each its own height, size and angle so none overlap.
// x/y is where the stem sits (just behind the phone's edge); r is how far it leans out.
const leaves = [
  { x: 3, y: 22, w: 44, r: -42, c: 'lime' }, { x: 8, y: 46, w: 58, r: -54, c: 'deep' },
  { x: 3, y: 70, w: 40, r: -36, c: 'lime' }, { x: 8, y: 94, w: 52, r: -48, c: 'deep' },
  { x: 90, y: 30, w: 54, r: 44, c: 'deep' }, { x: 97, y: 54, w: 40, r: 38, c: 'lime' },
  { x: 90, y: 80, w: 60, r: 52, c: 'deep' }, { x: 97, y: 100, w: 38, r: 34, c: 'lime' },
];
---
<div class="list">
  {placed.map((p) => {
    const holder = p.extra === 'stoa' ? 'is-stoa' : p.extra === 'ken' ? 'is-ken' : p.extra === 'alai' ? 'is-alai' : p.extra === 'planes' ? 'is-pp' : p.extra === 'site' ? 'is-site' : p.desktop || p.soon ? 'is-desk' : 'is-phone';
    const pos = slots(p.fan.length);
    return (
    <a class:list={['proj', p.size, p.side, p.extra && `x-${p.extra}`, { soon: p.soon, duo: p.desktop && p.phone }]}
       href={p.slug ? `/work/${p.slug}` : undefined} data-proj>
      <div class="stage">
        <div class:list={['obj', holder]}>
          {p.extra === 'leaves' && (
            <div class="leaves" aria-hidden="true">
              <svg width="0" height="0" class="defs"><defs>
                <linearGradient id="hf-lime" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#7FB83A" /><stop offset="1" stop-color="#D4F06A" /></linearGradient>
                <linearGradient id="hf-deep" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#14502F" /><stop offset="1" stop-color="#2F8A4C" /></linearGradient>
              </defs></svg>
              {leaves.map((l, i) => (
                <i class="leaf" style={`--x:${l.x}%;--y:${l.y}%;--w:${l.w}px;--r:${l.r}deg;--i:${i}`}>
                  <svg viewBox="0 0 40 100">
                    <path fill={`url(#hf-${l.c})`} d="M20 100c0-8-1-12-2-16C4 70 0 44 8 24 12 14 17 6 20 0c3 6 8 14 12 24 8 20 4 46-10 60-1 4-2 8-2 16Z" />
                    <path class="rib" d="M20 97V8M20 70l-9-11M20 56l-10-13M20 42l-7-11M20 70l9-11M20 56l10-13M20 42l7-11" />
                  </svg>
                </i>
              ))}
            </div>
          )}

          {p.extra === 'stoa' && <StoaBrand size={200} />}
          {p.extra === 'ken' && <KenSystem size={420} />}
          {p.extra === 'alai' && <AlaiProduct size={440} />}
          {p.extra === 'planes' && <PaperPlanes size={400} />}

          {p.soon && (
            <div class="device desktop placeholder"><div class="bar"><b></b><b></b><b></b></div><div class="screen"><span>{p.name}<br />screens coming</span></div></div>
          )}

          {p.desktop && (
            <div class="device desktop">
              <div class="bar"><b></b><b></b><b></b></div>
              <div class="screen">
                {p.desktop.map((s, i) => s.video
                  ? <video src={s.video} poster={s.src} muted loop playsinline preload="none" class:list={{ cur: i === 0 }}></video>
                  : <img src={s.src} alt="" loading="lazy" class:list={{ cur: i === 0 }} />)}
              </div>
            </div>
          )}
          {p.phone && (
            <div class="device phone">
              <div class="screen">
                {p.phone.map((s, i) => <img src={s.src} alt="" loading="lazy" class:list={{ cur: i === 0, framed: s.framed }} />)}
              </div>
            </div>
          )}
          {p.extra === 'site' && <SkywaySite size={170} />}

          {p.fan.map((src, i) => (
            <figure class:list={['card', pos[i]]} style={`--i:${i}`} aria-hidden="true">
              <img src={src} alt="" loading="lazy" decoding="async" />
              {pos[i] === 'front' && <span class="chip"><b>{p.name}</b> {p.kind}</span>}
            </figure>
          ))}
          {!p.soon && p.fan.length === 0 && <span class="chip solo-chip" aria-hidden="true"><b>{p.name}</b> {p.kind}</span>}
        </div>
      </div>

      <p class="cap">
        <span class="name">{p.name}</span>
        <span class="tags">{p.tags.map((t, i) => <span style={`--i:${i}`}>{t}</span>)}</span>
      </p>
    </a>
  );})}
</div>

<style>
  .list { --ink: #1E1710; --soft: #8A8378; --frame: #EEECE7; --bezel: #1E1710; --snap: cubic-bezier(.2, 1.25, .35, 1); color: var(--ink); }
  :global([data-theme="dark"]) .list { --ink: #F2EEE6; --soft: #8F897D; --frame: #26241F; --bezel: #000; }

  /* ---------- the list ---------- */
  .list { width: min(860px, 100% - 2 * var(--gutter)); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; column-gap: 40px; row-gap: 16vh; }
  .proj { position: relative; display: grid; justify-items: center; gap: 22px; color: inherit; text-decoration: none; transition: opacity .45s var(--ease); }
  .proj[href] { cursor: pointer; }
  .proj.big { grid-column: 1 / -1; }
  /* organic: smalls step down in turn, like the sketch */
  .proj.small.r { margin-top: 22vh; }
  .proj.solo { grid-column: 1 / -1; }
  .proj.lean-l { translate: -22% 0; }
  .proj.lean-r { translate: 22% 0; }

  .stage { position: relative; display: grid; place-items: center; width: 100%; }
  .big .stage { min-height: 420px; }
  .small .stage { min-height: 460px; }

  /* the object the hover is built around: exactly the size of its device */
  .obj { position: relative; display: grid; place-items: center; }
  .obj.is-desk { width: 100%; max-width: 640px; }
  .small .obj.is-desk { max-width: 380px; }
  .small .obj.is-desk:has(.placeholder) { max-width: 300px; }
  .obj.is-phone { width: 230px; }
  .obj.is-stoa { width: 200px; }

  /* devices */
  .device { position: relative; z-index: 2; transition: transform .7s var(--ease); }
  .desktop { width: 100%; border-radius: 10px; background: var(--frame); box-shadow: 0 1px 0 rgb(0 0 0 / .04), 0 24px 60px -30px rgb(30 23 16 / .35); overflow: hidden; }
  .bar { display: flex; gap: 6px; padding: 10px 12px; }
  .bar b { width: 8px; height: 8px; border-radius: 50%; background: color-mix(in srgb, var(--ink) 16%, transparent); }
  .desktop .screen { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #fff; }

  .phone { width: 100%; aspect-ratio: 9 / 19.2; border-radius: 34px; background: var(--bezel); padding: 7px; box-shadow: 0 30px 60px -30px rgb(30 23 16 / .45); }
  .phone .screen { position: relative; height: 100%; border-radius: 28px; overflow: hidden; background: #fff; }
  .phone::after { content: ""; position: absolute; top: 15px; left: 50%; width: 62px; height: 18px; translate: -50% 0; border-radius: 10px; background: var(--bezel); z-index: 3; }
  .duo .phone { position: absolute; right: -4%; bottom: -12%; width: 168px; z-index: 3; }

  /* screens: one shows; in view they cycle, and a long page scrolls through */
  .screen img, .screen video { position: absolute; inset: 0 0 auto 0; width: 100%; height: auto; min-height: 100%; object-fit: cover; object-position: top; opacity: 0; transition: opacity .5s; }
  .screen .cur { opacity: 1; }
  /* captures that come with their own phone frame: crop it off inside ours */
  .screen img.framed { height: 100%; object-position: center; scale: 1.1; }
  .screen .cur.scrolling { transition: opacity .5s, transform var(--dur, 6s) cubic-bezier(.45, 0, .25, 1); transform: translateY(var(--dy, 0)); }

  /* caption: the name always, the keywords set in when the project wakes */
  .cap { margin: 0; display: grid; gap: 6px; justify-items: center; text-align: center; font: 400 14px/1.3 var(--sans); }
  .name { font-family: var(--serif); font-size: 20px; }
  .tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 14px; color: var(--soft); min-height: 1.3em; }
  .tags span { opacity: 0; translate: 0 6px; transition: opacity .35s, translate .45s var(--ease); transition-delay: calc(var(--i) * 90ms); }
  .on .tags span { opacity: 1; translate: 0 0; }

  .on .device { transform: translateY(-6px); }
  .duo.on .phone { transform: translate(14px, -18px) rotate(2deg); }

  .placeholder .screen { display: grid; place-items: center; background: repeating-linear-gradient(-45deg, transparent 0 10px, color-mix(in srgb, var(--ink) 5%, transparent) 10px 11px), var(--frame); }
  .placeholder .screen span { font: 400 13px/1.4 var(--sans); color: var(--soft); text-align: center; }

  /* ---------- hover, after dmcg: focus one project, the others step back ---------- */
  @media (hover: hover) {
    .list:has(.proj[href]:hover) .proj:not(:hover) { opacity: .28; }
  }
  .proj:is(:hover, :focus-visible, .peek) { z-index: 5; }

  /* ---------- the fan: real screens slide out from behind the device ---------- */
  .card { position: absolute; margin: 0; padding: 0; border-radius: 6px; background: #fff; pointer-events: none;
    box-shadow: 0 0 0 1px rgb(30 23 16 / .06), 0 18px 40px -18px rgb(30 23 16 / .35);
    opacity: 0; scale: .82; translate: var(--fx) var(--fy); rotate: 0deg;
    transition: opacity .25s, scale .35s var(--ease), translate .35s var(--ease), rotate .35s var(--ease); }
  .card img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center top; border-radius: 6px; background: #F3F1EC; }
  /* landing spots, relative to the device; --f* is where each card starts, tucked behind it */
  .card.back  { z-index: 1; width: 30%; top: -12%; right: -8%; --fx: -40%; --fy: 40%; --rot: 2deg; }
  .card.front { z-index: 4; width: 34%; bottom: -10%; right: -14%; --fx: -45%; --fy: -35%; --rot: -1.5deg; }
  .card.side  { z-index: 1; width: 26%; top: 26%; left: -13%; --fx: 50%; --fy: 0%; --rot: -3deg; }
  .is-phone .card.back  { width: 100%; top: 2%; right: -84%; }
  .is-phone .card.front { width: 112%; bottom: 8%; right: -100%; }
  .is-phone .card.side  { width: 92%; top: 34%; left: -84%; }

  .proj:is(:hover, :focus-visible, .peek) .card {
    opacity: 1; scale: 1; translate: 0 0; rotate: var(--rot);
    transition: opacity .3s calc(var(--i) * 70ms), scale .7s var(--snap) calc(var(--i) * 70ms),
                translate .7s var(--snap) calc(var(--i) * 70ms), rotate .9s var(--ease) calc(var(--i) * 70ms);
  }

  /* the chip: name and kind, pinned to the front card (or the device when there is no fan) */
  .chip { position: absolute; left: 10px; top: -13px; display: inline-flex; gap: 6px; align-items: baseline; white-space: nowrap;
    padding: 6px 10px; border-radius: 6px; background: #fff; box-shadow: 0 0 0 1px rgb(30 23 16 / .08), 0 6px 16px -8px rgb(30 23 16 / .3);
    font: 400 13px/1 var(--sans); color: var(--soft); }
  .chip b { font-weight: 500; color: var(--ink); }
  .solo-chip { z-index: 5; left: auto; top: auto; right: -14%; bottom: -4%; opacity: 0; translate: -8px -8px; transition: opacity .25s, translate .4s var(--ease); }
  .is-phone .solo-chip { right: -46%; bottom: 10%; }
  .proj:is(:hover, :focus-visible, .peek) .solo-chip { opacity: 1; translate: 0 0; transition: opacity .3s .15s, translate .6s var(--snap) .15s; }

  .defs { position: absolute; }

  /* ---------- Skyway: what we made was the website, so the website is the object ----------
     At rest the mobile site lies on the paper as a phone, in 3D. Pointing at it, it comes apart
     into the layers we designed (hero, nutrition, ingredients, product page with the checkout),
     each one labelled, with Skyway's clouds floating between them. See SkywaySite.astro. */
  .obj.is-site { width: 240px; height: 460px; }
  /* the callouts sit to the right of the stack, so the object leans left in its column */
  .is-site :global(.site3d) { translate: -56px 0; transition: --x .45s var(--ease); }
  .proj:is(:hover, :focus-visible, .peek) .is-site :global(.site3d) { --x: 1; transition: --x 1.1s var(--snap); }
  .is-site .solo-chip { right: auto; left: -34%; bottom: 4%; }

  /* ---------- HealthFlex: leaves from their illustration language grow out from behind the phone ---------- */
  .leaves { position: absolute; inset: 0; pointer-events: none; }
  .leaf { position: absolute; left: var(--x); top: var(--y); width: var(--w); aspect-ratio: 40 / 100; z-index: 1;
    translate: -50% -100%; transform-origin: 50% 100%; rotate: calc(var(--r) * .25); scale: 0; opacity: 0;
    transition: scale .35s var(--ease), rotate .35s var(--ease), opacity .2s; }
  .leaf svg { display: block; width: 100%; height: 100%; overflow: visible; transform-origin: 50% 100%; }
  .leaf .rib { fill: none; stroke: rgb(255 255 255 / .38); stroke-width: 1.1; stroke-linecap: round; }
  .proj:is(:hover, :focus-visible, .peek) .leaf {
    scale: 1; rotate: var(--r); opacity: 1;
    transition: scale .8s var(--snap) calc(var(--i) * 55ms), rotate 1s var(--ease) calc(var(--i) * 55ms), opacity .25s calc(var(--i) * 55ms);
  }
  /* then they sway in the breeze, out of step with each other */
  .proj:is(:hover, :focus-visible, .peek) .leaf svg { animation: sway calc(2.6s + var(--i) * .25s) ease-in-out .9s infinite alternate; }
  @keyframes sway { from { rotate: -4deg; } to { rotate: 5deg; } }

  /* ---------- The Ken and Stoa: the object is what we made (see KenSystem.astro, StoaBrand.astro) ---------- */
  .obj.is-ken { width: 420px; height: 420px; }
  .obj.is-stoa { height: 400px; }
  .is-ken :global(.ken3d), .is-stoa :global(.stoa-brand) { transition: --x .45s var(--ease); }
  .proj:is(:hover, :focus-visible, .peek) .is-ken :global(.ken3d) { --x: 1; transition: --x 1.2s var(--snap); }
  .proj:is(:hover, :focus-visible, .peek) .is-stoa :global(.stoa-brand) { --x: 1; transition: --x 1.2s var(--snap); }
  .is-ken .solo-chip { right: -6%; bottom: 2%; }
  .obj.is-alai { width: 440px; height: 440px; }
  .is-alai :global(.alai3d) { transition: --x .45s var(--ease); }
  .proj:is(:hover, :focus-visible, .peek) .is-alai :global(.alai3d) { --x: 1; transition: --x 1.3s var(--snap); }
  .is-alai .solo-chip { right: -4%; bottom: 4%; }
  /* Paper Planes: the page's grid draws, type and pictures set; clicked, it folds and flies (PaperPlanes.astro) */
  .obj.is-pp { width: 400px; height: 440px; }
  .is-pp :global(.pp3d) { transition: --x .5s var(--ease); }
  .proj:is(:hover, :focus-visible, .peek) .is-pp :global(.pp3d) { --x: 1; transition: --x 3.2s cubic-bezier(.35, .1, .25, 1); }
  .proj.fly .is-pp :global(.pp3d) { --x: 1; transition: none; }
  .is-pp .solo-chip { right: -14%; bottom: 0; }
  .is-stoa .solo-chip { right: -40%; bottom: 0; }

  /* ---------- even: every project the same size, one column ---------- */
  :global([data-layout="even"]) .list { grid-template-columns: 1fr; row-gap: 14vh; width: min(560px, 100% - 2 * var(--gutter)); }
  :global([data-layout="even"]) .proj.small.r { margin-top: 0; }
  :global([data-layout="even"]) .proj.solo { translate: none; }
  :global([data-layout="even"]) .stage { min-height: 400px; height: 400px; }
  :global([data-layout="even"]) .obj.is-desk { max-width: 520px; }
  :global([data-layout="even"]) .obj.is-phone { width: 180px; }
  :global([data-layout="even"]) .duo .phone { width: 130px; }

  @media (max-width: 760px) {
    /* minmax(0, 1fr): the 3D objects have fixed widths, which would otherwise widen the column past the screen */
    .list { grid-template-columns: minmax(0, 1fr); row-gap: 12vh; }
    .proj, .stage, .obj { min-width: 0; }
    /* the wide 3D objects are scaled down; flex keeps them centred even though their box is wider than the column */
    .obj.is-pp, .obj.is-alai, .obj.is-ken { display: flex; justify-content: center; align-items: center; }
    .obj.is-pp > :global(*), .obj.is-alai > :global(*), .obj.is-ken > :global(*) { flex: none; }
    .proj.small.r { margin-top: 0; }
    .proj.solo { translate: none; }
    .big .stage, .small .stage { min-height: 0; }
    .duo .phone { width: 110px; right: -2%; }
    .obj.is-stoa { scale: .8; }
    .obj.is-ken, .obj.is-alai { width: 100%; height: 300px; }
    .is-alai :global(.alai3d) { scale: .62; }
    .obj.is-pp { width: 100%; height: 330px; }
    .is-pp :global(.pp3d) { scale: .64; }
    .is-ken :global(.ken3d) { scale: .62; }
    .obj.is-phone { width: 190px; }
    /* on a phone the fan stays tight to the device so nothing runs off the screen */
    .card.back, .card.side { display: none; }
    .card.front, .is-phone .card.front { width: 62%; right: -6%; bottom: -10%; }
    .is-phone .solo-chip { right: -10%; }
    .obj.is-site { width: 200px; height: 400px; }
    .is-site :global(.site3d) { scale: .8; translate: -14% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .screen .cur.scrolling { transform: none; }
    .card, .cloud, .leaf, .solo-chip { transition: opacity .2s !important; translate: none !important; scale: 1 !important; }
    .is-site :global(.site3d), .is-ken :global(.ken3d), .is-stoa :global(.stoa-brand), .is-alai :global(.alai3d), .is-pp :global(.pp3d) { transition: none !important; }
    .leaf { rotate: var(--r) !important; }
    .cloud svg, .leaf svg { animation: none !important; }
  }
</style>

<script>
  // In view (the middle of the screen) a project wakes: .on, its screens cycle every few
  // seconds, a long page scrolls through, a video plays. On touch, in view is also the hover (.peek).
  // Clicking a project hands its screen to the project page, which morphs it into the cover.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = matchMedia('(hover: hover)').matches;

  function wire(proj: HTMLElement) {
    const screens = [...proj.querySelectorAll<HTMLElement>('.device:not(.placeholder) .screen')];
    let timers: number[] = [];

    // scroll the current shot through its page if it is taller than the frame
    const scrollShot = (el: HTMLElement) => {
      const frame = el.parentElement!;
      const dy = el.offsetHeight - frame.clientHeight;
      if (dy < 8 || reduce) return;
      el.style.setProperty('--dy', `${-dy}px`);
      el.style.setProperty('--dur', `${Math.min(9, 2 + dy / 220)}s`);
      el.classList.add('scrolling');
    };
    const reset = (el: HTMLElement) => { el.classList.remove('scrolling'); el.style.removeProperty('--dy'); };

    const wake = () => {
      proj.classList.add('on');
      if (!canHover) proj.classList.add('peek');
      screens.forEach((screen) => {
        const shots = [...screen.querySelectorAll<HTMLElement>('img, video')];
        let i = shots.findIndex((s) => s.classList.contains('cur'));
        if (i < 0) return;
        const show = () => {
          const el = shots[i];
          if (el instanceof HTMLVideoElement) { el.play().catch(() => {}); return; }
          requestAnimationFrame(() => scrollShot(el));
        };
        show();
        if (shots.length > 1) {
          timers.push(window.setInterval(() => {
            reset(shots[i]); shots[i].classList.remove('cur');
            i = (i + 1) % shots.length;
            shots[i].classList.add('cur'); show();
          }, 3200));
        }
      });
    };
    const sleep = () => {
      proj.classList.remove('on', 'peek');
      timers.forEach(clearInterval); timers = [];
      proj.querySelectorAll<HTMLElement>('.screen > *').forEach((el) => {
        reset(el);
        if (el instanceof HTMLVideoElement) el.pause();
      });
    };
    new IntersectionObserver(([en]) => (en.isIntersecting ? wake() : sleep()), { rootMargin: '-30% 0px -30% 0px' }).observe(proj);

    // an object that acts out the product plays its clip from the start while you point at it
    // (on touch, while it is in view), and goes back to its first frame when you leave
    const clip = proj.querySelector<HTMLVideoElement>('video[data-hover-play]');
    if (clip) {
      const play = () => { clip.currentTime = 0; clip.play().catch(() => {}); };
      const stop = () => { clip.pause(); clip.currentTime = 0; };
      if (canHover) { proj.addEventListener('pointerenter', play); proj.addEventListener('pointerleave', stop); }
      else new IntersectionObserver(([en]) => (en.isIntersecting ? play() : stop()), { rootMargin: '-30% 0px -30% 0px' }).observe(proj);
    }

    // the clicked screen becomes the project page's cover
    proj.addEventListener('click', () => {
      if (!proj.hasAttribute('href')) return;
      document.querySelectorAll<HTMLElement>('[data-vt-from]').forEach((el) => { el.style.viewTransitionName = ''; el.removeAttribute('data-vt-from'); });
      // a project with its own object hands it over: the element marked data-vt names the case page's twin
      const own = proj.querySelector<HTMLElement>('[data-vt]');
      const from = own ?? proj.querySelector<HTMLElement>('.device:not(.placeholder) .screen');
      if (from) { from.style.viewTransitionName = own?.dataset.vt ?? 'sheet-poster'; from.setAttribute('data-vt-from', ''); }
    });
  }

  document.addEventListener('astro:page-load', () => {
    const projs = document.querySelectorAll<HTMLElement>('[data-proj]');
    projs.forEach(wire);
    // the project page's close button comes back here
    if (projs.length) try { sessionStorage.setItem('chariot:back', location.pathname); } catch {}
  });
</script>
