---
// The top bar, after the Design Office of David McGillivray: two words left, the Chariot
// mark in the middle, Projects and Join right, and a speaker for sound.
// Projects is the frosted pill and goes to the work page; it stays lit while you're there.
// Colours follow --nav-ink so the page can switch them (night or paper).
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---
<header class="nav">
  <nav class="side" aria-label="Main">
    <a href="/lab/wheel" data-tick>Workshop</a>
    <a href="mailto:hello@withchariot.com" data-tick>Contact</a>
  </nav>

  <a href="/lab/home" class="name mark" aria-label="Chariot, home" data-tick><Logo /><span class="sun" aria-hidden="true"></span></a>

  <nav class="side right" aria-label="More">
    <a class="pill" href="/work" aria-current={path.startsWith('/work') ? 'page' : undefined} data-tick>Projects</a>
    <a href="/careers" data-tick>Join</a>
    <button class="sound" type="button" aria-pressed="true" data-sound>
      <svg viewBox="0 0 22 16" aria-hidden="true"><path d="M2 8l9-6v12z" /><path class="w1" d="M14 5.5a3.5 3.5 0 010 5" /><path class="w2" d="M17 3a7 7 0 010 10" /></svg>
      <span class="sr">Sound on</span>
    </button>
  </nav>
</header>

<style>
  .nav {
    --nav-ink: #F5EFE6;
    position: fixed; inset: 0 0 auto 0; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: start;
    padding: 18px var(--gutter); color: var(--nav-ink); font: 400 15px/1 var(--sans); pointer-events: none;
    transition: color .2s;
  }
  .nav > * { pointer-events: auto; }
  .side { display: flex; align-items: center; gap: 28px; min-height: 40px; }
  .side.right { justify-content: flex-end; gap: 22px; }
  .side a:not(.pill):hover, .name:hover { opacity: .65; }

  /* the frosted pill, like the reference; brighter on the work page */
  .pill {
    height: 40px; padding: 0 16px; border-radius: 10px; display: inline-flex; align-items: center;
    background: color-mix(in srgb, var(--nav-ink) 10%, transparent);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid color-mix(in srgb, var(--nav-ink) 14%, transparent);
    transition: background .2s;
  }
  .pill:hover, .pill[aria-current="page"] { background: color-mix(in srgb, var(--nav-ink) 18%, transparent); }

  /* the speaker: waves fade out when sound is off */
  .sound { background: none; border: 0; padding: 4px; color: inherit; cursor: pointer; }
  .sound svg { display: block; width: 22px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linejoin: round; stroke-linecap: round; }
  .sound path { transition: opacity .2s; }
  .sound[aria-pressed="false"] .w1, .sound[aria-pressed="false"] .w2 { opacity: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  @media (max-width: 820px) {
    .side:not(.right) a:last-child, .side.right a:not(.pill) { display: none; }
  }
</style>
